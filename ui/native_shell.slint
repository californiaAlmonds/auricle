import { LineEdit } from "std-widgets.slint";

struct SongItem {
    video-id: string,
    title: string,
    artist: string,
    album: string,
    duration-str: string,
    avatar-letter: string,
    duration-secs: int,
    thumbnail: image,
    has-thumbnail: bool,
}

struct ArtistItem {
    name: string,
    browse-id: string,
    thumbnail: image,
    has-thumbnail: bool,
    subscriber-count: string,
}

struct AlbumItem {
    title: string,
    browse-id: string,
    artist: string,
    year: string,
    thumbnail: image,
    has-thumbnail: bool,
}

struct PlaylistItem {
    title: string,
    playlist-id: string,
    thumbnail: image,
    has-thumbnail: bool,
    count-text: string,
}

struct MoodItem {
    title: string,
    params: string,
}

// ─── Theme (single source of truth for colors + radii) ───────────────────────
// The whole palette is DERIVED from one `accent` color + a light/dark `is-light`
// flag, so a single user choice re-skins the app while the relationships between
// colors stay fixed. Rust sets `accent` + `is-light` from the saved settings.
export global Theme {
    // Inputs (set from Rust / Settings)
    in property <color> accent: #6486b0;      // default "Default Blue" — muted steel blue (from reference)
    in property <bool> is-light: false;

    // Palette sampled from the reference: crisp, OPAQUE dark-slate surfaces carrying
    // only a small accent tint. NOTE `accent.mix(base, f)` = f*accent + (1-f)*base,
    // so a SMALL f keeps the surface mostly the neutral dark base. (The previous code
    // wrote `base.mix(accent, 0.04)` which is ~96% accent — that is what turned the
    // whole app washed-out blue.)
    out property <color> bg:            is-light ? accent.mix(#ffffff, 0.05)  : accent.mix(#0c1016, 0.05);
    out property <color> surface:       is-light ? accent.mix(#ffffff, 0.06)  : accent.mix(#12161f, 0.06);
    out property <color> surface-2:     is-light ? accent.mix(#ffffff, 0.07)  : accent.mix(#171d27, 0.06);
    out property <color> surface-hover: is-light ? accent.mix(#e9ecf1, 0.09)  : accent.mix(#212835, 0.07);
    out property <color> elevated:      is-light ? #ffffff                    : accent.mix(#1b212c, 0.06);

    // Panel/menu surfaces (kept the glass-* names) — now fully OPAQUE for the clean,
    // crisp look of the reference instead of the previous frosted haze.
    out property <color> glass:        is-light ? #ffffff : accent.mix(#12161f, 0.06);
    out property <color> glass-strong: is-light ? #ffffff : accent.mix(#1a2029, 0.06);
    out property <color> glass-hover:  is-light ? #eceef3 : accent.mix(#232b38, 0.06);

    // Frosted chrome (player bar / queue pane). Slightly translucent for a premium
    // glass hint, kept high-opacity so it never turns muddy.
    out property <color> frost:    is-light ? #ffffff.with-alpha(0.82) : accent.mix(#141a24, 0.06).with-alpha(0.9);
    out property <color> frost-hi: is-light ? #000000.with-alpha(0.06) : #ffffff.with-alpha(0.08);

    // Text
    out property <color> text:       is-light ? #171a20 : #f2f4f8;
    out property <color> text-muted: is-light ? #565d69 : #97a1ae;
    out property <color> text-dim:   is-light ? #838b98 : #5a6470;

    // Accent variants
    out property <color> accent-strong: accent.brighter(0.15);
    out property <color> accent-soft:   accent.with-alpha(0.16);
    out property <color> on-accent:     is-light ? #111318 : #ffffff;

    // Lines / borders
    out property <color> border:      is-light ? #000000.with-alpha(0.09) : #ffffff.with-alpha(0.07);
    out property <color> border-soft: is-light ? #000000.with-alpha(0.05) : #ffffff.with-alpha(0.045);

    // Hover veils (used over images / transparent rows)
    out property <color> hover-veil:  is-light ? #000000.with-alpha(0.05) : #ffffff.with-alpha(0.05);

    // Corner radii
    out property <length> radius-sm: 8px;
    out property <length> radius:    14px;
    out property <length> radius-lg: 20px;
}

// ─── Shared components ────────────────────────────────────────────────────────

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <color> icon-color: Theme.text-muted;
    in property <bool> active: false;
    in property <image> svg-icon;
    in property <bool> use-svg: false;
    callback clicked();
    width: 36px; height: 36px; border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.hover-veil : (active ? Theme.accent-soft : transparent);
    if !use-svg: Text {
        text: root.icon;
        color: ta.has-hover ? Theme.text : (root.active ? Theme.text : root.icon-color);
        font-size: 18px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if use-svg: Image {
        source: root.svg-icon;
        width: 20px; height: 20px;
        colorize: ta.has-hover ? Theme.text : (root.active ? Theme.text : root.icon-color);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Slim progress bar for add-on installs. `value` in 0.0..=1.0 shows a determinate
// fill; a negative `value` shows an indeterminate sliding segment.
component AddonProgress inherits Rectangle {
    in property <float> value: 0.0;
    property <bool> indeterminate: root.value < 0.0;
    property <bool> anim-toggle: false;
    height: 6px; border-radius: 3px; background: Theme.surface-hover;
    clip: true;

    // Determinate fill
    if !root.indeterminate: Rectangle {
        x: 0; y: 0; height: parent.height; border-radius: 3px;
        width: parent.width * max(0.0, min(1.0, root.value));
        background: Theme.accent;
        animate width { duration: 120ms; easing: ease-out; }
    }

    // Indeterminate sliding segment
    if root.indeterminate: Rectangle {
        y: 0; height: parent.height; border-radius: 3px;
        width: parent.width * 0.35;
        background: Theme.accent;
        x: root.anim-toggle ? (parent.width - self.width) : 0px;
        animate x { duration: 900ms; easing: ease-in-out; }
    }
    timer := Timer {
        interval: 900ms;
        running: root.indeterminate;
        triggered => { root.anim-toggle = !root.anim-toggle; }
    }
}

// Delayed, non-interactive label for the collapsed sidebar rail. A PopupWindow
// lets it escape the sidebar scroll clip without moving or widening the layout.
component RailTooltip inherits Rectangle {
    in property <bool> enabled: false;
    in property <string> label: "";
    in property <string> detail: "";
    width: 0px; height: 0px;
    changed enabled => { if (!enabled) { tip.close(); } }
    Timer {
        interval: 1s;
        running: root.enabled;
        triggered => { if (root.enabled) { tip.show(); } }
    }
    tip := PopupWindow {
        x: 58px; y: -4px; width: 210px;
        Rectangle {
            width: 210px;
            height: root.detail == "" ? 38px : 54px;
            border-radius: Theme.radius-sm;
                background: Theme.glass-strong;
            border-color: Theme.border; border-width: 1px;
            drop-shadow-blur: 18px; drop-shadow-color: #00000070; drop-shadow-offset-y: 5px;
            VerticalLayout {
                padding-left: 12px; padding-right: 12px; padding-top: 7px; padding-bottom: 7px;
                alignment: center; spacing: 2px;
                Text { text: root.label; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                if root.detail != "": Text { text: root.detail; color: Theme.text-muted; font-size: 11px; overflow: elide; }
            }
        }
    }
}

component NavBtn inherits Rectangle {
    in property <string> label; in property <image> nav-icon; in property <bool> active;
    in property <bool> expanded: true;
    callback clicked();
    height: 44px; border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.hover-veil : (active ? Theme.accent-soft : transparent);
    animate background { duration: 100ms; }
    HorizontalLayout {
        padding-left: expanded ? 14px : 7px; padding-right: expanded ? 14px : 7px;
        padding-top: 11px; padding-bottom: 11px; spacing: 14px; alignment: start;
        Image {
            source: root.nav-icon; width: 22px; height: 22px;
            colorize: root.active ? Theme.accent : Theme.text-muted;
            vertical-alignment: center;
        }
        if root.expanded: Text { text: root.label; font-size: 15px; font-weight: root.active ? 700 : 500; color: root.active ? Theme.text : Theme.text-muted; vertical-alignment: center; }
    }
    RailTooltip { enabled: !root.expanded && ta.has-hover; label: root.label; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TabPill inherits Rectangle {
    in property <string> label; in property <bool> active;
    callback clicked();
    height: 32px; border-radius: 16px;
    background: active ? Theme.accent-soft : (ta.has-hover ? Theme.hover-veil : transparent);
    border-color: active ? Theme.border : transparent; border-width: 1px;
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px;
        Text {
            text: root.label; font-size: 13px; font-weight: root.active ? 700 : 500;
            color: root.active ? Theme.text : Theme.text-muted;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component ThemeChoice inherits Rectangle {
    in property <string> theme-label;
    in property <color> theme-color;
    in property <bool> selected: false;
    callback picked();
    height: 38px; border-radius: Theme.radius-sm;
    background: choice-ta.has-hover ? Theme.hover-veil : (selected ? Theme.accent-soft : transparent);
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px; alignment: start;
        Rectangle {
            width: 18px; height: 18px; border-radius: 9px;
            background: root.theme-color; border-color: Theme.border; border-width: 1px;
            y: (parent.height - self.height) / 2;
        }
        Text { text: root.theme-label; font-size: 13px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
        if selected: Text { text: "✓"; font-size: 13px; color: Theme.accent; vertical-alignment: center; }
    }
    choice-ta := TouchArea { clicked => { root.picked(); } }
}

// ─── Context-menu row (consistent icon slot + label alignment) ────────────────
// One row of a right-click popup menu. Every row uses a fixed-width icon slot so
// all labels line up, whether the icon is an SVG image or a text glyph.
component CtxMenuItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> use-image: true;      // false → render `glyph` text instead
    in property <string> glyph: "";
    in property <length> glyph-size: 15px;
    in property <color> icon-color: Theme.text-muted;
    in property <color> label-color: Theme.text;
    callback clicked;
    height: 40px;
    border-radius: Theme.radius-sm;
    background: mi-ta.has-hover ? Theme.hover-veil : transparent;
    HorizontalLayout {
        padding-left: 14px; padding-right: 12px; spacing: 12px; alignment: start;
        // Fixed-width icon slot; every glyph/image is centered in the full row
        // height so labels AND icons line up regardless of glyph size.
        Rectangle {
            width: 22px;
            if root.use-image: Image {
                source: root.icon; width: 16px; height: 16px; colorize: root.icon-color;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            }
            if !root.use-image: Text {
                text: root.glyph; font-size: root.glyph-size; color: root.icon-color;
                width: parent.width; height: parent.height;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        Text {
            text: root.label; font-size: 14px; font-weight: 500; color: root.label-color;
            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
        }
    }
    mi-ta := TouchArea { clicked => { root.clicked(); } }
}

component SongRow inherits Rectangle {
    in property <string> song-title; in property <string> song-artist;
    in property <string> song-album; in property <string> song-duration;
    in property <string> idx-str; in property <bool> is-current;
    in property <string> avatar-letter: "";
    in property <image> thumbnail;
    in property <bool> has-thumbnail: false;
    in property <bool> show-unlike: false;
    in property <bool> show-remove: false;
    callback play-clicked(); callback queue-clicked(); callback play-next-clicked(); callback dislike-clicked(); callback unlike-clicked();
    callback song-radio-clicked();
    callback artist-radio-clicked();
    callback go-to-artist-clicked();
    callback go-to-album-clicked();
    callback add-to-playlist-clicked();
    callback remove-clicked();
    height: 64px; border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.hover-veil : (is-current ? Theme.accent-soft : transparent);
    animate background { duration: 80ms; }
    HorizontalLayout {
        padding-left: 12px; padding-right: 14px; spacing: 12px;
        // Thumbnail or letter avatar
        Rectangle {
            width: 48px; height: 48px; border-radius: 6px; clip: true;
            background: Theme.surface-hover;
            if has-thumbnail: Image {
                source: thumbnail; width: parent.width; height: parent.height; image-fit: cover;
            }
            if !has-thumbnail: Text {
                text: is-current ? "▶" : (avatar-letter == "" ? root.idx-str : avatar-letter);
                color: is-current ? Theme.accent : Theme.text-dim;
                font-size: is-current ? 12px : 13px;
                font-weight: 700; horizontal-alignment: center; vertical-alignment: center;
            }
            // Playing overlay
            if is-current && has-thumbnail: Rectangle {
                width: parent.width; height: parent.height;
                background: #00000066;
                Text { text: "▶"; color: #ffffff; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        // Title + artist
        VerticalLayout {
            alignment: center; spacing: 3px; horizontal-stretch: 1;
            Text {
                text: root.song-title;
                font-size: 14px; font-weight: 500;
                color: is-current ? Theme.accent : Theme.text;
                overflow: elide;
            }
            Text {
                text: root.song-album == "" ? root.song-artist
                    : root.song-artist + "  •  " + root.song-album;
                font-size: 12px; color: Theme.text-muted; overflow: elide;
            }
        }
        // Duration / "+ Queue" on hover
        Rectangle {
            width: 64px;
            if !ta.has-hover: Text {
                text: root.song-duration;
                font-size: 12px; color: Theme.text-dim;
                horizontal-alignment: right; vertical-alignment: center;
            }
            if ta.has-hover: Rectangle {
                width: 56px; height: 28px; border-radius: 14px;
                background: qa.has-hover ? Theme.surface-hover : Theme.hover-veil;
                Text { text: "+ Queue"; color: Theme.text-muted; font-size: 10px; font-weight: 600;
                    horizontal-alignment: center; vertical-alignment: center; }
                qa := TouchArea { clicked => { root.queue-clicked(); } }
            }
        }
    }
    ta := TouchArea {
        clicked => { root.play-clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                row-ctx-popup.show();
            }
        }
    }

    row-ctx-popup := PopupWindow {
        x: 60px; y: 10px;
        width: 220px;
        Rectangle {
            width: 220px;
            border-radius: Theme.radius; background: Theme.glass-strong;
            drop-shadow-blur: 16px; drop-shadow-color: #00000080; drop-shadow-offset-y: 4px;
            VerticalLayout {
                padding: 6px;
                CtxMenuItem { icon: @image-url("icons/plus.svg"); label: "Add to queue"; clicked => { root.queue-clicked(); row-ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/next.svg"); label: "Play next"; clicked => { root.play-next-clicked(); row-ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/play.svg"); label: "Play"; clicked => { root.play-clicked(); row-ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/radio.svg"); label: "Go to song radio"; clicked => { root.song-radio-clicked(); row-ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/radio.svg"); label: "Artist radio"; clicked => { root.artist-radio-clicked(); row-ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/artist.svg"); label: "Go to artist"; clicked => { root.go-to-artist-clicked(); row-ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/album.svg"); label: "Go to album"; clicked => { root.go-to-album-clicked(); row-ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/plus.svg"); label: "Add to playlist"; clicked => { root.add-to-playlist-clicked(); row-ctx-popup.close(); } }
                if root.show-remove: CtxMenuItem { icon: @image-url("icons/close.svg"); label: "Remove from playlist"; clicked => { root.remove-clicked(); row-ctx-popup.close(); } }
                if root.show-unlike: CtxMenuItem { icon: @image-url("icons/heart-fill.svg"); icon-color: Theme.accent; label: "Remove from liked"; clicked => { root.unlike-clicked(); row-ctx-popup.close(); } }
                Rectangle {
                    height: 1px; background: Theme.border;
                }
                CtxMenuItem { use-image: false; glyph: "\u{1F6AB}"; glyph-size: 13px; label: "Remove from taste profile"; clicked => { root.dislike-clicked(); row-ctx-popup.close(); } }
            }
        }
    }
}

component GenreTile inherits Rectangle {
    in property <string> label; in property <color> tile-color; in property <string> icon;
    callback clicked();
    height: 100px; border-radius: 12px;
    background: ta.has-hover ? tile-color.brighter(0.1) : tile-color;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding: 20px; spacing: 12px; alignment: start;
        Text { text: root.icon; font-size: 26px; vertical-alignment: center; }
        Text { text: root.label; font-size: 16px; font-weight: 600; color: #ffffff; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component SongCard inherits Rectangle {
    in property <string> card-title;
    in property <string> card-artist;
    in property <string> avatar-letter;
    in property <bool> is-now-playing: false;
    in property <bool> is-playing: false;
    in property <image> thumbnail;
    in property <bool> has-thumbnail: false;
    in property <string> video-id: "";
    callback clicked();
    callback queue-clicked();
    callback play-next-clicked();
    callback pause-clicked();
    callback song-radio-clicked();
    callback artist-radio-clicked();
    callback go-to-artist-clicked();
    callback go-to-album-clicked();
    callback add-to-playlist-clicked();
    width: 200px; height: 260px; border-radius: Theme.radius;
    background: ta.has-hover ? Theme.glass-hover : Theme.glass;
    border-color: ta.has-hover ? Theme.border : Theme.border-soft; border-width: 1px;
    animate background { duration: 120ms; }

    VerticalLayout {
        padding: 12px; spacing: 12px;
        // Square thumbnail with play button overlay
        Rectangle {
            width: 176px; height: 176px; border-radius: Theme.radius; clip: true;
            background: Theme.surface-hover;
            if has-thumbnail: Image {
                source: thumbnail; width: parent.width; height: parent.height; image-fit: cover;
            }
            if !has-thumbnail: Rectangle {
                width: parent.width; height: parent.height;
                background: is-now-playing
                    ? @linear-gradient(135deg, #2a0a0a 0%, #1a0808 100%)
                    : @linear-gradient(135deg, #1a1a2a 0%, #0f0f18 100%);
                Text {
                    text: is-now-playing ? "▶" : (avatar-letter == "" ? "♪" : avatar-letter);
                    color: is-now-playing ? Theme.accent : Theme.text-dim;
                    font-size: 36px; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            // Play/Pause button on hover only
            if ta.has-hover: Rectangle {
                x: (parent.width - 46px) / 2; y: (parent.height - 46px) / 2;
                width: 46px; height: 46px; border-radius: 23px;
                background: play-ta.has-hover ? #000000b5 : #00000080;
                border-color: #ffffff90; border-width: 1px;
                drop-shadow-blur: 12px; drop-shadow-color: #00000090; drop-shadow-offset-y: 4px;
                if !(is-now-playing && is-playing): Image { source: @image-url("icons/play.svg"); width: 20px; height: 20px; colorize: #ffffff; x: 14px; y: 13px; }
                if is-now-playing && is-playing: Image { source: @image-url("icons/pause.svg"); width: 20px; height: 20px; colorize: #ffffff; x: 13px; y: 13px; }
                play-ta := TouchArea {
                    clicked => {
                        if (root.is-now-playing && root.is-playing) {
                            root.pause-clicked();
                        } else {
                            root.clicked();
                        }
                    }
                }
            }
            // Now playing indicator bar
            if is-now-playing: Rectangle {
                x: 0; y: parent.height - 3px; width: parent.width; height: 3px;
                background: Theme.accent;
            }
        }
        VerticalLayout {
            spacing: 4px; padding-left: 2px;
            Text { text: card-title; font-size: 14px; font-weight: 700; color: Theme.text; overflow: elide; }
            Text { text: card-artist; font-size: 12px; font-weight: 500; color: Theme.text-muted; overflow: elide; }
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                ctx-popup.show();
            }
        }
    }

    // Context menu popup (auto-dismisses on click outside)
    ctx-popup := PopupWindow {
        x: 40px; y: 100px;
        width: 200px;
        Rectangle {
            width: 200px; height: 340px;
            border-radius: Theme.radius; background: Theme.glass-strong;
            border-color: Theme.border; border-width: 1px;
            drop-shadow-blur: 22px; drop-shadow-color: #00000080; drop-shadow-offset-y: 6px;
            VerticalLayout {
                padding: 6px;
                CtxMenuItem { icon: @image-url("icons/plus.svg"); label: "Add to queue"; clicked => { root.queue-clicked(); ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/next.svg"); label: "Play next"; clicked => { root.play-next-clicked(); ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/play.svg"); label: "Play"; clicked => { root.clicked(); ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/radio.svg"); label: "Go to song radio"; clicked => { root.song-radio-clicked(); ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/radio.svg"); label: "Artist radio"; clicked => { root.artist-radio-clicked(); ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/artist.svg"); label: "Go to artist"; clicked => { root.go-to-artist-clicked(); ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/album.svg"); label: "Go to album"; clicked => { root.go-to-album-clicked(); ctx-popup.close(); } }
                CtxMenuItem { icon: @image-url("icons/plus.svg"); label: "Add to playlist"; clicked => { root.add-to-playlist-clicked(); ctx-popup.close(); } }
            }
        }
    }
}

// ─── Main window ──────────────────────────────────────────────────────────────

export component NativeShellWindow inherits Window {
    // Playback state
    in-out property <string> track-title: "Nothing playing";
    in-out property <string> track-artist: "Select a song to start";
    in-out property <bool> is-playing: false;
    in-out property <float> progress: 0.0;
    in-out property <string> current-time: "0:00";
    in-out property <string> total-time: "--:--";
    in-out property <float> volume: 0.8;
    in-out property <string> track-initial: "?";
    in-out property <image> album-art;
    in-out property <bool> has-album-art: false;
    in-out property <bool> is-liked: false;
    in-out property <string> now-playing-video-id: "";

    // Navigation
    in-out property <string> current-view: "Home";
    in-out property <bool> sidebar-open: true;
    in-out property <bool> queue-pane-open: false;
    // Responsive breakpoint. Set imperatively from `changed width` (below) rather
    // than as a reactive binding on root.width — a reactive binding would form a
    // layout-info loop (element sizes depend on width, width depends on their
    // layout-info) which Slint flags as deprecated / may panic.
    property <bool> compact: false;   // < 1200px: shrink header + player-bar side panels
    in-out property <string> library-tab: "Liked";
    in-out property <[AlbumItem]> library-albums: [];
    in-out property <[ArtistItem]> library-artists: [];
    in-out property <[PlaylistItem]> library-playlists: [];
    // Sidebar (left pane) shortcuts — your artists + your playlists.
    in-out property <[ArtistItem]> sidebar-artists: [];
    in-out property <[PlaylistItem]> sidebar-playlists: [];
    // Albums from recently-listened songs (left-pane shortcut, like the artists).
    in-out property <[AlbumItem]> sidebar-albums: [];
    in-out property <string> library-sort: "recent";
    callback load-library-data();
    callback sort-library(string);
    callback navigate-to-playlist(string);

    // Data
    in-out property <[SongItem]> search-results: [];
    in-out property <[SongItem]> queue: [];
    in-out property <[SongItem]> liked-songs: [];
    in-out property <bool> autoplay-enabled: true;
    in-out property <[SongItem]> autoplay-queue: [];
    callback set-autoplay-enabled(bool);
    callback play-autoplay-song(int);
    in-out property <[SongItem]> trending-songs: [];
    in-out property <[SongItem]> personalized-songs: [];
    in-out property <[SongItem]> home-followed-songs: [];

    // Home screen enhancements
    in-out property <[AlbumItem]> home-new-releases: [];
    in-out property <[SongItem]> home-mix-1: [];
    in-out property <[SongItem]> home-mix-2: [];
    in-out property <[SongItem]> home-mix-3: [];
    in-out property <string> home-mix-1-title: "Your Mix";
    in-out property <string> home-mix-2-title: "Discover Mix";
    in-out property <string> home-mix-3-title: "Chill Mix";
    in-out property <[SongItem]> home-genre-mix: [];
    in-out property <string> home-genre-mix-title: "";
    in-out property <[SongItem]> home-language-section: [];
    in-out property <string> home-language-title: "";
    callback load-home-data();
    callback play-mix(int);

    // Artist view
    in-out property <string> artist-view-name: "";
    in-out property <[SongItem]> artist-view-songs: [];
    in-out property <[AlbumItem]> artist-view-albums: [];
    in-out property <image> artist-view-thumbnail;
    in-out property <bool> artist-view-has-thumbnail: false;
    in-out property <string> artist-view-description: "";
    in-out property <bool> artist-view-subscribed: false;
    callback toggle-subscribe-artist();
    in-out property <[AlbumItem]> artist-view-singles: [];
    in-out property <[ArtistItem]> artist-view-related: [];
    in-out property <[SongItem]> artist-view-videos: [];
    in-out property <AlbumItem> artist-view-latest-release: { title: "", browse-id: "", artist: "", year: "", has-thumbnail: false };
    in-out property <bool> artist-view-has-latest: false;

    // Radio view
    in-out property <string> radio-title: "";
    in-out property <[SongItem]> radio-songs: [];
    callback play-radio();
    callback play-album();
    callback shuffle-album();

    // Playlist view
    in-out property <string> playlist-view-title: "";
    in-out property <[SongItem]> playlist-view-songs: [];
    in-out property <image> playlist-view-thumbnail;
    in-out property <bool> playlist-view-has-thumbnail: false;
    in-out property <string> playlist-view-count: "";
    in-out property <string> playlist-view-duration: "";
    in-out property <[PlaylistItem]> playlist-view-similar: [];
    in-out property <bool> playlist-view-liked: false;
    callback play-playlist();
    callback shuffle-playlist();
    callback toggle-like-playlist();
    // Local (user-created) playlists
    in-out property <bool> playlist-view-is-local: false;
    in-out property <string> playlist-view-id: "";
    callback new-playlist();
    callback delete-local-playlist(string);
    callback remove-from-local-playlist(string, string); // playlist-id, video-id
    // Add-to-playlist modal
    in-out property <bool> show-playlist-modal: false;
    in-out property <string> pending-song-vid: "";
    in-out property <string> pending-song-title: "";
    in-out property <string> pending-song-artist: "";
    in-out property <int> pending-song-dur: 0;
    in-out property <[PlaylistItem]> modal-playlists: [];
    callback open-add-to-playlist(string, string, string, int);
    callback submit-new-playlist(string);
    callback add-to-existing-playlist(string); // playlist-id

    // Album view
    in-out property <string> album-view-title: "";
    in-out property <string> album-view-artist: "";
    in-out property <string> album-view-year: "";
    in-out property <[SongItem]> album-view-songs: [];
    in-out property <image> album-view-thumbnail;
    in-out property <bool> album-view-has-thumbnail: false;
    in-out property <string> album-view-duration: "";
    in-out property <string> album-view-description: "";
    in-out property <[AlbumItem]> album-view-more-by-artist: [];
    in-out property <[AlbumItem]> album-view-similar: [];
    in-out property <bool> album-view-liked: false;
    callback toggle-like-album();

    // Search enhancements
    in-out property <string> search-filter: "All";
    in-out property <[ArtistItem]> search-artists: [];
    in-out property <[AlbumItem]> search-albums: [];

    in-out property <bool> is-loading: false;

    // Callbacks
    callback toggle-play-pause();
    callback prev-track();
    callback next-track();
    callback seek(float);
    callback set-volume(float);
    callback do-search(string);
    callback live-search(string);
    in-out property <[SongItem]> search-suggestions: [];
    in-out property <bool> search-dropdown-open: false;
    callback play-song(string, string, string, int);
    callback queue-song(string, string, string);
    callback play-next-song(string, string, string, int);
    callback remove-from-queue(int);
    callback remove-from-autoplay(int);
    callback navigate(string);
    callback toggle-sidebar();
    callback toggle-queue-pane();
    callback like-current();
    callback unlike-song(string);
    callback dislike-song(string, string, string, int);
    callback clear-cache();
    callback explore-genre(string);
    in-out property <[MoodItem]> explore-moods: [];
    in-out property <[SongItem]> explore-new-releases: [];
    callback load-explore-data();
    callback explore-mood(string);
    callback navigate-to-artist(string);
    callback navigate-to-album(string);
    callback start-song-radio(string);
    callback start-artist-radio(string, string);
    callback move-queue-song-next(int);
    callback open-artist-for(string, string); // video-id, artist-name → resolve by id else name
    callback open-album-for(string);          // video-id → resolve album by id/name
    callback go-to-song-artist(string);
    callback go-to-song-album(string);
    callback nav-back();
    callback nav-forward();
    callback set-minimize-to-tray(bool);
    in-out property <string> theme-name: "Default Blue";
    in-out property <string> theme-mode: "System";
    callback set-theme-name(string);
    callback set-theme-mode(string);
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <bool> minimize-to-tray: true;
    // Cache
    in-out property <int> cache-limit-mb: 500;
    in-out property <int> cache-used-mb: 0;
    in-out property <int> cache-song-count: 0;
    callback set-cache-limit(int);
    // Prefetch: how many upcoming songs to fully cache ahead of the current one.
    in-out property <int> prefetch-depth: 1;
    callback set-prefetch-depth(int);

    // Essential add-ons (yt-dlp / ffmpeg) — optional third-party tools, not bundled.
    in-out property <bool> ytdlp-installed: false;
    in-out property <bool> deno-installed: false;
    in-out property <bool> ffmpeg-installed: false;
    in-out property <bool> addon-busy: false;
    in-out property <string> addon-status: "";
    in-out property <string> addon-installing: "";   // "ytdlp" | "ffmpeg" | ""
    in-out property <float> addon-progress: 0.0;      // 0.0–1.0, negative = indeterminate
    callback install-ytdlp();
    callback update-ytdlp();
    callback install-ffmpeg();
    callback install-deno();
    callback refresh-addons();

    // App updates — only the portable build self-updates. Installer/Store builds
    // hide this entirely (self-update-enabled = false) and defer to their manager.
    in-out property <string> app-version: "";
    in-out property <bool> self-update-enabled: false;
    in-out property <bool> update-available: false;
    in-out property <bool> update-busy: false;
    in-out property <string> update-status: "";
    callback check-updates();
    callback apply-update();

    // First-run onboarding popup for add-on installation.
    in-out property <bool> show-onboarding: false;
    callback dismiss-onboarding();

    in-out property <string> window-title: "Auricle";
    title: window-title;
    icon: @image-url("../icons/icon.png");
    preferred-width: 1280px; preferred-height: 800px;
    min-width: 800px; min-height: 500px;
    background: Theme.bg;
    default-font-family: "Segoe UI Variable";
    default-font-size: 14px;
    default-font-weight: 500;

    // Recompute the responsive breakpoint imperatively on resize (avoids a layout
    // binding loop — see the `compact` property note above).
    init => { compact = root.width < 1200px; }
    changed width => { compact = root.width < 1200px; }

    forward-focus: key-scope;
    key-scope := FocusScope {
        // Empty, zero-size global key handler. `forward-focus` (above) routes the
        // window's key events here regardless of size. The visible UI is a *direct
        // child of the Window* below — wrapping it in the FocusScope made the content
        // collapse to a preferred (short) height and clip, leaving black space below
        // on a taller/maximized window. A layout placed directly in a Window fills it.
        width: 0px;
        height: 0px;
        key-pressed(e) => {
            if e.text == " "           { toggle-play-pause(); return accept; }
            if e.text == Key.LeftArrow { prev-track();         return accept; }
            if e.text == Key.RightArrow{ next-track();         return accept; }
            if e.text == Key.Escape    {
                if queue-pane-open { toggle-queue-pane(); return accept; }
            }
            reject
        }
    }

    // Main UI — a direct Window child so it reliably fills the whole window.
    VerticalLayout {
        width: root.width;
        height: root.height;

            // Width probe — an inner element whose width tracks the window. Its
            // `changed width` fires reliably during layout/resize (the Window's own
            // `changed width` doesn't fire in some backends), driving the responsive
            // `compact` flag imperatively so there's no layout binding loop.
            Rectangle {
                height: 0;
                changed width => { root.compact = self.width < 1200px; }
            }

            // ── Main area (above player bar) ──────────────────────────────
            HorizontalLayout {
                vertical-stretch: 1;

                // ── Left sidebar ──────────────────────────────────────────
                // Always remains functional: expanded at 260px, collapsed to a 72px
                // icon rail. It only disappears temporarily when a queue pane needs
                // the horizontal room on a compact window.
                if !(compact && queue-pane-open): Rectangle {
                    width: sidebar-open ? 260px : 72px; background: Theme.glass;
                    animate width { duration: 180ms; easing: ease-out; }
                    Rectangle { x: parent.width - 1px; y: 0; width: 1px; height: parent.height; background: Theme.border; }

                    VerticalLayout {
                        padding-left: sidebar-open ? 18px : 12px; padding-right: sidebar-open ? 18px : 12px;
                        padding-top: 20px; padding-bottom: 16px;

                        // Logo
                        HorizontalLayout {
                            height: 44px; spacing: 10px; alignment: sidebar-open ? start : center;
                            Text { text: "▶"; color: Theme.accent; font-size: 22px; vertical-alignment: center; }
                            if sidebar-open: Text { text: "Auricle"; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                        }

                        Rectangle { height: 20px; }

                        // Navigation
                        NavBtn { label: "Home";     expanded: sidebar-open; nav-icon: @image-url("icons/home.svg"); active: current-view == "Home";     clicked => { navigate("Home"); }     }
                        NavBtn { label: "Explore";  expanded: sidebar-open; nav-icon: @image-url("icons/explore.svg"); active: current-view == "Explore";  clicked => { navigate("Explore"); }  }
                        NavBtn { label: "Library";  expanded: sidebar-open; nav-icon: @image-url("icons/library.svg"); active: current-view == "Library";  clicked => { navigate("Library"); }  }
                        NavBtn { label: "Settings"; expanded: sidebar-open; nav-icon: @image-url("icons/settings.svg"); active: current-view == "Settings"; clicked => { navigate("Settings"); } }

                        Rectangle { height: 24px; }
                        Rectangle { height: 1px; background: #1a1a1a; }
                        Rectangle { height: 20px; }

                        // Liked Songs shortcut
                        Rectangle {
                            height: 56px; border-radius: Theme.radius-sm;
                            background: ls-ta.has-hover ? Theme.hover-veil : Theme.border-soft;
                            HorizontalLayout {
                                padding-left: sidebar-open ? 12px : 6px; padding-right: sidebar-open ? 12px : 6px;
                                padding-top: 10px; padding-bottom: 10px; spacing: 12px; alignment: sidebar-open ? start : center;
                                Rectangle {
                                    width: 36px; height: 36px; border-radius: 4px;
                                    background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent.darker(0.35) 100%);
                                    Text { text: "♥"; color: Theme.on-accent; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                if sidebar-open: VerticalLayout {
                                    alignment: center; spacing: 2px; horizontal-stretch: 1;
                                    Text { text: "Liked Songs"; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                }
                            }
                            RailTooltip { enabled: !sidebar-open && ls-ta.has-hover; label: "Liked Songs"; detail: "Your liked tracks"; }
                            ls-ta := TouchArea { clicked => { library-tab = "Liked"; navigate("Library"); } }
                        }

                        Rectangle { height: 14px; }

                        // Your artists + albums + playlists — scrollable. Wrapped in a
                        // clipping, vertical-stretch Rectangle (same pattern as the main
                        // content area) so the sidebar's height is DECOUPLED from its content
                        // length. Without this, the scroll content's height became the
                        // sidebar's max-height and propagated up the layout tree, capping how
                        // tall the whole window could be maximized/resized.
                        Rectangle {
                            vertical-stretch: 1; clip: true;
                            Flickable {
                                width: 100%; height: 100%;
                                viewport-height: sb-col.preferred-height;
                                sb-col := VerticalLayout {
                                spacing: 2px;
                                if sidebar-artists.length > 0: Rectangle { height: 1px; background: #1a1a1a; }
                                if sidebar-artists.length > 0: Rectangle { height: 6px; }
                                for a in sidebar-artists: Rectangle {
                                    height: 46px; border-radius: 6px;
                                    background: sba-ta.has-hover ? Theme.hover-veil : transparent;
                                    HorizontalLayout {
                                        padding-left: sidebar-open ? 8px : 7px; padding-right: sidebar-open ? 8px : 7px;
                                        spacing: 10px; alignment: sidebar-open ? start : center;
                                        Rectangle {
                                            width: 34px; height: 34px; border-radius: 17px; clip: true;
                                            background: Theme.surface-hover; y: (parent.height - self.height) / 2;
                                            if a.has-thumbnail: Image { source: a.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
                                            if !a.has-thumbnail: Image { source: @image-url("icons/artist.svg"); width: 16px; height: 16px; colorize: Theme.text-muted; x: 9px; y: 9px; }
                                        }
                                        if sidebar-open: VerticalLayout { alignment: center; spacing: 1px; horizontal-stretch: 1;
                                            Text { text: a.name; font-size: 13px; font-weight: 500; color: Theme.text; overflow: elide; }
                                            Text { text: "Artist"; font-size: 10px; color: Theme.text-muted; }
                                        }
                                    }
                                    RailTooltip { enabled: !sidebar-open && sba-ta.has-hover; label: a.name; detail: "Artist"; }
                                    sba-ta := TouchArea { clicked => {
                                        if (a.browse-id != "") { navigate-to-artist(a.browse-id); } else { go-to-song-artist(a.name); }
                                    } }
                                }
                                // Recently-listened albums.
                                if sidebar-albums.length > 0: Rectangle { height: 8px; }
                                if sidebar-albums.length > 0: Rectangle { height: 1px; background: #1a1a1a; }
                                if sidebar-albums.length > 0: Rectangle { height: 6px; }
                                for al in sidebar-albums: Rectangle {
                                    height: 46px; border-radius: 6px;
                                    background: sbal-ta.has-hover ? Theme.hover-veil : transparent;
                                    HorizontalLayout {
                                        padding-left: sidebar-open ? 8px : 7px; padding-right: sidebar-open ? 8px : 7px;
                                        spacing: 10px; alignment: sidebar-open ? start : center;
                                        Rectangle {
                                            width: 34px; height: 34px; border-radius: 6px; clip: true;
                                            background: Theme.surface-hover;
                                            y: (parent.height - self.height) / 2;
                                            if al.has-thumbnail: Image { source: al.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
                                            if !al.has-thumbnail: Image { source: @image-url("icons/album.svg"); width: 16px; height: 16px; colorize: Theme.text-muted; x: 9px; y: 9px; }
                                        }
                                        if sidebar-open: VerticalLayout { alignment: center; spacing: 1px; horizontal-stretch: 1;
                                            Text { text: al.title; font-size: 13px; font-weight: 500; color: Theme.text; overflow: elide; }
                                            Text { text: al.artist; font-size: 10px; color: Theme.text-muted; overflow: elide; }
                                        }
                                    }
                                    RailTooltip { enabled: !sidebar-open && sbal-ta.has-hover; label: al.title; detail: al.artist; }
                                    sbal-ta := TouchArea { clicked => { navigate-to-album(al.browse-id); } }
                                }
                                if sidebar-playlists.length > 0: Rectangle { height: 8px; }
                                if sidebar-playlists.length > 0: Rectangle { height: 1px; background: #1a1a1a; }
                                if sidebar-playlists.length > 0: Rectangle { height: 6px; }
                                for p in sidebar-playlists: Rectangle {
                                    height: 42px; border-radius: 6px;
                                    background: sbp-ta.has-hover ? Theme.hover-veil : transparent;
                                    HorizontalLayout {
                                        padding-left: sidebar-open ? 8px : 7px; padding-right: sidebar-open ? 8px : 7px;
                                        spacing: 10px; alignment: sidebar-open ? start : center;
                                        Rectangle {
                                            width: 34px; height: 34px; border-radius: 6px; clip: true;
                                            background: Theme.surface-hover;
                                            y: (parent.height - self.height) / 2;
                                            if p.has-thumbnail: Image { source: p.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
                                            if !p.has-thumbnail: Image { source: @image-url("icons/library.svg"); width: 16px; height: 16px; colorize: Theme.text-muted; x: 9px; y: 9px; }
                                        }
                                        if sidebar-open: VerticalLayout { alignment: center; spacing: 1px; horizontal-stretch: 1;
                                            Text { text: p.title; font-size: 13px; font-weight: 500; color: Theme.text; overflow: elide; }
                                            Text { text: p.count-text; font-size: 10px; color: Theme.text-muted; }
                                        }
                                    }
                                    RailTooltip { enabled: !sidebar-open && sbp-ta.has-hover; label: p.title; detail: p.count-text; }
                                    sbp-ta := TouchArea { clicked => { navigate-to-playlist(p.playlist-id); } }
                                }
                            }
                        }
                        } // scroll-clip Rectangle (decouples sidebar height from content)
                    }
                }

                // ── Center content area ───────────────────────────────────
                VerticalLayout {
                    horizontal-stretch: 1;

                    // Header bar
                    Rectangle {
                        height: 60px; background: Theme.glass;
                        Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.border-soft; }
                        HorizontalLayout {
                            padding-left: 20px; padding-right: 20px; spacing: 8px;

                            // Fixed-width left controls + an equal right spacer keep the
                            // search box centered in the content area at every width.
                            HorizontalLayout {
                                width: 124px; spacing: 4px;
                                IconBtn { svg-icon: @image-url("icons/menu.svg"); use-svg: true; icon-color: Theme.text-muted; clicked => { toggle-sidebar(); } }

                                // Back / Forward
                                Rectangle {
                                    width: 36px; height: 36px; border-radius: 18px;
                                    background: can-go-back && nav-back-ta.has-hover ? Theme.hover-veil : transparent;
                                    Text { text: "←"; font-size: 18px; color: can-go-back ? Theme.text : Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                                    nav-back-ta := TouchArea { enabled: can-go-back; clicked => { nav-back(); } }
                                }
                                Rectangle {
                                    width: 36px; height: 36px; border-radius: 18px;
                                    background: can-go-forward && nav-fwd-ta.has-hover ? Theme.hover-veil : transparent;
                                    Text { text: "→"; font-size: 18px; color: can-go-forward ? Theme.text : Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                                    nav-fwd-ta := TouchArea { enabled: can-go-forward; clicked => { nav-forward(); } }
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            // Centered search bar.
                            search-bar-rect := Rectangle {
                                horizontal-stretch: 10; min-width: 150px; max-width: 420px;
                                height: 40px; border-radius: 20px;
                                background: search-inp.has-focus ? Theme.glass-hover : Theme.glass;
                                border-color: search-inp.has-focus ? Theme.accent : Theme.border;
                                border-width: 1px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 40px; padding-top: 10px; padding-bottom: 10px; spacing: 10px; alignment: start;
                                    Image { source: @image-url("icons/search.svg"); width: 18px; height: 18px; colorize: search-inp.has-focus ? Theme.accent : Theme.text-muted; vertical-alignment: center; }
                                    search-inp := TextInput {
                                        horizontal-stretch: 1;
                                        font-size: 14px; color: Theme.text;
                                        vertical-alignment: center;
                                        accepted => { do-search(self.text); search-dropdown-open = false; }
                                        edited => { live-search(self.text); search-dropdown-open = true; }
                                    }
                                    if search-inp.text == "": Text {
                                        text: "Search songs, albums, artists...";
                                        font-size: 14px; color: Theme.text-dim;
                                        vertical-alignment: center;
                                    }
                                }
                                // Background click area to focus search (below the X button)
                                TouchArea { x: 0; y: 0; width: parent.width; height: parent.height; clicked => { search-inp.focus(); } }
                                // Clear button (X) - absolutely positioned at right edge
                                if search-inp.text != "": Rectangle {
                                    x: parent.width - 36px; y: 5px;
                                    width: 30px; height: 30px; border-radius: 15px;
                                    background: clr-btn.has-hover ? Theme.hover-veil : transparent;
                                    Image { source: @image-url("icons/close.svg"); width: 14px; height: 14px; colorize: Theme.text-muted; x: 8px; y: 8px; }
                                    clr-btn := TouchArea { clicked => { search-inp.text = ""; search-inp.focus(); live-search(""); } }
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }
                            Rectangle { width: 124px; }
                        }

                    }

                    // View area
                    Rectangle {
                        vertical-stretch: 1; background: Theme.bg; clip: true;

                        // Loading
                        if is-loading: VerticalLayout {
                            alignment: center; spacing: 10px;
                            Text { text: "Searching..."; font-size: 18px; color: #808080; horizontal-alignment: center; }
                            Text { text: "Hold tight"; font-size: 13px; color: #4a4a4a; horizontal-alignment: center; }
                        }

                        // HOME
                        if !is-loading && current-view == "Home": Flickable {
                            viewport-height: home-col.preferred-height + 60px;
                            home-col := VerticalLayout {
                                padding: 32px; padding-top: 28px; spacing: 0px;

                                // ── Featured listening hero ──────────────────────────────────
                                Rectangle {
                                    height: 190px; border-radius: Theme.radius-lg; clip: true;
                                    background: @linear-gradient(120deg, Theme.accent-soft 0%, Theme.glass-hover 38%, Theme.glass 100%);
                                    border-color: Theme.border; border-width: 1px;
                                    drop-shadow-blur: 28px; drop-shadow-color: #00000045; drop-shadow-offset-y: 10px;

                                    HorizontalLayout {
                                        padding-left: 42px; padding-right: 42px; padding-top: 24px; padding-bottom: 24px;
                                        spacing: 34px; alignment: start;

                                        // Featured artwork (current track) with a centered hover play control.
                                        Rectangle {
                                            width: 142px; height: 142px; border-radius: Theme.radius; clip: true;
                                            background: Theme.surface-hover;
                                            drop-shadow-blur: 26px; drop-shadow-color: #00000070; drop-shadow-offset-y: 8px;
                                            if has-album-art: Image { source: album-art; width: parent.width; height: parent.height; image-fit: cover; }
                                            if !has-album-art: Rectangle {
                                                width: parent.width; height: parent.height;
                                                background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent.darker(0.4) 100%);
                                                Text { text: track-initial; color: Theme.on-accent; font-size: 44px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                            if hero-art-ta.has-hover: Rectangle {
                                                x: (parent.width - 42px) / 2; y: (parent.height - 42px) / 2;
                                                width: 42px; height: 42px; border-radius: 21px;
                                                background: #00000099; border-color: #ffffff70; border-width: 1px;
                                                Image { source: is-playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg"); width: 18px; height: 18px; colorize: #ffffff; x: is-playing ? 12px : 13px; y: 12px; }
                                            }
                                            hero-art-ta := TouchArea { clicked => { if (now-playing-video-id != "") { toggle-play-pause(); } else { navigate("Explore"); } } }
                                        }

                                        VerticalLayout {
                                            alignment: center; spacing: 8px; horizontal-stretch: 1;
                                            Text {
                                                text: now-playing-video-id != "" ? "FEATURED NOW" : "DISCOVER SOMETHING NEW";
                                                font-size: 11px; font-weight: 700; color: Theme.accent;
                                            }
                                            Text {
                                                text: now-playing-video-id != "" ? track-title : "Find your next favorite";
                                                font-size: 26px; font-weight: 750; color: Theme.text; overflow: elide;
                                            }
                                            Text {
                                                text: now-playing-video-id != "" ? track-artist
                                                    : (queue.length > 0 ? "\{queue.length} songs waiting in your queue" : "Search artists, albums, and songs");
                                                font-size: 14px; color: Theme.text-muted; overflow: elide;
                                            }
                                            Rectangle { height: 5px; }
                                            Rectangle {
                                                width: hero-listen-text.preferred-width + 36px; height: 36px; border-radius: 18px;
                                                background: hero-listen-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                                border-color: Theme.accent-strong; border-width: 1px;
                                                hero-listen-text := Text {
                                                    text: now-playing-video-id != "" ? (is-playing ? "Pause" : "Listen Now") : "Explore Music";
                                                    color: Theme.on-accent; font-size: 13px; font-weight: 650;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                                hero-listen-ta := TouchArea { clicked => { if (now-playing-video-id != "") { toggle-play-pause(); } else { navigate("Explore"); } } }
                                            }
                                        }
                                    }
                                }



                                // ── Trending Now ─────────────────────────────────────────────
                                if trending-songs.length > 0: VerticalLayout {
                                    padding-top: 44px; spacing: 16px;
                                    HorizontalLayout {
                                        height: 28px; alignment: space-between;
                                        Text { text: "Trending Now"; font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                        Text { text: "🔥"; font-size: 18px; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 270px; clip: true;
                                        Flickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: trend-row.preferred-width + 16px;
                                            trend-row := HorizontalLayout {
                                                spacing: 16px;
                                                for item[i] in trending-songs: SongCard {
                                                    go-to-album-clicked => { open-album-for(item.video-id); }
                                                    artist-radio-clicked => { start-artist-radio(item.video-id, item.artist); }
                                                    add-to-playlist-clicked => { open-add-to-playlist(item.video-id, item.title, item.artist, item.duration-secs); }
                                                    card-title: item.title; card-artist: item.artist;
                                                    avatar-letter: item.avatar-letter;
                                                    thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                                    is-now-playing: item.video-id == now-playing-video-id;
                                                    is-playing: root.is-playing && item.video-id == now-playing-video-id;
                                                    video-id: item.video-id;
                                                    clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                                    queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                                    play-next-clicked => { play-next-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                                    pause-clicked => { toggle-play-pause(); }
                                                    song-radio-clicked => { start-song-radio(item.video-id); }
                                                    go-to-artist-clicked => { go-to-song-artist(item.artist); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // ── Based on your listening ──────────────────────────────────
                                // ── From artists you follow ──────────────────────────────────
