import { LineEdit, ListView } from "std-widgets.slint";

export struct ArtistCredit {
    name: string,
    browse-id: string,
}

export struct SearchEntry {
    kind: string,
    id: string,
    title: string,
    subtitle: string,
    artist: string,
    album: string,
    duration-secs: int,
    thumbnail: image,
    has-thumbnail: bool,
}

struct SongItem {
    video-id: string,
    title: string,
    artist: string,
    album: string,
    duration-str: string,
    avatar-letter: string,
    duration-secs: int,
    thumbnail: image,
    has-thumbnail: bool,
}

struct ArtistItem {
    name: string,
    browse-id: string,
    thumbnail: image,
    has-thumbnail: bool,
    subscriber-count: string,
}

struct AlbumItem {
    title: string,
    browse-id: string,
    artist: string,
    year: string,
    thumbnail: image,
    has-thumbnail: bool,
}

struct PlaylistItem {
    title: string,
    playlist-id: string,
    thumbnail: image,
    has-thumbnail: bool,
    count-text: string,
}

struct MoodItem {
    title: string,
    params: string,
}

// ─── Theme (single source of truth for colors + radii) ───────────────────────
// The whole palette is DERIVED from one `accent` color + a light/dark `is-light`
// flag, so a single user choice re-skins the app while the relationships between
// colors stay fixed. Rust sets `accent` + `is-light` from the saved settings.
export global Theme {
    // Inputs (set from Rust / Settings)
    in property <color> accent: #6486b0;      // default "Default Blue" — muted steel blue (from reference)
    in property <bool> is-light: false;

    // Palette sampled from the reference: crisp, OPAQUE dark-slate surfaces carrying
    // only a small accent tint. NOTE `accent.mix(base, f)` = f*accent + (1-f)*base,
    // so a SMALL f keeps the surface mostly the neutral dark base. (The previous code
    // wrote `base.mix(accent, 0.04)` which is ~96% accent — that is what turned the
    // whole app washed-out blue.)
    out property <color> bg:            is-light ? accent.mix(#ffffff, 0.05)  : accent.mix(#0c1016, 0.05);
    out property <color> surface:       is-light ? accent.mix(#ffffff, 0.06)  : accent.mix(#12161f, 0.06);
    out property <color> surface-2:     is-light ? accent.mix(#ffffff, 0.07)  : accent.mix(#171d27, 0.06);
    out property <color> surface-hover: is-light ? accent.mix(#e9ecf1, 0.09)  : accent.mix(#212835, 0.07);
    out property <color> elevated:      is-light ? #ffffff                    : accent.mix(#1b212c, 0.06);

    // Panel/menu surfaces (kept the glass-* names) — now fully OPAQUE for the clean,
    // crisp look of the reference instead of the previous frosted haze.
    out property <color> glass:        is-light ? #ffffff : accent.mix(#12161f, 0.06);
    out property <color> glass-strong: is-light ? #ffffff : accent.mix(#1a2029, 0.06);
    out property <color> glass-hover:  is-light ? #eceef3 : accent.mix(#232b38, 0.06);

    // Frosted chrome (player bar / queue pane). Slightly translucent for a premium
    // glass hint, kept high-opacity so it never turns muddy.
    out property <color> frost:    is-light ? #ffffff.with-alpha(0.82) : accent.mix(#141a24, 0.06).with-alpha(0.9);
    out property <color> frost-hi: is-light ? #000000.with-alpha(0.06) : #ffffff.with-alpha(0.08);

    // Text
    out property <color> text:       is-light ? #171a20 : #f2f4f8;
    out property <color> text-muted: is-light ? #565d69 : #97a1ae;
    out property <color> text-dim:   is-light ? #838b98 : #5a6470;

    // Accent variants
    out property <color> accent-strong: accent.brighter(0.15);
    out property <color> accent-soft:   accent.with-alpha(0.16);
    out property <color> on-accent:     is-light ? #111318 : #ffffff;

    // Lines / borders
    out property <color> border:      is-light ? #000000.with-alpha(0.09) : #ffffff.with-alpha(0.07);
    out property <color> border-soft: is-light ? #000000.with-alpha(0.05) : #ffffff.with-alpha(0.045);

    // Hover veils (used over images / transparent rows)
    out property <color> hover-veil:  is-light ? #000000.with-alpha(0.05) : #ffffff.with-alpha(0.05);
    out property <color> press-veil:  is-light ? #000000.with-alpha(0.10) : #ffffff.with-alpha(0.10);

    // Semantic status colors (theme-aware so they stay legible in light mode)
    out property <color> success:     is-light ? #1d7a3a : #62c97e;
    out property <color> danger:      is-light ? #c62828 : #f0685f;
    out property <color> danger-bg:   is-light ? #c62828 : #b3352e;
    out property <color> on-danger:   #ffffff;

    // Text drawn ON TOP of artwork / colored hero banners. Artwork is arbitrary,
    // so these stay light in BOTH modes and rely on the scrim below.
    out property <color> on-art:       #ffffff;
    out property <color> on-art-muted: #ffffff.with-alpha(0.78);
    out property <color> on-art-dim:   #ffffff.with-alpha(0.60);
    out property <color> art-scrim:    #000000.with-alpha(0.45);
    out property <color> art-veil:     #ffffff.with-alpha(0.14);
    out property <color> art-veil-hi:  #ffffff.with-alpha(0.22);

    // Placeholder tile behind missing artwork
    out property <color> art-placeholder: is-light ? accent.mix(#dfe3ea, 0.07) : accent.mix(#1e2530, 0.07);

    // Corner radii
    out property <length> radius-sm: 8px;
    out property <length> radius:    14px;
    out property <length> radius-lg: 20px;

    // Layout — caps line length on ultrawide monitors so lists don't stretch
    // into a wall of dead space between the title and the duration column.
    out property <length> content-max: 1180px;
    out property <length> section-gap: 24px;
    out property <length> heading-gap: 12px;
}

// ─── Shared components ────────────────────────────────────────────────────────

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <color> icon-color: Theme.text-muted;
    in property <bool> active: false;
    in property <image> svg-icon;
    in property <bool> use-svg: false;
    callback clicked();
    width: 36px; height: 36px; border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.hover-veil : (active ? Theme.accent-soft : transparent);
    if !use-svg: Text {
        text: root.icon;
        color: ta.has-hover ? Theme.text : (root.active ? Theme.text : root.icon-color);
        font-size: 18px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if use-svg: Image {
        source: root.svg-icon;
        width: 20px; height: 20px;
        colorize: ta.has-hover ? Theme.text : (root.active ? Theme.text : root.icon-color);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Slim progress bar for add-on installs. `value` in 0.0..=1.0 shows a determinate
// fill; a negative `value` shows an indeterminate sliding segment.
component AddonProgress inherits Rectangle {
    in property <float> value: 0.0;
    property <bool> indeterminate: root.value < 0.0;
    property <bool> anim-toggle: false;
    height: 6px; border-radius: 3px; background: Theme.surface-hover;
    clip: true;

    // Determinate fill
    if !root.indeterminate: Rectangle {
        x: 0; y: 0; height: parent.height; border-radius: 3px;
        width: parent.width * max(0.0, min(1.0, root.value));
        background: Theme.accent;
        animate width { duration: 120ms; easing: ease-out; }
    }

    // Indeterminate sliding segment
    if root.indeterminate: Rectangle {
        y: 0; height: parent.height; border-radius: 3px;
        width: parent.width * 0.35;
        background: Theme.accent;
        x: root.anim-toggle ? (parent.width - self.width) : 0px;
        animate x { duration: 900ms; easing: ease-in-out; }
    }
    timer := Timer {
        interval: 900ms;
        running: root.indeterminate;
        triggered => { root.anim-toggle = !root.anim-toggle; }
    }
}

// Delayed, non-interactive label for the collapsed sidebar rail. A PopupWindow
// lets it escape the sidebar scroll clip without moving or widening the layout.
component RailTooltip inherits Rectangle {
    in property <bool> enabled: false;
    in property <string> label: "";
    in property <string> detail: "";
    width: 0px; height: 0px;
    changed enabled => { if (!enabled) { tip.close(); } }
    Timer {
        interval: 1s;
        running: root.enabled;
        triggered => { if (root.enabled) { tip.show(); } }
    }
    tip := PopupWindow {
        x: 58px; y: -4px; width: 210px;
        Rectangle {
            width: 210px;
            height: root.detail == "" ? 38px : 54px;
            border-radius: Theme.radius-sm;
                background: Theme.glass-strong;
            border-color: Theme.border; border-width: 1px;
            drop-shadow-blur: 18px; drop-shadow-color: #00000070; drop-shadow-offset-y: 5px;
            VerticalLayout {
                padding-left: 12px; padding-right: 12px; padding-top: 7px; padding-bottom: 7px;
                alignment: center; spacing: 2px;
                Text { text: root.label; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                if root.detail != "": Text { text: root.detail; color: Theme.text-muted; font-size: 11px; overflow: elide; }
            }
        }
    }
}

component NavBtn inherits Rectangle {
    in property <string> label; in property <image> nav-icon; in property <bool> active;
    in property <bool> expanded: true;
    callback clicked();
    height: 44px; border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.hover-veil : (active ? Theme.accent-soft : transparent);
    animate background { duration: 100ms; }
    HorizontalLayout {
        padding-left: expanded ? 14px : 7px; padding-right: expanded ? 14px : 7px;
        padding-top: 11px; padding-bottom: 11px; spacing: 14px; alignment: start;
        Image {
            source: root.nav-icon; width: 22px; height: 22px;
            colorize: root.active ? Theme.accent : Theme.text-muted;
            vertical-alignment: center;
        }
        if root.expanded: Text { text: root.label; font-size: 15px; font-weight: root.active ? 700 : 500; color: root.active ? Theme.text : Theme.text-muted; vertical-alignment: center; }
    }
    RailTooltip { enabled: !root.expanded && ta.has-hover; label: root.label; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TabPill inherits Rectangle {
    in property <string> label; in property <bool> active;
    callback clicked();
    height: 32px; border-radius: 16px;
    background: active ? Theme.accent-soft : (ta.has-hover ? Theme.hover-veil : transparent);
    border-color: active ? Theme.border : transparent; border-width: 1px;
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px;
        Text {
            text: root.label; font-size: 13px; font-weight: root.active ? 700 : 500;
            color: root.active ? Theme.text : Theme.text-muted;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component ThemeChoice inherits Rectangle {
    in property <string> theme-label;
    in property <color> theme-color;
    in property <bool> selected: false;
    callback picked();
    height: 38px; border-radius: Theme.radius-sm;
    background: choice-ta.has-hover ? Theme.hover-veil : (selected ? Theme.accent-soft : transparent);
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px; alignment: start;
        Rectangle {
            width: 18px; height: 18px; border-radius: 9px;
            background: root.theme-color; border-color: Theme.border; border-width: 1px;
            y: (parent.height - self.height) / 2;
        }
        Text { text: root.theme-label; font-size: 13px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
        if selected: Text { text: "✓"; font-size: 13px; color: Theme.accent; vertical-alignment: center; }
    }
    choice-ta := TouchArea { clicked => { root.picked(); } }
}

// ─── Context-menu row (consistent icon slot + label alignment) ────────────────
// One row of a right-click popup menu. Every row uses a fixed-width icon slot so
// all labels line up, whether the icon is an SVG image or a text glyph.
component CtxMenuItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> use-image: true;      // false → render `glyph` text instead
    in property <string> glyph: "";
    in property <length> glyph-size: 15px;
    in property <color> icon-color: Theme.text-muted;
    in property <color> label-color: Theme.text;
    in property <bool> submenu: false;
    in property <bool> selected: false;
    callback clicked;
    callback hovered;
    height: 40px;
    border-radius: Theme.radius-sm;
    background: mi-ta.has-hover || root.selected ? Theme.hover-veil : transparent;
    HorizontalLayout {
        padding-left: 14px; padding-right: 12px; spacing: 12px; alignment: start;
        // Fixed-width icon slot; every glyph/image is centered in the full row
        // height so labels AND icons line up regardless of glyph size.
        Rectangle {
            width: 22px;
            if root.use-image: Image {
                source: root.icon; width: 16px; height: 16px; colorize: root.icon-color;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            }
            if !root.use-image: Text {
                text: root.glyph; font-size: root.glyph-size; color: root.icon-color;
                width: parent.width; height: parent.height;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        Text {
            text: root.label; font-size: 14px; font-weight: 500; color: root.label-color;
            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
        }
        if root.submenu: Text {
            text: "\u{203A}"; width: 12px; font-size: 18px;
            color: Theme.text-muted; vertical-alignment: center;
        }
    }
    mi-ta := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => { if self.has-hover { root.hovered(); } }
    }
}

component SongRow inherits Rectangle {
    in property <string> song-title; in property <string> song-artist;
    in property <string> song-album; in property <string> song-duration;
    in property <string> idx-str; in property <bool> is-current;
    in property <string> avatar-letter: "";
    in property <image> thumbnail;
    in property <bool> has-thumbnail: false;
    // Album/playlist context: show a real track number instead of the first
    // letter of the title (a letter reads as a broken artwork fallback).
    in property <bool> show-index: false;
    // Suppress the thumbnail (album pages show the artwork once in the hero).
    in property <bool> hide-art: false;
    // Give the album its own column instead of cramming it into the subtitle.
    in property <bool> show-album-column: false;
    // On an album page the artist is the same on every row — redundant.
    in property <bool> hide-artist: false;
    callback play-clicked(); callback queue-clicked();
    // Right-click reports the cursor position; the window-root menu supplies the actions.
    callback context-requested(length, length);
    height: 56px; border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.hover-veil : (is-current ? Theme.accent-soft : transparent);
    HorizontalLayout {
        padding-left: 12px; padding-right: 14px; spacing: 12px;
        // Track number column (album/playlist context only). Swaps to a play
        // icon on hover so the row's primary action is discoverable. Uses the
        // SVG rather than a "▶" glyph, which renders as a tofu box in the
        // default UI font at small sizes.
        if root.show-index: Rectangle {
            width: 26px;
            if !root.is-current && !ta.has-hover: Text {
                text: root.idx-str;
                color: Theme.text-dim;
                font-size: 13px; font-weight: 600;
                width: parent.width; height: parent.height;
                horizontal-alignment: right; vertical-alignment: center;
            }
            if root.is-current || ta.has-hover: Image {
                source: @image-url("icons/play.svg");
                width: 12px; height: 12px;
                colorize: root.is-current ? Theme.accent : Theme.text;
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
            }
        }
        // Thumbnail (suppressed on album pages, which already show the artwork
        // once in the hero — repeating it 15x is just noise).
        if !root.hide-art: Rectangle {
            width: 44px; height: 44px; border-radius: 6px; clip: true;
            y: (parent.height - self.height) / 2;
            background: Theme.art-placeholder;
            if has-thumbnail: Image {
                source: thumbnail; width: parent.width; height: parent.height; image-fit: cover;
            }
            if !has-thumbnail: Text {
                text: avatar-letter == "" ? root.idx-str : avatar-letter;
                color: is-current ? Theme.accent : Theme.text-dim;
                font-size: 13px;
                font-weight: 700;
                width: parent.width; height: parent.height;
                horizontal-alignment: center; vertical-alignment: center;
            }
            // Playing overlay — skipped when a track-number column is present,
            // otherwise the row shows two "now playing" markers side by side.
            if is-current && has-thumbnail && !root.show-index: Rectangle {
                width: parent.width; height: parent.height;
                background: Theme.art-scrim;
                Image {
                    source: @image-url("icons/play.svg");
                    width: 14px; height: 14px; colorize: Theme.on-art;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        // Title + artist
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 3;
            Text {
                text: root.song-title;
                font-size: 14px; font-weight: 500;
                color: is-current ? Theme.accent : Theme.text;
                overflow: elide;
            }
            if !root.hide-artist: Text {
                text: (root.show-album-column || root.song-album == "")
                    ? root.song-artist
                    : root.song-artist + "  •  " + root.song-album;
                font-size: 12px; color: Theme.text-muted; overflow: elide;
            }
        }
        // Album column — fills the dead space between the title and the duration
        // on wide windows.
        //
        // Deliberately a FIXED-width cell rather than a stretchy one: a `Text` with
        // `overflow: elide` reports its preferred width as its max width, so in a
        // stretched cell it never grows and the row just centers it, giving a
        // ragged column. A fixed box with an explicitly sized child is the same
        // pattern the duration column uses, and it aligns reliably.
        if root.show-album-column: Rectangle {
            width: 300px;
            Text {
                text: root.song-album;
                font-size: 12px; color: Theme.text-muted; overflow: elide;
                x: 0; y: 0; width: parent.width; height: parent.height;
                horizontal-alignment: left; vertical-alignment: center;
            }
        }
        // Duration column. It only reserves the space — the "+ Queue" pill that
        // replaces it on hover is an overlay declared after `ta` (see below).
        Rectangle {
            width: 64px;
            if !ta.has-hover: Text {
                text: root.song-duration;
                font-size: 12px; color: Theme.text-dim;
                width: parent.width; height: parent.height;
                horizontal-alignment: right; vertical-alignment: center;
            }
        }
    }
    ta := TouchArea {
        clicked => { root.play-clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.context-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }

    // "+ Queue" affordance, overlaying the duration column on hover.
    //
    // MUST be declared AFTER `ta` AND be unconditional: later siblings win
    // hit-testing in Slint, but an `if`-gated sibling still loses to a static
    // one, so gating it made clicks fall through to the row (= played the song).
    //
    // Hidden via transparent colors rather than `opacity`, and with no drop
    // shadow: both force a FemtoVG offscreen layer, and one per row stalled
    // fast scrolling.
    Rectangle {
        x: parent.width - 78px; y: 0;
        width: 64px; height: parent.height;
        Rectangle {
            width: 56px; height: 28px; border-radius: 14px;
            x: parent.width - self.width;
            y: (parent.height - self.height) / 2;
            background: ta.has-hover ? (qa.has-hover ? Theme.surface-hover : Theme.hover-veil) : transparent;
            if ta.has-hover: Text { text: "+ Queue"; color: qa.has-hover ? Theme.text : Theme.text-muted; font-size: 10px; font-weight: 600;
                width: parent.width; height: parent.height;
                horizontal-alignment: center; vertical-alignment: center; }
        }
        qa := TouchArea { clicked => { root.queue-clicked(); } }
    }
}

// Flickable with eased scrolling. Slint snaps viewport-y by a fixed step per
// wheel notch, which reads as choppy regardless of frame rate (measured 130+ fps
// while scrolling felt janky). Interpolating the jump is what makes it smooth.
component SmoothFlickable inherits Flickable {
    animate viewport-x, viewport-y { duration: 90ms; easing: ease-out; }
    @children
}

// Right-edge fade for a horizontally scrollable row, so it reads as scrollable
// instead of looking like the last card was clipped by a bug.
// Fills its parent (a component root cannot reference `parent`) and anchors the
// gradient to its own right edge.
component EdgeFade inherits Rectangle {
    in property <length> fade-width: 48px;
    // Horizontal scroll offset of the carousel this overlays; negative once scrolled.
    in property <length> scroll-x: 0px;
    background: transparent;
    // Left fade appears only once content is scrolled off, otherwise it would dim
    // the first card at rest.
    if root.scroll-x < -1px: Rectangle {
        x: 0;
        y: 0;
        width: root.fade-width;
        height: root.height;
        background: @linear-gradient(90deg, Theme.bg 0%, Theme.bg.with-alpha(0) 100%);
    }
    Rectangle {
        x: root.width - root.fade-width;
        y: 0;
        width: root.fade-width;
        height: root.height;
        background: @linear-gradient(90deg, Theme.bg.with-alpha(0) 0%, Theme.bg 100%);
    }
}

component GenreTile inherits Rectangle {
    in property <string> label; in property <color> tile-color; in property <string> icon;
    callback clicked();
    height: 100px; border-radius: 12px;
    background: ta.has-hover ? tile-color.brighter(0.1) : tile-color;
    HorizontalLayout {
        padding: 20px; spacing: 12px; alignment: start;
        Text { text: root.icon; font-size: 26px; vertical-alignment: center; }
        Text { text: root.label; font-size: 16px; font-weight: 600; color: Theme.on-art; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component SongCard inherits Rectangle {
    in property <string> card-title;
    in property <string> card-artist;
    in property <string> avatar-letter;
    in property <bool> is-now-playing: false;
    in property <bool> is-playing: false;
    in property <image> thumbnail;
    in property <bool> has-thumbnail: false;
    in property <string> video-id: "";
    callback clicked();
    callback queue-clicked();
    callback pause-clicked();
    // Right-click reports the cursor position; the window-root menu supplies the actions.
    callback context-requested(length, length);
    private property <bool> card-hovered: ta.has-hover || play-ta.has-hover;
    width: 200px; height: 260px; border-radius: Theme.radius;
    background: root.card-hovered ? Theme.glass-hover : Theme.glass;
    border-color: root.card-hovered ? Theme.border : Theme.border-soft; border-width: 1px;

    VerticalLayout {
        padding: 12px; spacing: 12px;
        // Square thumbnail with play button overlay
        Rectangle {
            width: 176px; height: 176px; border-radius: Theme.radius; clip: true;
            background: Theme.art-placeholder;
            if has-thumbnail: Image {
                source: thumbnail; width: parent.width; height: parent.height; image-fit: cover;
            }
            if !has-thumbnail: Rectangle {
                width: parent.width; height: parent.height;
                background: Theme.art-placeholder;
                Text {
                    text: is-now-playing ? "▶" : (avatar-letter == "" ? "♪" : avatar-letter);
                    color: is-now-playing ? Theme.accent : Theme.text-dim;
                    font-size: 36px; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            // Now playing indicator bar
            if is-now-playing: Rectangle {
                x: 0; y: parent.height - 3px; width: parent.width; height: 3px;
                background: Theme.accent;
            }
        }
        VerticalLayout {
            spacing: 4px; padding-left: 2px;
            Text { text: card-title; font-size: 14px; font-weight: 700; color: Theme.text; overflow: elide; }
            Text { text: card-artist; font-size: 12px; font-weight: 500; color: Theme.text-muted; overflow: elide; }
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.context-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }

    // Play/Pause button, centered over the 176px artwork (which sits at the
    // card's 12px padding). MUST be declared AFTER `ta` AND be unconditional:
    // later siblings win hit-testing in Slint, but an `if`-gated sibling still
    // loses to a static one, so gating it made Pause restart the track.
    //
    // Hidden via transparent colors rather than `opacity`, and with no drop
    // shadow: both force a FemtoVG offscreen layer, which at one per visible
    // card was what stalled fast scrolling.
    Rectangle {
        x: 12px + (176px - 46px) / 2;
        y: 12px + (176px - 46px) / 2;
        width: 46px; height: 46px; border-radius: 23px;
        background: root.card-hovered
            ? (play-ta.has-hover ? #000000.with-alpha(0.72) : #000000.with-alpha(0.5))
            : transparent;
        border-color: root.card-hovered ? #ffffff.with-alpha(0.56) : transparent;
        border-width: 1px;
        if root.card-hovered && !(is-now-playing && is-playing): Image { source: @image-url("icons/play.svg"); width: 20px; height: 20px; colorize: Theme.on-art; x: 14px; y: 13px; }
        if root.card-hovered && is-now-playing && is-playing: Image { source: @image-url("icons/pause.svg"); width: 20px; height: 20px; colorize: Theme.on-art; x: 13px; y: 13px; }
        play-ta := TouchArea {
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                    root.context-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            clicked => {
                if (root.is-now-playing && root.is-playing) {
                    root.pause-clicked();
                } else {
                    root.clicked();
                }
            }
        }
    }
}

// ─── Main window ──────────────────────────────────────────────────────────────

export component NativeShellWindow inherits Window {
    // Playback state
    in-out property <string> track-title: "Nothing playing";
    in-out property <string> track-artist: "Select a song to start";
    in-out property <bool> is-playing: false;
    in-out property <float> progress: 0.0;
    in-out property <string> current-time: "0:00";
    in-out property <string> total-time: "--:--";
    in-out property <float> volume: 0.8;
    in-out property <string> track-initial: "?";
    in-out property <image> album-art;
    in-out property <bool> has-album-art: false;
    in-out property <bool> is-liked: false;
    in-out property <string> now-playing-video-id: "";

    // Navigation
    in-out property <string> current-view: "Home";
    in-out property <bool> sidebar-open: true;
    in-out property <bool> queue-pane-open: false;
    // Responsive breakpoint. Set imperatively from `changed width` (below) rather
    // than as a reactive binding on root.width — a reactive binding would form a
    // layout-info loop (element sizes depend on width, width depends on their
    // layout-info) which Slint flags as deprecated / may panic.
    property <bool> compact: false;   // < 1200px: shrink header + player-bar side panels
    in-out property <string> library-tab: "Liked";
    in-out property <[AlbumItem]> library-albums: [];
    in-out property <[ArtistItem]> library-artists: [];
    in-out property <[PlaylistItem]> library-playlists: [];
    // Sidebar (left pane) shortcuts — your artists + your playlists.
    in-out property <[ArtistItem]> sidebar-artists: [];
    in-out property <[PlaylistItem]> sidebar-playlists: [];
    // Albums from recently-listened songs (left-pane shortcut, like the artists).
    in-out property <[AlbumItem]> sidebar-albums: [];
    in-out property <string> library-sort: "recent";
    callback load-library-data();
    callback sort-library(string);
    callback navigate-to-playlist(string);

    // Data
    in-out property <[SongItem]> search-results: [];
    in-out property <[SongItem]> queue: [];
    in-out property <[SongItem]> liked-songs: [];
    in-out property <bool> autoplay-enabled: true;
    in-out property <[SongItem]> autoplay-queue: [];
    callback set-autoplay-enabled(bool);
    callback play-autoplay-song(int);
    in-out property <[SongItem]> trending-songs: [];
    in-out property <[SongItem]> personalized-songs: [];
    in-out property <[SongItem]> home-followed-songs: [];

    // Home screen enhancements
    in-out property <[AlbumItem]> home-new-releases: [];
    in-out property <[SongItem]> home-mix-1: [];
    in-out property <[SongItem]> home-mix-2: [];
    in-out property <[SongItem]> home-mix-3: [];
    in-out property <string> home-mix-1-title: "Your Mix";
    in-out property <string> home-mix-2-title: "Discover Mix";
    in-out property <string> home-mix-3-title: "Chill Mix";
    in-out property <[SongItem]> home-genre-mix: [];
    in-out property <string> home-genre-mix-title: "";
    in-out property <[SongItem]> home-language-section: [];
    in-out property <string> home-language-title: "";
    callback load-home-data();
    callback play-mix(int);

    // Artist view
    in-out property <string> artist-view-name: "";
    in-out property <[SongItem]> artist-view-songs: [];
    in-out property <[AlbumItem]> artist-view-albums: [];
    in-out property <image> artist-view-thumbnail;
    in-out property <bool> artist-view-has-thumbnail: false;
    in-out property <string> artist-view-description: "";
    in-out property <bool> artist-view-subscribed: false;
    callback toggle-subscribe-artist();
    in-out property <[AlbumItem]> artist-view-singles: [];
    in-out property <[ArtistItem]> artist-view-related: [];
    in-out property <[SongItem]> artist-view-videos: [];
    in-out property <AlbumItem> artist-view-latest-release: { title: "", browse-id: "", artist: "", year: "", has-thumbnail: false };
    in-out property <bool> artist-view-has-latest: false;

    // Radio view
    in-out property <string> radio-title: "";
    in-out property <[SongItem]> radio-songs: [];
    callback play-radio();
    callback play-album();
    callback shuffle-album();

    // Playlist view
    in-out property <string> playlist-view-title: "";
    in-out property <[SongItem]> playlist-view-songs: [];
    in-out property <image> playlist-view-thumbnail;
    in-out property <bool> playlist-view-has-thumbnail: false;
    in-out property <string> playlist-view-count: "";
    in-out property <string> playlist-view-duration: "";
    in-out property <[PlaylistItem]> playlist-view-similar: [];
    in-out property <bool> playlist-view-liked: false;
    callback play-playlist();
    callback shuffle-playlist();
    callback toggle-like-playlist();
    // Local (user-created) playlists
    in-out property <bool> playlist-view-is-local: false;
    in-out property <string> playlist-view-id: "";
    callback new-playlist();
    callback delete-local-playlist(string);
    callback remove-from-local-playlist(string, string); // playlist-id, video-id
    // Add-to-playlist modal
    in-out property <bool> show-playlist-modal: false;
    in-out property <string> pending-song-vid: "";
    in-out property <string> pending-song-title: "";
    in-out property <string> pending-song-artist: "";
    in-out property <int> pending-song-dur: 0;
    in-out property <[PlaylistItem]> modal-playlists: [];
    callback open-add-to-playlist(string, string, string, int);
    callback submit-new-playlist(string);
    callback add-to-existing-playlist(string); // playlist-id

    // Album view
    in-out property <string> album-view-title: "";
    in-out property <string> album-view-artist: "";
    in-out property <string> album-view-year: "";
    in-out property <[SongItem]> album-view-songs: [];
    in-out property <image> album-view-thumbnail;
    in-out property <bool> album-view-has-thumbnail: false;
    in-out property <string> album-view-duration: "";
    in-out property <string> album-view-description: "";
    in-out property <[AlbumItem]> album-view-more-by-artist: [];
    in-out property <[AlbumItem]> album-view-similar: [];
    in-out property <bool> album-view-liked: false;
    callback toggle-like-album();

    // Search enhancements
    in-out property <string> search-filter: "All";
    in-out property <[ArtistItem]> search-artists: [];
    in-out property <[AlbumItem]> search-albums: [];
    in-out property <SearchEntry> search-top;
    in-out property <string> search-intent: "";
    in-out property <string> search-query: "";
    in-out property <[PlaylistItem]> search-playlists: [];
    in-out property <bool> search-busy: false;
    in-out property <bool> search-detail-busy: false;
    in-out property <string> search-error: "";
    in-out property <string> search-detail-error: "";
    in-out property <[SearchEntry]> search-preview: [];
    in-out property <bool> search-preview-busy: false;
    in-out property <string> search-preview-error: "";
    property <bool> search-catalogue-visible: search-filter != "All"
        || (search-top.kind != "Artist" && search-top.kind != "Album")
        || !search-detail-busy;
    property <bool> search-has-visible-results: search-filter == "Songs" ? search-results.length > 0
        : search-filter == "Artists" ? search-artists.length > 0
        : search-filter == "Albums" ? search-albums.length > 0
        : search-filter == "Playlists" ? search-playlists.length > 0
        : search-top.kind != "" || search-results.length > 0 || search-artists.length > 0
            || search-albums.length > 0 || search-playlists.length > 0;
    callback search-category(string);
    callback activate-search-entry(SearchEntry);
            callback search-view-changed(string);
            changed current-view => { search-view-changed(current-view); }

    in-out property <bool> is-loading: false;

    // Callbacks
    callback toggle-play-pause();
    callback prev-track();
    callback next-track();
    callback seek(float);
    callback set-volume(float);
    callback do-search(string);
    callback live-search(string);
    in-out property <[SongItem]> search-suggestions: [];
    in-out property <bool> search-dropdown-open: false;
    in-out property <int> search-preview-selected: -1;
    function close-search-preview() {
        search-dropdown-open = false;
        search-preview-selected = -1;
        live-search("");
    }
    function open-search-preview() {
        if search-inp.text != "" {
            search-preview-selected = -1;
            search-dropdown-open = true;
            live-search(search-inp.text);
        }
    }
    function submit-search(text: string) {
        close-search-preview();
        key-scope.focus();
        if text != "" { do-search(text); }
    }
    function choose-search-preview(entry: SearchEntry) {
        if entry.kind == "Completion" { search-inp.text = entry.title; }
        close-search-preview();
        key-scope.focus();
        activate-search-entry(entry);
    }
    function move-search-preview(step: int) {
        if !search-dropdown-open {
            open-search-preview();
        } else if !search-preview-busy && search-preview-error == "" && search-preview.length > 0 {
            search-preview-selected = search-preview-selected < 0
                ? (step > 0 ? 0 : search-preview.length - 1)
                : max(0, min(search-preview.length - 1, search-preview-selected + step));
        }
    }
    callback play-song(string, string, string, int);
    callback queue-song(string, string, string);
    callback play-next-song(string, string, string, int);
    callback remove-from-queue(int);
    callback remove-from-autoplay(int);
    callback navigate(string);
    callback toggle-sidebar();
    callback toggle-queue-pane();
    callback like-current();
    callback unlike-song(string);
    callback dislike-song(string, string, string, int);
    callback clear-cache();
    callback explore-genre(string);
    in-out property <[MoodItem]> explore-moods: [];
    in-out property <[SongItem]> explore-new-releases: [];
    callback load-explore-data();
    callback explore-mood(string);
    callback navigate-to-artist(string);
    callback navigate-to-album(string);
    callback start-song-radio(string);
    callback start-artist-radio(string, string);
    callback move-queue-song-next(int);
    callback open-artist-for(string, string); // video-id, artist-name → resolve by id else name
    callback open-album-for(string, string);  // video-id + album-name fallback ? resolve album
    callback album-resolvable(string, string) -> bool;
    callback go-to-song-artist(string);
    callback go-to-song-album(string);

    // ── Shared context menu ───────────────────────────────────────────────────
    // One popup at the window root instead of one per row/card. Every SongRow and
    // SongCard used to embed its own PopupWindow (~50 elements) that was built
    // whether or not it was ever shown.
    in-out property <string> ctx-video-id: "";
    in-out property <string> ctx-title: "";
    in-out property <string> ctx-artist: "";
    in-out property <string> ctx-album: "";
    in-out property <string> ctx-kind: "Song";
    in-out property <string> ctx-id: "";
    in-out property <int> ctx-generation: 0;
    in-out property <[ArtistCredit]> ctx-artists: [];
    in-out property <bool> ctx-artists-loading: false;
    in-out property <string> ctx-artists-error: "";
    in-out property <string> ctx-status: "";
    in-out property <bool> ctx-saved: false;
    callback prepare-context(string, string, string, string, string, int);
    callback context-album(string, string, string, string);
    callback context-artist(string, string);
    callback context-action(string, string, string, string, string);
    property <int> ctx-duration: 0;
    property <int> ctx-index: -1;
    property <string> ctx-playlist-id: "";
    property <bool> ctx-show-unlike: false;
    property <bool> ctx-show-remove-playlist: false;
    property <bool> ctx-in-queue: false;
    property <bool> ctx-in-autoplay: false;
    property <bool> ctx-can-album: ctx-video-id != "" && current-view != "Album";
    property <bool> ctx-submenu-open: false;
    property <int> ctx-artist-selected: -1;
    property <length> ctx-x: 0px;
    property <length> ctx-y: 0px;
    property <length> ctx-main-x: max(12px, min(ctx-x, root.width - 260px));
    property <bool> ctx-submenu-left: ctx-main-x + 472px > root.width - 12px;

    function show-ctx-menu() {
        ctx-menu.show();
    }
    function close-ctx-menu() {
        ctx-submenu-open = false;
        ctx-artist-selected = -1;
        ctx-menu.close();
        key-scope.focus();
    }
    function choose-context-artist() {
        if ctx-artists.length == 1 {
            context-artist(ctx-artists[0].browse-id, ctx-artists[0].name);
            close-ctx-menu();
        } else {
            ctx-submenu-open = true;
        }
    }

    function ctx-reset-state(px: length, py: length) {
        ctx-index = -1;
        ctx-playlist-id = "";
        ctx-show-unlike = false;
        ctx-show-remove-playlist = false;
        ctx-in-queue = false;
        ctx-in-autoplay = false;
        ctx-artists = [];
        ctx-artists-loading = true;
        ctx-artists-error = "";
        ctx-saved = false;
        ctx-submenu-open = false;
        ctx-artist-selected = -1;
        ctx-x = px;
        ctx-y = py;
        ctx-generation += 1;
    }
    function ctx-reset(vid: string, t: string, a: string, alb: string, dur: int, px: length, py: length) {
        ctx-kind = "Song";
        ctx-id = vid;
        ctx-video-id = vid;
        ctx-title = t;
        ctx-artist = a;
        ctx-album = alb;
        ctx-duration = dur;
        ctx-reset-state(px, py);
        prepare-context(ctx-kind, ctx-id, ctx-title, ctx-artist, ctx-album, ctx-generation);
    }
    public function open-entity-ctx(kind: string, id: string, title: string, artist: string, px: length, py: length) {
        ctx-kind = kind;
        ctx-id = id;
        ctx-video-id = "";
        ctx-title = title;
        ctx-artist = artist;
        ctx-album = kind == "Album" ? title : "";
        ctx-duration = 0;
        ctx-reset-state(px, py);
        prepare-context(ctx-kind, ctx-id, ctx-title, ctx-artist, ctx-album, ctx-generation);
        show-ctx-menu();
    }
    public function open-ctx(vid: string, t: string, a: string, alb: string, dur: int, px: length, py: length) {
        ctx-reset(vid, t, a, alb, dur, px, py);
        show-ctx-menu();
    }
    public function open-ctx-liked(vid: string, t: string, a: string, alb: string, dur: int, px: length, py: length) {
        ctx-reset(vid, t, a, alb, dur, px, py);
        ctx-show-unlike = true;
        show-ctx-menu();
    }
    public function open-ctx-playlist(vid: string, t: string, a: string, alb: string, dur: int, pid: string, px: length, py: length) {
        ctx-reset(vid, t, a, alb, dur, px, py);
        ctx-playlist-id = pid;
        ctx-show-remove-playlist = pid != "";
        show-ctx-menu();
    }
    public function open-ctx-queue(vid: string, t: string, a: string, alb: string, dur: int, idx: int, px: length, py: length) {
        ctx-reset(vid, t, a, alb, dur, px, py);
        ctx-index = idx;
        ctx-in-queue = true;
        show-ctx-menu();
    }
    public function open-ctx-autoplay(vid: string, t: string, a: string, alb: string, dur: int, idx: int, px: length, py: length) {
        ctx-reset(vid, t, a, alb, dur, px, py);
        ctx-index = idx;
        ctx-in-autoplay = true;
        show-ctx-menu();
    }
    callback nav-back();
    callback nav-forward();
    callback set-minimize-to-tray(bool);
    in-out property <string> theme-name: "Default Blue";
    in-out property <string> theme-mode: "System";
    callback set-theme-name(string);
    callback set-theme-mode(string);
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <bool> minimize-to-tray: true;
    // Cache
    in-out property <int> cache-limit-mb: 500;
    in-out property <int> cache-used-mb: 0;
    in-out property <int> cache-song-count: 0;
    callback set-cache-limit(int);
    // Prefetch: how many upcoming songs to fully cache ahead of the current one.
    in-out property <int> prefetch-depth: 1;
    callback set-prefetch-depth(int);

    // Essential add-ons (yt-dlp / ffmpeg) — optional third-party tools, not bundled.
    in-out property <bool> ytdlp-installed: false;
    in-out property <bool> deno-installed: false;
    in-out property <bool> ffmpeg-installed: false;
    in-out property <bool> addon-busy: false;
    in-out property <string> addon-status: "";
    in-out property <string> addon-installing: "";   // "ytdlp" | "ffmpeg" | ""
    in-out property <float> addon-progress: 0.0;      // 0.0–1.0, negative = indeterminate
    callback install-ytdlp();
    callback update-ytdlp();
    callback install-ffmpeg();
    callback install-deno();
    callback refresh-addons();

    // App updates — only the portable build self-updates. Installer/Store builds
    // hide this entirely (self-update-enabled = false) and defer to their manager.
    in-out property <string> app-version: "";
    in-out property <bool> self-update-enabled: false;
    in-out property <bool> update-available: false;
    in-out property <bool> update-busy: false;
    in-out property <string> update-status: "";
    callback check-updates();
    callback apply-update();

    // First-run onboarding popup for add-on installation.
    in-out property <bool> show-onboarding: false;
    callback dismiss-onboarding();

    in-out property <string> window-title: "Auricle";
    title: window-title;
    icon: @image-url("../icons/icon.png");
    preferred-width: 1280px; preferred-height: 800px;
    min-width: 800px; min-height: 500px;
    background: Theme.bg;
    default-font-family: "Segoe UI Variable";
    default-font-size: 14px;
    default-font-weight: 500;

    // Recompute the responsive breakpoint imperatively on resize (avoids a layout
    // binding loop — see the `compact` property note above).
    init => { compact = root.width < 1200px; }
    changed width => { compact = root.width < 1200px; }

    forward-focus: key-scope;
    key-scope := FocusScope {
        // Empty, zero-size global key handler. `forward-focus` (above) routes the
        // window's key events here regardless of size. The visible UI is a *direct
        // child of the Window* below — wrapping it in the FocusScope made the content
        // collapse to a preferred (short) height and clip, leaving black space below
        // on a taller/maximized window. A layout placed directly in a Window fills it.
        width: 0px;
        height: 0px;
        key-pressed(e) => {
            if e.text == " "           { toggle-play-pause(); return accept; }
            if e.text == Key.LeftArrow { prev-track();         return accept; }
            if e.text == Key.RightArrow{ next-track();         return accept; }
            if e.text == Key.Escape    {
                if search-dropdown-open { close-search-preview(); return accept; }
                if queue-pane-open { toggle-queue-pane(); return accept; }
            }
            reject
        }
    }

    // Main UI — a direct Window child so it reliably fills the whole window.
    VerticalLayout {
        width: root.width;
        height: root.height;

            // Width probe — an inner element whose width tracks the window. Its
            // `changed width` fires reliably during layout/resize (the Window's own
            // `changed width` doesn't fire in some backends), driving the responsive
            // `compact` flag imperatively so there's no layout binding loop.
            Rectangle {
                height: 0;
                changed width => { root.compact = self.width < 1200px; }
            }

            // ── Main area (above player bar) ──────────────────────────────
            HorizontalLayout {
                vertical-stretch: 1;

                // ── Left sidebar ──────────────────────────────────────────
                // Always remains functional: expanded at 260px, collapsed to a 72px
                // icon rail. It only disappears temporarily when a queue pane needs
                // the horizontal room on a compact window.
                if !(compact && queue-pane-open): Rectangle {
                    width: sidebar-open ? 260px : 72px; background: Theme.glass;
                    animate width { duration: 180ms; easing: ease-out; }
                    Rectangle { x: parent.width - 1px; y: 0; width: 1px; height: parent.height; background: Theme.border; }

                    VerticalLayout {
                        padding-left: sidebar-open ? 18px : 12px; padding-right: sidebar-open ? 18px : 12px;
                        padding-top: 20px; padding-bottom: 16px;

                        // Logo
                        HorizontalLayout {
                            height: 44px; spacing: 10px; alignment: sidebar-open ? start : center;
                            Text { text: "▶"; color: Theme.accent; font-size: 22px; vertical-alignment: center; }
                            if sidebar-open: Text { text: "Auricle"; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                        }

                        Rectangle { height: 20px; }

                        // Navigation
                        NavBtn { label: "Home";     expanded: sidebar-open; nav-icon: @image-url("icons/home.svg"); active: current-view == "Home";     clicked => { navigate("Home"); }     }
                        NavBtn { label: "Explore";  expanded: sidebar-open; nav-icon: @image-url("icons/explore.svg"); active: current-view == "Explore";  clicked => { navigate("Explore"); }  }
                        NavBtn { label: "Library";  expanded: sidebar-open; nav-icon: @image-url("icons/library.svg"); active: current-view == "Library";  clicked => { navigate("Library"); }  }
                        NavBtn { label: "Settings"; expanded: sidebar-open; nav-icon: @image-url("icons/settings.svg"); active: current-view == "Settings"; clicked => { navigate("Settings"); } }

                        Rectangle { height: 24px; }
                        Rectangle { height: 1px; background: Theme.border; }
                        Rectangle { height: 20px; }

                        // Liked Songs shortcut
                        Rectangle {
                            height: 56px; border-radius: Theme.radius-sm;
                            background: ls-ta.has-hover ? Theme.hover-veil : Theme.border-soft;
                            HorizontalLayout {
                                padding-left: sidebar-open ? 12px : 6px; padding-right: sidebar-open ? 12px : 6px;
                                padding-top: 10px; padding-bottom: 10px; spacing: 12px; alignment: sidebar-open ? start : center;
                                Rectangle {
                                    width: 36px; height: 36px; border-radius: 4px;
                                    background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent.darker(0.35) 100%);
                                    Text { text: "♥"; color: Theme.on-accent; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                if sidebar-open: VerticalLayout {
                                    alignment: center; spacing: 2px; horizontal-stretch: 1;
                                    Text { text: "Liked Songs"; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                }
                            }
                            RailTooltip { enabled: !sidebar-open && ls-ta.has-hover; label: "Liked Songs"; detail: "Your liked tracks"; }
                            ls-ta := TouchArea { clicked => { library-tab = "Liked"; navigate("Library"); } }
                        }

                        Rectangle { height: 14px; }

                        // Your artists + albums + playlists — scrollable. Wrapped in a
                        // clipping, vertical-stretch Rectangle (same pattern as the main
                        // content area) so the sidebar's height is DECOUPLED from its content
                        // length. Without this, the scroll content's height became the
                        // sidebar's max-height and propagated up the layout tree, capping how
                        // tall the whole window could be maximized/resized.
                        Rectangle {
                            vertical-stretch: 1; clip: true;
                            SmoothFlickable {
                                width: 100%; height: 100%;
                                viewport-height: sb-col.preferred-height;
                                sb-col := VerticalLayout {
                                spacing: 2px;
                                if sidebar-artists.length > 0: Rectangle { height: 1px; background: Theme.border; }
                                if sidebar-artists.length > 0: Rectangle { height: 6px; }
                                if sidebar-artists.length > 0 && sidebar-open: Text {
                                    text: "ARTISTS"; font-size: 10px; font-weight: 700; letter-spacing: 0.8px;
                                    color: Theme.text-dim;
                                }
                                if sidebar-artists.length > 0 && sidebar-open: Rectangle { height: 4px; }
                                for a in sidebar-artists: Rectangle {
                                    height: 40px; border-radius: 6px;
                                    background: sba-ta.has-hover ? Theme.hover-veil : transparent;
                                    HorizontalLayout {
                                        padding-left: sidebar-open ? 8px : 7px; padding-right: sidebar-open ? 8px : 7px;
                                        spacing: 10px; alignment: sidebar-open ? start : center;
                                        Rectangle {
                                            width: 34px; height: 34px; border-radius: 17px; clip: true;
                                            background: Theme.art-placeholder; y: (parent.height - self.height) / 2;
                                            if a.has-thumbnail: Image { source: a.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
                                            if !a.has-thumbnail: Image { source: @image-url("icons/artist.svg"); width: 16px; height: 16px; colorize: Theme.text-muted; x: 9px; y: 9px; }
                                        }
                                        if sidebar-open: VerticalLayout { alignment: center; horizontal-stretch: 1;
                                            Text { text: a.name; font-size: 13px; font-weight: 500; color: Theme.text; overflow: elide; }
                                        }
                                    }
                                    RailTooltip { enabled: !sidebar-open && sba-ta.has-hover; label: a.name; detail: "Artist"; }
                                    sba-ta := TouchArea {
                                        clicked => { if a.browse-id != "" { navigate-to-artist(a.browse-id); } else { go-to-song-artist(a.name); } }
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                open-entity-ctx("Artist", a.browse-id, a.name, a.name,
                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                }
                                // Recently-listened albums.
                                if sidebar-albums.length > 0: Rectangle { height: 8px; }
                                if sidebar-albums.length > 0: Rectangle { height: 1px; background: Theme.border; }
                                if sidebar-albums.length > 0: Rectangle { height: 6px; }
                                if sidebar-albums.length > 0 && sidebar-open: Text {
                                    text: "ALBUMS"; font-size: 10px; font-weight: 700; letter-spacing: 0.8px;
                                    color: Theme.text-dim;
                                }
                                if sidebar-albums.length > 0 && sidebar-open: Rectangle { height: 4px; }
                                for al in sidebar-albums: Rectangle {
                                    height: 46px; border-radius: 6px;
                                    background: sbal-ta.has-hover ? Theme.hover-veil : transparent;
                                    HorizontalLayout {
                                        padding-left: sidebar-open ? 8px : 7px; padding-right: sidebar-open ? 8px : 7px;
                                        spacing: 10px; alignment: sidebar-open ? start : center;
                                        Rectangle {
                                            width: 34px; height: 34px; border-radius: 6px; clip: true;
                                            background: Theme.surface-hover;
                                            y: (parent.height - self.height) / 2;
                                            if al.has-thumbnail: Image { source: al.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
                                            if !al.has-thumbnail: Image { source: @image-url("icons/album.svg"); width: 16px; height: 16px; colorize: Theme.text-muted; x: 9px; y: 9px; }
                                        }
                                        if sidebar-open: VerticalLayout { alignment: center; spacing: 1px; horizontal-stretch: 1;
                                            Text { text: al.title; font-size: 13px; font-weight: 500; color: Theme.text; overflow: elide; }
                                            Text { text: al.artist; font-size: 10px; color: Theme.text-muted; overflow: elide; }
                                        }
                                    }
                                    RailTooltip { enabled: !sidebar-open && sbal-ta.has-hover; label: al.title; detail: al.artist; }
                                    sbal-ta := TouchArea {
                                        clicked => { navigate-to-album(al.browse-id); }
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                open-entity-ctx("Album", al.browse-id, al.title, al.artist,
                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                }
                                if sidebar-playlists.length > 0: Rectangle { height: 8px; }
                                if sidebar-playlists.length > 0: Rectangle { height: 1px; background: Theme.border; }
                                if sidebar-playlists.length > 0: Rectangle { height: 6px; }
                                if sidebar-playlists.length > 0 && sidebar-open: Text {
                                    text: "PLAYLISTS"; font-size: 10px; font-weight: 700; letter-spacing: 0.8px;
                                    color: Theme.text-dim;
                                }
                                if sidebar-playlists.length > 0 && sidebar-open: Rectangle { height: 4px; }
                                for p in sidebar-playlists: Rectangle {
                                    height: 42px; border-radius: 6px;
                                    background: sbp-ta.has-hover ? Theme.hover-veil : transparent;
                                    HorizontalLayout {
                                        padding-left: sidebar-open ? 8px : 7px; padding-right: sidebar-open ? 8px : 7px;
                                        spacing: 10px; alignment: sidebar-open ? start : center;
                                        Rectangle {
                                            width: 34px; height: 34px; border-radius: 6px; clip: true;
                                            background: Theme.surface-hover;
                                            y: (parent.height - self.height) / 2;
                                            if p.has-thumbnail: Image { source: p.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
                                            if !p.has-thumbnail: Image { source: @image-url("icons/library.svg"); width: 16px; height: 16px; colorize: Theme.text-muted; x: 9px; y: 9px; }
                                        }
                                        if sidebar-open: VerticalLayout { alignment: center; spacing: 1px; horizontal-stretch: 1;
                                            Text { text: p.title; font-size: 13px; font-weight: 500; color: Theme.text; overflow: elide; }
                                            Text { text: p.count-text; font-size: 10px; color: Theme.text-muted; }
                                        }
                                    }
                                    RailTooltip { enabled: !sidebar-open && sbp-ta.has-hover; label: p.title; detail: p.count-text; }
                                    sbp-ta := TouchArea { clicked => { navigate-to-playlist(p.playlist-id); } }
                                }
                            }
                        }
                        } // scroll-clip Rectangle (decouples sidebar height from content)
                    }
                }

                // ── Center content area ───────────────────────────────────
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 0px;

                    // Header bar
                    Rectangle {
                        height: 60px; background: Theme.glass;
                        Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.border-soft; }
                        HorizontalLayout {
                            padding-left: 20px; padding-right: 20px; spacing: 8px;

                            // Fixed-width left controls + an equal right spacer keep the
                            // search box centered in the content area at every width.
                            // Each control is wrapped in a centering VerticalLayout so it
                            // sits on the bar's optical centre line instead of being
                            // stretched/top-aligned by the row.
                            HorizontalLayout {
                                width: 124px; spacing: 4px;
                                VerticalLayout {
                                    alignment: center;
                                    IconBtn { svg-icon: @image-url("icons/menu.svg"); use-svg: true; icon-color: Theme.text-muted; clicked => { toggle-sidebar(); } }
                                }

                                // Back / Forward
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 36px; height: 36px; border-radius: 18px;
                                        background: can-go-back && nav-back-ta.has-hover ? Theme.hover-veil : transparent;
                                        Text { text: "←"; font-size: 18px; color: can-go-back ? Theme.text : Theme.text-dim;
                                            width: parent.width; height: parent.height;
                                            horizontal-alignment: center; vertical-alignment: center; }
                                        nav-back-ta := TouchArea { enabled: can-go-back; clicked => { nav-back(); } }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 36px; height: 36px; border-radius: 18px;
                                        background: can-go-forward && nav-fwd-ta.has-hover ? Theme.hover-veil : transparent;
                                        Text { text: "→"; font-size: 18px; color: can-go-forward ? Theme.text : Theme.text-dim;
                                            width: parent.width; height: parent.height;
                                            horizontal-alignment: center; vertical-alignment: center; }
                                        nav-fwd-ta := TouchArea { enabled: can-go-forward; clicked => { nav-forward(); } }
                                    }
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            // Centered search bar.
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 10; min-width: 150px; max-width: 420px;
                                search-bar-rect := Rectangle {
                                height: 40px; border-radius: 20px;
                                background: search-inp.has-focus ? Theme.glass-hover : Theme.glass;
                                border-color: search-inp.has-focus ? Theme.accent : Theme.border;
                                border-width: 1px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 40px; spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 18px; height: 24px;
                                            Image { source: @image-url("icons/search.svg"); width: 18px; height: 18px; y: 3px; colorize: search-inp.has-focus ? Theme.accent : Theme.text-muted; }
                                            TouchArea { clicked => { search-inp.focus(); open-search-preview(); } }
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1; min-width: 0px;
                                        if search-inp.text == "": Text {
                                            text: "Search music";
                                            width: parent.width; height: parent.height;
                                            font-size: 14px; color: Theme.text-dim;
                                            vertical-alignment: center; overflow: elide;
                                        }
                                        search-inp := TextInput {
                                            width: parent.width; height: parent.height;
                                            font-size: 14px; color: Theme.text;
                                            selection-background-color: Theme.accent;
                                            selection-foreground-color: Theme.on-accent;
                                            vertical-alignment: center; single-line: true;
                                            changed has-focus => {
                                                if self.has-focus {
                                                    if !search-dropdown-open { open-search-preview(); }
                                                } else if search-dropdown-open { close-search-preview(); }
                                            }
                                            accepted => {
                                                if search-dropdown-open && !search-preview-busy && search-preview-error == ""
                                                    && search-preview-selected >= 0 && search-preview-selected < search-preview.length {
                                                    choose-search-preview(search-preview[search-preview-selected]);
                                                } else { submit-search(self.text); }
                                            }
                                            edited => {
                                                search-preview-selected = -1;
                                                if self.text == "" { close-search-preview(); }
                                                else { search-dropdown-open = true; live-search(self.text); }
                                            }
                                            key-pressed(event) => {
                                                if event.text == "\u{1}" || (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                                                    self.select-all();
                                                    return accept;
                                                }
                                                if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta {
                                                    if event.text == Key.DownArrow { move-search-preview(1); return accept; }
                                                    if event.text == Key.UpArrow { move-search-preview(-1); return accept; }
                                                    if event.text == Key.Escape { close-search-preview(); key-scope.focus(); return accept; }
                                                }
                                                reject
                                            }
                                        }
                                    }
                                }
                                // Clear button (X) - absolutely positioned at right edge
                                Rectangle {
                                    x: parent.width - 36px; y: (parent.height - self.height) / 2;
                                    width: 30px; height: 30px; border-radius: 15px;
                                    background: search-inp.text != "" && clr-btn.has-hover ? Theme.hover-veil : transparent;
                                    if search-inp.text != "": Image { source: @image-url("icons/close.svg"); width: 14px; height: 14px; colorize: Theme.text-muted; x: 8px; y: 8px; }
                                    clr-btn := TouchArea { clicked => { close-search-preview(); search-inp.text = ""; search-inp.focus(); } }
                                }
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }
                            Rectangle { width: 124px; }
                        }

                    }

                    // View area
                    Rectangle {
                        vertical-stretch: 1; min-width: 0px; background: Theme.bg; clip: true;

                        // Loading
                        if is-loading && current-view != "Search": VerticalLayout {
                            alignment: center; spacing: 10px;
                            Text { text: "Searching..."; font-size: 18px; color: Theme.text-muted; horizontal-alignment: center; }
                            Text { text: "Hold tight"; font-size: 13px; color: Theme.text-dim; horizontal-alignment: center; }
                        }

                        // HOME
                        if !is-loading && current-view == "Home": SmoothFlickable {
                            viewport-width: self.width; viewport-height: home-col.preferred-height;
                            home-col := VerticalLayout {
                                width: parent.width; height: self.preferred-height; alignment: start;
                                padding: 32px; padding-top: 28px; spacing: 0px;

                                // ── Featured listening hero ──────────────────────────────────
                                Rectangle {
                                    // Grows instead of clipping: on a narrow window the title wraps
                                    // to two lines and pushed the Listen Now button out of a fixed box.
                                    min-height: 190px; border-radius: Theme.radius-lg; clip: true;
                                    background: @linear-gradient(120deg, Theme.accent-soft 0%, Theme.glass-hover 38%, Theme.glass 100%);
                                    border-color: Theme.border; border-width: 1px;
                                    drop-shadow-blur: 28px; drop-shadow-color: #00000045; drop-shadow-offset-y: 10px;

                                    HorizontalLayout {
                                        padding-left: 42px; padding-right: 42px; padding-top: 24px; padding-bottom: 24px;
                                        spacing: 34px;

                                        // Featured artwork (current track) with a centered hover play control.
                                        Rectangle {
                                            width: 142px; height: 142px; border-radius: Theme.radius; clip: true;
                                            background: Theme.art-placeholder;
                                            drop-shadow-blur: 26px; drop-shadow-color: #00000070; drop-shadow-offset-y: 8px;
                                            if has-album-art: Image { source: album-art; width: parent.width; height: parent.height; image-fit: cover; }
                                            if !has-album-art: Rectangle {
                                                width: parent.width; height: parent.height;
                                                background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent.darker(0.4) 100%);
                                                Text { text: track-initial; color: Theme.on-accent; font-size: 44px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                            if hero-art-ta.has-hover: Rectangle {
                                                x: (parent.width - 42px) / 2; y: (parent.height - 42px) / 2;
                                                width: 42px; height: 42px; border-radius: 21px;
                                                background: #000000.with-alpha(0.6); border-color: #ffffff.with-alpha(0.44); border-width: 1px;
                                                Image { source: is-playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg"); width: 18px; height: 18px; colorize: Theme.on-art; x: is-playing ? 12px : 13px; y: 12px; }
                                            }
                                            hero-art-ta := TouchArea { clicked => { if (now-playing-video-id != "") { toggle-play-pause(); } else { navigate("Explore"); } } }
                                        }

                                        VerticalLayout {
                                            alignment: center; spacing: 8px; horizontal-stretch: 1;
                                            Text {
                                                text: now-playing-video-id != "" ? "FEATURED NOW" : "DISCOVER SOMETHING NEW";
                                                font-size: 11px; font-weight: 700; color: Theme.accent;
                                            }
                                            Text {
                                                text: now-playing-video-id != "" ? track-title : "Find your next favorite";
                                                font-size: 26px; font-weight: 750; color: Theme.text;
                                                wrap: word-wrap; overflow: elide;
                                            }
                                            Text {
                                                text: now-playing-video-id != "" ? track-artist
                                                    : (queue.length > 0 ? "\{queue.length} songs waiting in your queue" : "Search artists, albums, and songs");
                                                font-size: 14px; color: Theme.text-muted; overflow: elide;
                                            }
                                            Rectangle { height: 5px; }
                                            // NOTE: a fixed-`width` child inside a VerticalLayout also caps
                                            // that layout's max-width, which previously collapsed this whole
                                            // text column to the button's width (~110px) and made the title
                                            // elide to "KHA...". Wrapping the button in a HorizontalLayout
                                            // keeps its size local.
                                            HorizontalLayout {
                                                alignment: start;
                                                Rectangle {
                                                    width: hero-listen-text.preferred-width + 36px; height: 36px; border-radius: 18px;
                                                    background: hero-listen-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                                    border-color: Theme.accent-strong; border-width: 1px;
                                                    hero-listen-text := Text {
                                                        text: now-playing-video-id != "" ? (is-playing ? "Pause" : "Listen Now") : "Explore Music";
                                                        color: Theme.on-accent; font-size: 13px; font-weight: 650;
                                                        width: parent.width; height: parent.height;
                                                        horizontal-alignment: center; vertical-alignment: center;
                                                    }
                                                    hero-listen-ta := TouchArea { clicked => { if (now-playing-video-id != "") { toggle-play-pause(); } else { navigate("Explore"); } } }
                                                }
                                            }
                                        }
                                    }
                                }



                                // ── Trending Now ─────────────────────────────────────────────
                                if trending-songs.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    HorizontalLayout {
                                        height: 28px; spacing: 8px; alignment: start;
                                        Text { text: "Trending Now"; font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                        Text { text: "🔥"; font-size: 16px; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 270px; clip: true;
                                        trend-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: trend-row.preferred-width + 16px;
                                            trend-row := HorizontalLayout {
                                                spacing: 16px;
                                                for item[i] in trending-songs: SongCard {
                                                    card-title: item.title; card-artist: item.artist;
                                                    avatar-letter: item.avatar-letter;
                                                    thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                                    is-now-playing: item.video-id == now-playing-video-id;
                                                    is-playing: root.is-playing && item.video-id == now-playing-video-id;
                                                    video-id: item.video-id;
                                                    clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                                    queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                                    context-requested(px, py) => { open-ctx(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                                    pause-clicked => { toggle-play-pause(); }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: trend-fl.viewport-x; }
                                    }
                                }

                                // ── Based on your listening ──────────────────────────────────
                                // ── From artists you follow ──────────────────────────────────
                                if home-followed-songs.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    HorizontalLayout {
                                        height: 28px; spacing: 8px; alignment: start;
                                        Text { text: "From artists you follow"; font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                        Text { text: "♥"; font-size: 16px; color: Theme.accent; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 270px; clip: true;
                                        foll-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: foll-row.preferred-width + 16px;
                                            foll-row := HorizontalLayout {
                                                spacing: 16px;
                                                for item[i] in home-followed-songs: SongCard {
                                                    card-title: item.title; card-artist: item.artist;
                                                    avatar-letter: item.avatar-letter;
                                                    thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                                    is-now-playing: item.video-id == now-playing-video-id;
                                                    is-playing: root.is-playing && item.video-id == now-playing-video-id;
                                                    video-id: item.video-id;
                                                    clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                                    queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                                    context-requested(px, py) => { open-ctx(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                                    pause-clicked => { toggle-play-pause(); }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: foll-fl.viewport-x; }
                                    }
                                }

                                if personalized-songs.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    HorizontalLayout {
                                        height: 28px; spacing: 8px; alignment: start;
                                        Text { text: "Based on your listening"; font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                        Text { text: "✨"; font-size: 16px; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 270px; clip: true;
                                        pers-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: pers-row.preferred-width + 16px;
                                            pers-row := HorizontalLayout {
                                                spacing: 16px;
                                                for item[i] in personalized-songs: SongCard {
                                                    card-title: item.title; card-artist: item.artist;
                                                    avatar-letter: item.avatar-letter;
                                                    thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                                    is-now-playing: item.video-id == now-playing-video-id;
                                                    is-playing: root.is-playing && item.video-id == now-playing-video-id;
                                                    video-id: item.video-id;
                                                    clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                                    queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                                    context-requested(px, py) => { open-ctx(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                                    pause-clicked => { toggle-play-pause(); }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: pers-fl.viewport-x; }
                                    }
                                }

                                // ── New releases for you ─────────────────────────────────────
                                if home-new-releases.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    HorizontalLayout {
                                        height: 28px; spacing: 8px; alignment: start;
                                        Text { text: "New releases for you"; font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                        Text { text: "💿"; font-size: 16px; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 272px; clip: true;
                                        nr-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: nr-row.preferred-width + 16px;
                                            nr-row := HorizontalLayout {
                                                spacing: 16px;
                                                for alb[i] in home-new-releases: Rectangle {
                                                    private property <bool> nr-hover: nr-ta.has-hover || nr-play-ta.has-hover;
                                                    width: 200px; height: 260px; border-radius: Theme.radius;
                                                    background: nr-hover ? Theme.glass-hover : Theme.glass;
                                                    border-color: nr-hover ? Theme.border : Theme.border-soft; border-width: 1px;
                                                    VerticalLayout {
                                                        padding: 12px; spacing: 12px;
                                                        Rectangle {
                                                            width: 176px; height: 176px; border-radius: Theme.radius-sm; clip: true;
                                                            background: Theme.art-placeholder;
                                                            if alb.has-thumbnail: Image {
                                                                source: alb.thumbnail; width: parent.width; height: parent.height; image-fit: cover;
                                                            }
                                                            if !alb.has-thumbnail: Image {
                                                                source: @image-url("icons/album.svg"); width: 42px; height: 42px; colorize: Theme.text-dim;
                                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 2px; padding-left: 4px;
                                                            Text { text: alb.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                                                            Text { text: alb.artist + (alb.year != "" ? "  •  " + alb.year : ""); font-size: 12px; color: Theme.text-muted; overflow: elide; }
                                                        }
                                                    }
                                                    nr-ta := TouchArea {
                                                        clicked => { navigate-to-album(alb.browse-id); }
                                                        pointer-event(event) => {
                                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                                open-entity-ctx("Album", alb.browse-id, alb.title, alb.artist,
                                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                            }
                                                        }
                                                    }
                                                    Rectangle {
                                                        x: 78px; y: 78px; width: 44px; height: 44px; border-radius: 22px;
                                                        background: nr-hover ? (nr-play-ta.has-hover ? #000000.with-alpha(0.72) : #000000.with-alpha(0.5)) : transparent;
                                                        border-color: nr-hover ? #ffffff.with-alpha(0.56) : transparent; border-width: 1px;
                                                        if nr-hover: Image { source: @image-url("icons/play.svg"); width: 18px; height: 18px; colorize: Theme.on-art; x: 14px; y: 13px; }
                                                        nr-play-ta := TouchArea {
                                                            clicked => { navigate-to-album(alb.browse-id); }
                                                            pointer-event(event) => {
                                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                                    open-entity-ctx("Album", alb.browse-id, alb.title, alb.artist,
                                                                        self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: nr-fl.viewport-x; }
                                    }
                                }

                                // ── Mixed for you (hidden for now) ───────────────────────────
                                if false && home-mix-1.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    HorizontalLayout {
                                        height: 28px; alignment: space-between;
                                        Text { text: "Mixed for you"; font-size: 22px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "🎧"; font-size: 18px; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 170px; clip: true;
                                        SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: mix-row.preferred-width + 16px;
                                            mix-row := HorizontalLayout {
                                                spacing: 16px;
                                                // Mix 1
                                                Rectangle {
                                                    width: 250px; height: 160px; border-radius: 12px;
                                                    background: mix1-ta.has-hover
                                                        ? @linear-gradient(135deg, #5a2d82 0%, #2a1545 100%)
                                                        : @linear-gradient(135deg, #4a1d72 0%, #1a0535 100%);
                                                    animate background { duration: 150ms; }
                                                    VerticalLayout {
                                                        padding: 20px; spacing: 8px; alignment: space-between;
                                                        VerticalLayout {
                                                            spacing: 4px;
                                                            Text { text: home-mix-1-title; font-size: 18px; font-weight: 700; color: #ffffff; }
                                                            Text { text: "\{home-mix-1.length} songs"; font-size: 12px; color: #b0b0b0; }
                                                        }
                                                        Rectangle {
                                                            width: 40px; height: 40px; border-radius: 20px;
                                                            background: #1db954;
                                                            Image { source: @image-url("icons/play.svg"); width: 18px; height: 18px; colorize: #000000; x: 12px; y: 11px; }
                                                        }
                                                    }
                                                    mix1-ta := TouchArea { clicked => { play-mix(1); } }
                                                }
                                                // Mix 2
                                                Rectangle {
                                                    width: 250px; height: 160px; border-radius: 12px;
                                                    background: mix2-ta.has-hover
                                                        ? @linear-gradient(135deg, #1a5a5a 0%, #0a2a2a 100%)
                                                        : @linear-gradient(135deg, #0a4a4a 0%, #001a1a 100%);
                                                    animate background { duration: 150ms; }
                                                    VerticalLayout {
                                                        padding: 20px; spacing: 8px; alignment: space-between;
                                                        VerticalLayout {
                                                            spacing: 4px;
                                                            Text { text: home-mix-2-title; font-size: 18px; font-weight: 700; color: #ffffff; }
                                                            Text { text: "\{home-mix-2.length} songs"; font-size: 12px; color: #b0b0b0; }
                                                        }
                                                        Rectangle {
                                                            width: 40px; height: 40px; border-radius: 20px;
                                                            background: #1db954;
                                                            Image { source: @image-url("icons/play.svg"); width: 18px; height: 18px; colorize: #000000; x: 12px; y: 11px; }
                                                        }
                                                    }
                                                    mix2-ta := TouchArea { clicked => { play-mix(2); } }
                                                }
                                                // Mix 3
                                                Rectangle {
                                                    width: 250px; height: 160px; border-radius: 12px;
                                                    background: mix3-ta.has-hover
                                                        ? @linear-gradient(135deg, #5a3a1a 0%, #2a1a0a 100%)
                                                        : @linear-gradient(135deg, #4a2a0a 0%, #1a0a00 100%);
                                                    animate background { duration: 150ms; }
                                                    VerticalLayout {
                                                        padding: 20px; spacing: 8px; alignment: space-between;
                                                        VerticalLayout {
                                                            spacing: 4px;
                                                            Text { text: home-mix-3-title; font-size: 18px; font-weight: 700; color: #ffffff; }
                                                            Text { text: "\{home-mix-3.length} songs"; font-size: 12px; color: #b0b0b0; }
                                                        }
                                                        Rectangle {
                                                            width: 40px; height: 40px; border-radius: 20px;
                                                            background: #1db954;
                                                            Image { source: @image-url("icons/play.svg"); width: 18px; height: 18px; colorize: #000000; x: 12px; y: 11px; }
                                                        }
                                                    }
                                                    mix3-ta := TouchArea { clicked => { play-mix(3); } }
                                                }
                                            }
                                        }
                                    }
                                }

                                // ── Genre Mix (hidden for now) ───────────────────────────────
                                if false && home-genre-mix.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    HorizontalLayout {
                                        height: 28px; alignment: space-between;
                                        Text { text: home-genre-mix-title; font-size: 22px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "🎵"; font-size: 18px; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 270px; clip: true;
                                        SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: genre-mix-row.preferred-width + 16px;
                                            genre-mix-row := HorizontalLayout {
                                                spacing: 16px;
                                                for item[i] in home-genre-mix: SongCard {
                                                    card-title: item.title; card-artist: item.artist;
                                                    avatar-letter: item.avatar-letter;
                                                    thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                                    is-now-playing: item.video-id == now-playing-video-id;
                                                    is-playing: root.is-playing && item.video-id == now-playing-video-id;
                                                    video-id: item.video-id;
                                                    clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                                    queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                                    context-requested(px, py) => { open-ctx(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                                    pause-clicked => { toggle-play-pause(); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // ── Language-based music ─────────────────────────────────────
                                if home-language-section.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    HorizontalLayout {
                                        height: 28px; spacing: 8px; alignment: start;
                                        Text { text: home-language-title; font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                        Text { text: "🌍"; font-size: 16px; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 270px; clip: true;
                                        lang-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: lang-row.preferred-width + 16px;
                                            lang-row := HorizontalLayout {
                                                spacing: 16px;
                                                for item[i] in home-language-section: SongCard {
                                                    card-title: item.title; card-artist: item.artist;
                                                    avatar-letter: item.avatar-letter;
                                                    thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                                    is-now-playing: item.video-id == now-playing-video-id;
                                                    is-playing: root.is-playing && item.video-id == now-playing-video-id;
                                                    video-id: item.video-id;
                                                    clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                                    queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                                    context-requested(px, py) => { open-ctx(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                                    pause-clicked => { toggle-play-pause(); }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: lang-fl.viewport-x; }
                                    }
                                }

                                // ── Recently Liked ───────────────────────────────────────────
                                if liked-songs.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    HorizontalLayout {
                                        height: 28px; alignment: space-between;
                                        Text { text: "Recently Liked"; font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                        rl-all := TouchArea {
                                            width: 60px; height: 24px;
                                            Text { text: "See all"; font-size: 12px; color: rl-all.has-hover ? Theme.text : Theme.text-muted; vertical-alignment: center; horizontal-alignment: right; }
                                            clicked => { library-tab = "Liked"; navigate("Library"); }
                                        }
                                    }
                                    Rectangle {
                                        height: 270px; clip: true;
                                        rl-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: rl-row.preferred-width + 16px;
                                            rl-row := HorizontalLayout {
                                                spacing: 16px;
                                                for item[i] in liked-songs: SongCard {
                                                    card-title: item.title; card-artist: item.artist;
                                                    avatar-letter: item.avatar-letter;
                                                    thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                                    is-now-playing: item.video-id == now-playing-video-id;
                                                    is-playing: root.is-playing && item.video-id == now-playing-video-id;
                                                    video-id: item.video-id;
                                                    clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                                    queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                                    context-requested(px, py) => { open-ctx(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                                    pause-clicked => { toggle-play-pause(); }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: rl-fl.viewport-x; }
                                    }
                                }

                                // ── Empty state ──────────────────────────────────────────────
                                if queue.length == 0 && liked-songs.length == 0: Rectangle {
                                    height: 280px;
                                    VerticalLayout { alignment: center; spacing: 16px;
                                        Rectangle {
                                            width: 80px; height: 80px; border-radius: 40px;
                                            background: Theme.surface;
                                            border-color: Theme.border; border-width: 1px;
                                            x: (parent.width - self.width) / 2;
                                            Text { text: "♪"; font-size: 36px; color: Theme.text-dim;
                                                width: parent.width; height: parent.height;
                                                horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Text { text: "Nothing playing yet"; font-size: 20px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                                        Text { text: "Search above or explore to discover music"; font-size: 13px; color: Theme.text-muted; horizontal-alignment: center; }
                                        Rectangle {
                                            height: 40px; width: 130px; border-radius: 20px; x: (parent.width - self.width) / 2;
                                            background: go-exp.has-hover ? Theme.accent-strong : Theme.accent;
                                            animate background { duration: 100ms; }
                                            Text { text: "Explore →"; font-size: 13px; font-weight: 700; color: Theme.on-accent;
                                                width: parent.width; height: parent.height;
                                                horizontal-alignment: center; vertical-alignment: center; }
                                            go-exp := TouchArea { clicked => { navigate("Explore"); } }
                                        }
                                    }
                                }
                            }
                        }

                        // SEARCH
                        if current-view == "Search": search-page := SmoothFlickable {
                            viewport-width: self.width; viewport-height: search-col.preferred-height;
                            search-col := VerticalLayout {
                                width: min(parent.width, Theme.content-max + 64px);
                                height: self.preferred-height; alignment: start;
                                padding: 32px; padding-top: 24px; spacing: 0px;
                                Rectangle {
                                    height: 40px; clip: true;
                                    search-tabs-scroll := SmoothFlickable {
                                        viewport-width: max(self.width, search-tabs-row.preferred-width);
                                        viewport-height: self.height;
                                        search-tabs-row := HorizontalLayout {
                                    height: 40px; spacing: 8px; alignment: start;
                                    TabPill { label: "All"; active: search-filter == "All"; clicked => { search-filter = "All"; search-category(search-filter); } }
                                    TabPill { label: "Songs"; active: search-filter == "Songs"; clicked => { search-filter = "Songs"; search-category(search-filter); } }
                                    TabPill { label: "Albums"; active: search-filter == "Albums"; clicked => { search-filter = "Albums"; search-category(search-filter); } }
                                    TabPill { label: "Artists"; active: search-filter == "Artists"; clicked => { search-filter = "Artists"; search-category(search-filter); } }
                                    TabPill { label: "Playlists"; active: search-filter == "Playlists"; clicked => { search-filter = "Playlists"; search-category(search-filter); } }
                                        }
                                    }
                                    if search-tabs-scroll.viewport-width > search-tabs-scroll.width: EdgeFade { scroll-x: search-tabs-scroll.viewport-x; fade-width: 16px; }
                                }
                                Rectangle { height: Theme.section-gap; }

                                if search-busy: Rectangle {
                                    height: 64px;
                                    Text { text: "Searching..."; width: parent.width; height: parent.height; font-size: 14px; color: Theme.text-muted; vertical-alignment: center; }
                                }
                                if !search-busy && search-error != "": Rectangle {
                                    min-height: 72px;
                                    Text { text: search-error; width: parent.width; height: parent.height; font-size: 14px; color: Theme.danger; wrap: word-wrap; vertical-alignment: center; }
                                }

                                if search-filter == "All" && search-top.kind != "" && search-top.kind != "Completion": VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    spacing: Theme.heading-gap; padding-bottom: Theme.section-gap;
                                    Text { text: "Top result"; font-size: 18px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 104px; border-radius: Theme.radius-sm;
                                        background: top-res-ta.has-hover ? Theme.glass-hover : Theme.glass;
                                        border-color: Theme.border; border-width: 1px;
                                        HorizontalLayout {
                                            padding: 16px; spacing: 16px;
                                            Rectangle {
                                                width: 72px; height: 72px; border-radius: search-top.kind == "Artist" ? 36px : Theme.radius-sm; clip: true;
                                                background: Theme.art-placeholder;
                                                if search-top.has-thumbnail: Image {
                                                    source: search-top.thumbnail; width: parent.width; height: parent.height; image-fit: cover;
                                                }
                                                if !search-top.has-thumbnail: Image {
                                                    source: search-top.kind == "Artist" ? @image-url("icons/artist.svg")
                                                        : search-top.kind == "Playlist" ? @image-url("icons/queue.svg") : @image-url("icons/album.svg");
                                                    x: 20px; y: 20px; width: 32px; height: 32px; colorize: Theme.text-dim;
                                                }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1; min-width: 0px;
                                                Text { text: search-top.title; y: 10px; width: parent.width; height: 28px; font-size: 20px; font-weight: 700; color: Theme.text; overflow: elide; }
                                                Text {
                                                    text: search-top.kind + (search-top.subtitle != "" ? " \u{2022} " + search-top.subtitle : "");
                                                    y: 42px; width: parent.width; height: 20px; font-size: 13px; color: Theme.text-muted; overflow: elide;
                                                }
                                            }
                                            if search-top.kind == "Song": VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 48px; height: 48px; border-radius: 24px;
                                                    background: top-res-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                                    Image { source: @image-url("icons/play.svg"); width: 20px; height: 20px; colorize: Theme.on-accent; x: 15px; y: 14px; }
                                                }
                                            }
                                        }
                                        top-res-ta := TouchArea {
                                            clicked => { activate-search-entry(search-top); }
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                    if search-top.kind == "Song" {
                                                        open-ctx(search-top.id, search-top.title, search-top.artist, search-top.album, search-top.duration-secs,
                                                            self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                    } else if search-top.kind == "Artist" || search-top.kind == "Album" {
                                                        open-entity-ctx(search-top.kind, search-top.id, search-top.title, search-top.artist,
                                                            self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                if search-filter == "All" && search-detail-busy: Rectangle {
                                    height: 88px;
                                    Text {
                                        text: search-top.kind == "Artist" ? "Loading artist catalogue..."
                                            : search-top.kind == "Album" ? "Loading album tracks..." : "Loading more results...";
                                        width: parent.width; height: parent.height;
                                        font-size: 14px; color: Theme.text-muted; vertical-alignment: center;
                                    }
                                }
                                if search-filter == "All" && !search-busy && search-error == "" && !search-detail-busy && search-detail-error != "": Rectangle {
                                    min-height: 88px;
                                    Text { text: search-detail-error; width: parent.width; height: parent.height; font-size: 14px; color: Theme.danger; wrap: word-wrap; vertical-alignment: center; }
                                }

                                for section in (search-top.kind == "Artist" ? ["Songs", "Albums", "Playlists", "Artists"] : ["Songs", "Artists", "Albums", "Playlists"]): VerticalLayout {
                                height: self.preferred-height; alignment: start; spacing: 0px;
                                if section == "Songs" && search-catalogue-visible && (search-filter == "All" || search-filter == "Songs") && search-results.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    spacing: Theme.heading-gap; padding-bottom: Theme.section-gap;
                                    HorizontalLayout {
                                        height: 32px; alignment: start;
                                        Text {
                                            text: search-filter != "All" || search-detail-error != "" ? "Songs" : search-top.kind == "Artist" ? "Popular songs" : search-top.kind == "Album" ? "Tracks" : "Songs";
                                            font-size: 18px; font-weight: 700; color: Theme.text; vertical-alignment: center;
                                        }
                                    }
                                        VerticalLayout {
                                            spacing: 2px;
                                            for item[i] in search-results: SongRow {
                                        song-title: item.title; song-artist: item.artist;
                                        song-album: item.album; song-duration: item.duration-str;
                                        show-index: search-filter == "All" && search-top.kind == "Album" && !search-detail-busy && search-detail-error == "";
                                        hide-art: self.show-index; hide-artist: false;
                                        show-album-column: !self.show-index && search-page.width >= 820px;
                                        idx-str: "\{i + 1}"; avatar-letter: item.avatar-letter;
                                        thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                        is-current: item.video-id == now-playing-video-id;
                                        play-clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                        queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                        context-requested(px, py) => { open-ctx(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                            }
                                        }
                                }

                                if section == "Artists" && search-catalogue-visible && (search-filter == "All" || search-filter == "Artists") && search-artists.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    spacing: Theme.heading-gap; padding-bottom: Theme.section-gap;
                                    Text { text: search-filter == "All" && search-top.kind == "Artist" && search-detail-error == "" ? "Similar artists" : "Artists"; font-size: 18px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 200px; clip: true;
                                        artist-results-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: artist-results-row.preferred-width + 16px;
                                            artist-results-row := HorizontalLayout {
                                                spacing: 16px;
                                                for art[i] in search-artists: Rectangle {
                                                    width: 160px; height: 190px; border-radius: Theme.radius;
                                                    background: art-ta.has-hover ? Theme.glass-hover : transparent;
                                                    VerticalLayout {
                                                        padding: 12px; spacing: 10px; alignment: center;
                                                        Rectangle {
                                                            width: 120px; height: 120px; border-radius: 60px; clip: true;
                                                            background: Theme.art-placeholder;
                                                            if art.has-thumbnail: Image {
                                                                source: art.thumbnail; width: parent.width; height: parent.height; image-fit: cover;
                                                            }
                                                            if !art.has-thumbnail: Image {
                                                                source: @image-url("icons/artist.svg"); width: 40px; height: 40px; colorize: Theme.text-dim;
                                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                            }
                                                        }
                                                        // No "Artist" caption here — the section heading already says it.
                                                        Text { text: art.name; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; horizontal-alignment: center; }
                                                    }
                                                    art-ta := TouchArea {
                                                        clicked => { navigate-to-artist(art.browse-id); }
                                                        pointer-event(event) => {
                                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                                open-entity-ctx("Artist", art.browse-id, art.name, art.name,
                                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // Edge fades so the row reads as "scrollable" instead of
                                        // looking like a card was clipped by a bug.
                                        EdgeFade { scroll-x: artist-results-fl.viewport-x; }
                                    }
                                }

                                if section == "Albums" && search-catalogue-visible && (search-filter == "Albums" || (search-filter == "All" && (search-top.kind != "Album" || search-detail-error != ""))) && search-albums.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    spacing: Theme.heading-gap; padding-bottom: Theme.section-gap;
                                    Text { text: "Albums"; font-size: 18px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 230px; clip: true;
                                        album-results-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: album-results-row.preferred-width + 16px;
                                            album-results-row := HorizontalLayout {
                                                spacing: 16px;
                                                for alb[i] in search-albums: Rectangle {
                                                    width: 176px; height: 220px; border-radius: Theme.radius;
                                                    background: alb-ta.has-hover ? Theme.glass-hover : transparent;
                                                    VerticalLayout {
                                                        padding: 8px; spacing: 8px;
                                                        Rectangle {
                                                            width: 160px; height: 160px; border-radius: Theme.radius-sm; clip: true;
                                                            background: Theme.art-placeholder;
                                                            if alb.has-thumbnail: Image {
                                                                source: alb.thumbnail; width: parent.width; height: parent.height; image-fit: cover;
                                                            }
                                                            if !alb.has-thumbnail: Image {
                                                                source: @image-url("icons/album.svg"); width: 40px; height: 40px; colorize: Theme.text-dim;
                                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 2px; padding-left: 4px;
                                                            Text { text: alb.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                                                            Text { text: alb.artist; font-size: 12px; color: Theme.text-muted; overflow: elide; }
                                                        }
                                                    }
                                                    alb-ta := TouchArea {
                                                        clicked => { navigate-to-album(alb.browse-id); }
                                                        pointer-event(event) => {
                                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                                open-entity-ctx("Album", alb.browse-id, alb.title, alb.artist,
                                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: album-results-fl.viewport-x; }
                                    }
                                }

                                if section == "Playlists" && (search-filter == "Playlists" || (search-filter == "All" && (search-top.kind != "Album" || (!search-detail-busy && search-detail-error != "")))) && search-playlists.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    spacing: Theme.heading-gap; padding-bottom: Theme.section-gap;
                                    Text { text: search-filter == "All" && search-top.kind == "Artist" ? "Public playlists" : "Playlists"; font-size: 18px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 230px; clip: true;
                                        playlist-results-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: playlist-results-row.preferred-width + 16px;
                                            playlist-results-row := HorizontalLayout {
                                                spacing: 16px;
                                                for playlist in search-playlists: Rectangle {
                                                    width: 176px; height: 220px; border-radius: Theme.radius;
                                                    background: playlist-ta.has-hover ? Theme.glass-hover : transparent;
                                                    VerticalLayout {
                                                        padding: 8px; spacing: 8px;
                                                        Rectangle {
                                                            width: 160px; height: 160px; border-radius: Theme.radius-sm; clip: true;
                                                            background: Theme.art-placeholder;
                                                            if playlist.has-thumbnail: Image {
                                                                source: playlist.thumbnail; width: parent.width; height: parent.height; image-fit: cover;
                                                            }
                                                            if !playlist.has-thumbnail: Image {
                                                                source: @image-url("icons/queue.svg"); width: 40px; height: 40px; colorize: Theme.text-dim;
                                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                            }
                                                        }
                                                        Rectangle {
                                                            height: 36px;
                                                            Text { text: playlist.title; width: parent.width; height: 18px; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                                                            Text { text: playlist.count-text; y: 20px; width: parent.width; height: 16px; font-size: 12px; color: Theme.text-muted; overflow: elide; }
                                                        }
                                                    }
                                                    playlist-ta := TouchArea { clicked => { navigate-to-playlist(playlist.playlist-id); } }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: playlist-results-fl.viewport-x; }
                                    }
                                }
                                }

                                if !search-busy && search-error == "" && !search-has-visible-results
                                    && (search-filter != "All" || (!search-detail-busy && search-detail-error == "")): Rectangle {
                                    height: 200px;
                                    VerticalLayout { alignment: center; spacing: 10px;
                                        Text {
                                            text: search-query == "" ? "Search music" : search-filter == "All" ? "No results found"
                                                : search-filter == "Songs" ? "No songs found" : search-filter == "Artists" ? "No artists found"
                                                : search-filter == "Albums" ? "No albums found" : "No playlists found";
                                            font-size: 18px; color: Theme.text-muted; horizontal-alignment: center;
                                        }
                                        if search-query != "": Text { text: search-query; font-size: 13px; color: Theme.text-dim; horizontal-alignment: center; overflow: elide; }
                                    }
                                }
                            }
                        }

                        // ARTIST
                        if !is-loading && current-view == "Artist": SmoothFlickable {
                            viewport-width: self.width; viewport-height: artist-col.preferred-height;
                            artist-col := VerticalLayout {
                                width: parent.width; height: self.preferred-height; alignment: start;
                                spacing: 0px; padding-bottom: Theme.section-gap;
                                Rectangle {
                                    height: 280px;
                                    // Fade the tinted banner INTO the page background so there is no
                                    // hard horizontal seam where the hero ends.
                                    background: @linear-gradient(180deg,
                                        Theme.accent.mix(Theme.bg, 0.34) 0%,
                                        Theme.accent.mix(Theme.bg, 0.14) 58%,
                                        Theme.bg 100%);
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 32px; padding-right: 32px;
                                        padding-top: 32px; padding-bottom: 32px; spacing: 24px;
                                        // Wrapped so the avatar centers against the text block instead
                                        // of top-aligning (it previously sat ~10px above the metadata).
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 180px; height: 180px; border-radius: 90px; clip: true;
                                                background: Theme.art-placeholder;
                                                if artist-view-has-thumbnail: Image {
                                                    source: artist-view-thumbnail;
                                                    width: parent.width; height: parent.height; image-fit: cover;
                                                }
                                                if !artist-view-has-thumbnail: Image {
                                                    source: @image-url("icons/artist.svg"); width: 60px; height: 60px; colorize: Theme.text-dim;
                                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center; spacing: 6px; horizontal-stretch: 1;
                                            // Eyebrow label, matching the Album and Playlist heroes.
                                            Text { text: "ARTIST"; font-size: 11px; font-weight: 700; color: Theme.accent; letter-spacing: 0.8px; }
                                            Text {
                                                text: artist-view-name;
                                                font-size: 40px; font-weight: 800; color: Theme.text;
                                                overflow: elide;
                                            }
                                            if artist-view-songs.length > 0: Text {
                                                text: "\{artist-view-songs.length} popular tracks";
                                                font-size: 13px; color: Theme.text-muted;
                                            }
                                            Rectangle { height: 12px; }
                                            HorizontalLayout {
                                                spacing: 12px; alignment: start;
                                                // Play — the primary action. It was missing entirely before,
                                                // leaving "Follow" as the most prominent control on an artist page.
                                                if artist-view-songs.length > 0: Rectangle {
                                                    width: 104px; height: 40px; border-radius: 20px;
                                                    background: artist-play-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                                    HorizontalLayout {
                                                        alignment: center; spacing: 8px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image { source: @image-url("icons/play.svg"); width: 16px; height: 16px; colorize: Theme.on-accent; }
                                                        }
                                                        Text {
                                                            text: "Play"; font-size: 14px; font-weight: 700;
                                                            color: Theme.on-accent; vertical-alignment: center;
                                                        }
                                                    }
                                                    artist-play-ta := TouchArea {
                                                        clicked => {
                                                            play-song(artist-view-songs[0].video-id, artist-view-songs[0].title,
                                                                      artist-view-songs[0].artist, artist-view-songs[0].duration-secs);
                                                        }
                                                    }
                                                }
                                                // Follow/Subscribe button
                                                Rectangle {
                                                    width: artist-view-subscribed ? 130px : 110px; height: 40px; border-radius: 20px;
                                                    background: artist-follow-ta.has-hover ? Theme.glass-hover : Theme.glass;
                                                    border-color: artist-view-subscribed ? Theme.accent : Theme.border; border-width: 1px;
                                                    HorizontalLayout {
                                                        alignment: center; spacing: 6px;
                                                        // Wrap the icon so it is vertically centered against the
                                                        // taller text box (a fixed-height Image in a HorizontalLayout
                                                        // otherwise top-aligns, making the heart sit too high).
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                source: artist-view-subscribed ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                                                                width: 16px; height: 16px;
                                                                colorize: artist-view-subscribed ? Theme.accent : Theme.text-muted;
                                                            }
                                                        }
                                                        Text {
                                                            text: artist-view-subscribed ? "Following" : "Follow";
                                                            font-size: 13px; font-weight: 600;
                                                            color: artist-view-subscribed ? Theme.accent : Theme.text;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    artist-follow-ta := TouchArea { clicked => { toggle-subscribe-artist(); } }
                                                }
                                                // Artist radio button
                                                Rectangle {
                                                    width: 134px; height: 40px; border-radius: 20px;
                                                    background: artist-radio-ta.has-hover ? Theme.glass-hover : Theme.glass;
                                                    border-color: Theme.border; border-width: 1px;
                                                    HorizontalLayout {
                                                        alignment: center; spacing: 6px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image { source: @image-url("icons/radio.svg"); width: 16px; height: 16px; colorize: Theme.text-muted; }
                                                        }
                                                        Text {
                                                            text: "Artist radio"; font-size: 13px; font-weight: 600;
                                                            color: Theme.text; vertical-alignment: center;
                                                        }
                                                    }
                                                    artist-radio-ta := TouchArea { clicked => { start-artist-radio("", artist-view-name); } }
                                                }
                                            }
                                        }
                                    }
                                }
                                // Latest Release highlight
                                if artist-view-has-latest: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "Latest Release"; font-size: 22px; font-weight: 700; color: Theme.text; }
                                    HorizontalLayout {
                                    Rectangle {
                                        // Constrained: a single card stretched across a 1900px window
                                        // read as an unfinished layout. `max-width` alone is not enough
                                        // here — a trailing spacer is what actually holds the cap.
                                        height: 100px; border-radius: Theme.radius;
                                        horizontal-stretch: 1; max-width: 560px;
                                        background: latest-ta.has-hover ? Theme.glass-hover : Theme.glass;
                                        border-color: Theme.border; border-width: 1px;
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding: 12px; spacing: 16px;
                                            Rectangle {
                                                width: 76px; height: 76px; border-radius: Theme.radius-sm; clip: true;
                                                background: Theme.art-placeholder;
                                                if artist-view-latest-release.has-thumbnail: Image {
                                                    source: artist-view-latest-release.thumbnail;
                                                    width: parent.width; height: parent.height; image-fit: cover;
                                                }
                                                if !artist-view-latest-release.has-thumbnail: Image {
                                                    source: @image-url("icons/album.svg"); width: 28px; height: 28px; colorize: Theme.text-dim;
                                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; spacing: 4px; horizontal-stretch: 1;
                                                HorizontalLayout {
                                                    spacing: 8px; alignment: start;
                                                    Rectangle {
                                                        width: 82px; height: 20px; border-radius: 4px;
                                                        // Accent-tinted, not red — red is reserved for
                                                        // destructive actions like "Clear Cache".
                                                        background: Theme.accent-soft;
                                                        border-color: Theme.accent; border-width: 1px;
                                                        Text {
                                                            text: "New Release"; font-size: 10px; font-weight: 700;
                                                            color: Theme.accent; horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    Text {
                                                        text: artist-view-latest-release.year;
                                                        font-size: 12px; color: Theme.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Text {
                                                    text: artist-view-latest-release.title;
                                                    font-size: 16px; font-weight: 600; color: Theme.text;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: artist-view-latest-release.artist;
                                                    font-size: 13px; color: Theme.text-muted;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                        latest-ta := TouchArea {
                                            clicked => { navigate-to-album(artist-view-latest-release.browse-id); }
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                    open-entity-ctx("Album", artist-view-latest-release.browse-id, artist-view-latest-release.title, artist-view-latest-release.artist,
                                                        self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                                VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    max-width: Theme.content-max;
                                    Text { text: "Popular"; font-size: 22px; font-weight: 700; color: Theme.text; }
                                    HorizontalLayout {
                                        height: self.preferred-height;
                                        VerticalLayout {
                                            height: self.preferred-height; alignment: start; spacing: 2px;
                                            horizontal-stretch: 1; max-width: Theme.content-max;
                                            for item[i] in artist-view-songs: SongRow {
                                        song-title: item.title; song-artist: item.artist;
                                        song-album: item.album; song-duration: item.duration-str;
                                        // Ranked list: number the rows and drop the repeated artist name.
                                        show-index: true; hide-artist: true; show-album-column: true;
                                        idx-str: "\{i + 1}"; avatar-letter: item.avatar-letter;
                                        thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                        is-current: item.video-id == now-playing-video-id;
                                        play-clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                        queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                        context-requested(px, py) => { open-ctx(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                                if artist-view-albums.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "Discography"; font-size: 22px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 230px; clip: true;
                                        disco-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: disco-row.preferred-width + 16px;
                                            disco-row := HorizontalLayout {
                                                spacing: 16px;
                                                for album[i] in artist-view-albums: Rectangle {
                                                    width: 176px; height: 220px; border-radius: Theme.radius;
                                                    background: album-card-ta.has-hover ? Theme.glass-hover : transparent;
                                                    VerticalLayout {
                                                        padding: 8px; spacing: 8px;
                                                        Rectangle {
                                                            width: 160px; height: 160px; border-radius: Theme.radius-sm; clip: true;
                                                            background: Theme.art-placeholder;
                                                            if album.has-thumbnail: Image {
                                                                source: album.thumbnail;
                                                                width: parent.width; height: parent.height; image-fit: cover;
                                                            }
                                                            if !album.has-thumbnail: Image {
                                                                source: @image-url("icons/album.svg"); width: 40px; height: 40px; colorize: Theme.text-dim;
                                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 2px; padding-left: 4px;
                                                            Text { text: album.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                                                            Text { text: album.year; font-size: 12px; color: Theme.text-muted; }
                                                        }
                                                    }
                                                    album-card-ta := TouchArea {
                                                        clicked => { navigate-to-album(album.browse-id); }
                                                        pointer-event(event) => {
                                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                                open-entity-ctx("Album", album.browse-id, album.title, album.artist,
                                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: disco-fl.viewport-x; }
                                    }
                                }
                                // Singles & EPs
                                if artist-view-singles.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "Singles & EPs"; font-size: 22px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 230px; clip: true;
                                        singles-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: singles-row.preferred-width + 16px;
                                            singles-row := HorizontalLayout {
                                                spacing: 16px;
                                                for single[i] in artist-view-singles: Rectangle {
                                                    width: 176px; height: 220px; border-radius: Theme.radius;
                                                    background: single-card-ta.has-hover ? Theme.glass-hover : transparent;
                                                    VerticalLayout {
                                                        padding: 8px; spacing: 8px;
                                                        Rectangle {
                                                            width: 160px; height: 160px; border-radius: Theme.radius-sm; clip: true;
                                                            background: Theme.art-placeholder;
                                                            if single.has-thumbnail: Image {
                                                                source: single.thumbnail;
                                                                width: parent.width; height: parent.height; image-fit: cover;
                                                            }
                                                            if !single.has-thumbnail: Image {
                                                                source: @image-url("icons/album.svg"); width: 40px; height: 40px; colorize: Theme.text-dim;
                                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 2px; padding-left: 4px;
                                                            Text { text: single.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                                                            Text { text: single.year; font-size: 12px; color: Theme.text-muted; }
                                                        }
                                                    }
                                                    single-card-ta := TouchArea {
                                                        clicked => { navigate-to-album(single.browse-id); }
                                                        pointer-event(event) => {
                                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                                open-entity-ctx("Album", single.browse-id, single.title, single.artist,
                                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: singles-fl.viewport-x; }
                                    }
                                }
                                // Videos
                                if artist-view-videos.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "Videos"; font-size: 22px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 210px; clip: true;
                                        videos-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: videos-row.preferred-width + 16px;
                                            videos-row := HorizontalLayout {
                                                spacing: 16px;
                                                for vid[i] in artist-view-videos: Rectangle {
                                                    width: 200px; height: 200px; border-radius: Theme.radius;
                                                    background: vid-card-ta.has-hover ? Theme.glass-hover : transparent;
                                                    VerticalLayout {
                                                        padding: 8px; spacing: 8px;
                                                        Rectangle {
                                                            width: 184px; height: 104px; border-radius: Theme.radius-sm; clip: true;
                                                            background: Theme.art-placeholder;
                                                            if vid.has-thumbnail: Image {
                                                                source: vid.thumbnail;
                                                                width: parent.width; height: parent.height; image-fit: cover;
                                                            }
                                                            if !vid.has-thumbnail: Text {
                                                                text: "♪"; font-size: 36px; color: Theme.text-dim;
                                                                width: parent.width; height: parent.height;
                                                                horizontal-alignment: center; vertical-alignment: center;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 2px; padding-left: 4px;
                                                            Text { text: vid.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                                                            Text { text: vid.duration-str; font-size: 12px; color: Theme.text-muted; }
                                                        }
                                                    }
                                                    vid-card-ta := TouchArea { clicked => {
                                                        play-song(vid.video-id, vid.title, vid.artist, vid.duration-secs);
                                                    } }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: videos-fl.viewport-x; }
                                    }
                                }
                                // Fans also like
                                if artist-view-related.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "Fans also like"; font-size: 22px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 220px; clip: true;
                                        SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: related-row.preferred-width + 16px;
                                            related-row := HorizontalLayout {
                                                spacing: 16px;
                                                for ra[i] in artist-view-related: Rectangle {
                                                    width: 160px; height: 210px; border-radius: 8px;
                                                    background: ra-card-ta.has-hover ? Theme.glass-hover : transparent;
                                                    VerticalLayout {
                                                        padding: 8px; spacing: 8px;
                                                        Rectangle {
                                                            width: 120px; height: 120px; border-radius: 60px; clip: true;
                                                            background: Theme.art-placeholder;
                                                            if ra.has-thumbnail: Image {
                                                                source: ra.thumbnail;
                                                                width: parent.width; height: parent.height; image-fit: cover;
                                                            }
                                                            if !ra.has-thumbnail: Text {
                                                                text: "♪"; font-size: 36px; color: Theme.text-dim;
                                                                horizontal-alignment: center; vertical-alignment: center;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 2px;
                                                            Text { text: ra.name; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; horizontal-alignment: center; }
                                                            Text { text: ra.subscriber-count; font-size: 11px; color: Theme.text-muted; horizontal-alignment: center; }
                                                        }
                                                    }
                                                    ra-card-ta := TouchArea {
                                                        clicked => { navigate-to-artist(ra.browse-id); }
                                                        pointer-event(event) => {
                                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                                open-entity-ctx("Artist", ra.browse-id, ra.name, ra.name,
                                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                // About the artist
                                if artist-view-description != "": VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "About"; font-size: 22px; font-weight: 700; color: Theme.text; }
                                    HorizontalLayout {
                                        Rectangle {
                                            // Capped: a bio running the full width of an ultrawide window
                                            // is well past a comfortable reading measure.
                                            horizontal-stretch: 1; max-width: 860px;
                                            border-radius: Theme.radius; background: Theme.glass;
                                            border-color: Theme.border; border-width: 1px;
                                            VerticalLayout {
                                                padding: 20px; spacing: 8px;
                                                Text {
                                                    text: artist-view-description;
                                                    font-size: 14px; color: Theme.text-muted;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }

                        // ALBUM
                        if !is-loading && current-view == "Album": SmoothFlickable {
                            viewport-width: self.width; viewport-height: album-col.preferred-height;
                            album-col := VerticalLayout {
                                width: parent.width; height: self.preferred-height; alignment: start;
                                spacing: 0px; padding-bottom: Theme.section-gap;
                                Rectangle {
                                    height: 280px;
                                    background: @linear-gradient(180deg,
                                        Theme.accent.mix(Theme.bg, 0.34) 0%,
                                        Theme.accent.mix(Theme.bg, 0.14) 58%,
                                        Theme.bg 100%);
                                    clip: true;
                                    HorizontalLayout {
                                        padding: 32px; padding-top: 48px; spacing: 24px;
                                        Rectangle {
                                            width: 180px; height: 180px; border-radius: Theme.radius-sm; clip: true;
                                            background: Theme.art-placeholder;
                                            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
                                            if album-view-has-thumbnail: Image {
                                                source: album-view-thumbnail;
                                                width: parent.width; height: parent.height; image-fit: cover;
                                            }
                                            if !album-view-has-thumbnail: Image {
                                                source: @image-url("icons/album.svg"); width: 60px; height: 60px; colorize: Theme.text-dim;
                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center; spacing: 6px; horizontal-stretch: 1;
                                            Text { text: "ALBUM"; font-size: 11px; font-weight: 700; color: Theme.accent; letter-spacing: 0.8px; }
                                            Text { text: album-view-title; font-size: 28px; font-weight: 800; color: Theme.text; overflow: elide; }
                                            HorizontalLayout {
                                                spacing: 8px; alignment: start;
                                                Text { text: album-view-artist; font-size: 14px; font-weight: 600; color: Theme.text; }
                                                if album-view-year != "": Text { text: "•"; font-size: 14px; color: Theme.text-dim; }
                                                if album-view-year != "": Text { text: album-view-year; font-size: 14px; color: Theme.text-muted; }
                                            }
                                            Text {
                                                text: album-view-duration != "" ? "\{album-view-songs.length} songs • " + album-view-duration : "\{album-view-songs.length} songs";
                                                font-size: 13px; color: Theme.text-muted;
                                            }
                                            Rectangle { height: 12px; }
                                            HorizontalLayout {
                                                spacing: 12px; alignment: start;
                                                Rectangle {
                                                    width: 120px; height: 44px; border-radius: 22px;
                                                    background: album-play-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                                    HorizontalLayout {
                                                        alignment: center; spacing: 8px;
                                                        VerticalLayout { alignment: center; Image { source: @image-url("icons/play.svg"); width: 20px; height: 20px; colorize: Theme.on-accent; } }
                                                        Text { text: "Play"; font-size: 15px; font-weight: 700; color: Theme.on-accent; vertical-alignment: center; }
                                                    }
                                                    album-play-ta := TouchArea { clicked => { play-album(); } }
                                                }
                                                // Shuffle button
                                                Rectangle {
                                                    width: 118px; height: 44px; border-radius: 22px;
                                                    background: album-shuf-ta.has-hover ? Theme.glass-hover : Theme.glass;
                                                    border-color: Theme.border; border-width: 1px;
                                                    HorizontalLayout {
                                                        alignment: center; spacing: 8px;
                                                        VerticalLayout { alignment: center; Image { source: @image-url("icons/shuffle.svg"); width: 16px; height: 16px; colorize: Theme.text-muted; } }
                                                        Text { text: "Shuffle"; font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                                    }
                                                    album-shuf-ta := TouchArea { clicked => { shuffle-album(); } }
                                                }
                                                // Like album button
                                                Rectangle {
                                                    width: 44px; height: 44px; border-radius: 22px;
                                                    background: album-like-ta.has-hover ? Theme.hover-veil : transparent;
                                                    Image {
                                                        source: album-view-liked ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                                                        width: album-view-liked ? 22px : 20px;
                                                        height: album-view-liked ? 22px : 20px;
                                                        colorize: album-view-liked ? Theme.accent : Theme.text-muted;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        animate colorize { duration: 200ms; }
                                                        animate width, height { duration: 150ms; easing: ease-out-back; }
                                                    }
                                                    album-like-ta := TouchArea { clicked => { toggle-like-album(); } }
                                                }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    height: self.preferred-height;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap;
                                    VerticalLayout {
                                        height: self.preferred-height; alignment: start; spacing: 2px;
                                        horizontal-stretch: 1; max-width: Theme.content-max;
                                        for item[i] in album-view-songs: SongRow {
                                        song-title: item.title; song-artist: item.artist;
                                        song-album: ""; song-duration: item.duration-str;
                                        // Real track numbers, no artwork repeat, no artist repeated 15x.
                                        show-index: true; hide-art: true; hide-artist: true;
                                        idx-str: "\{i + 1}"; avatar-letter: item.avatar-letter;
                                        thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                        is-current: item.video-id == now-playing-video-id;
                                        play-clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                        queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                        context-requested(px, py) => { open-ctx(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                        }
                                    }
                                    // Absorbs the leftover width so the list stops at content-max
                                    // instead of stretching the duration column to the window edge.
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // Album description
                                if album-view-description != "": VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "About this album"; font-size: 18px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        border-radius: Theme.radius; background: Theme.glass;
                                        border-color: Theme.border; border-width: 1px;
                                        VerticalLayout {
                                            padding: 16px; spacing: 8px;
                                            Text { text: album-view-description; font-size: 13px; color: Theme.text-muted; wrap: word-wrap; }
                                        }
                                    }
                                }
                                // More by this artist
                                if album-view-more-by-artist.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "More by " + album-view-artist; font-size: 22px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 230px; clip: true;
                                        more-artist-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: more-artist-row.preferred-width + 16px;
                                            more-artist-row := HorizontalLayout {
                                                spacing: 16px;
                                                for album[i] in album-view-more-by-artist: Rectangle {
                                                    width: 176px; height: 220px; border-radius: 8px;
                                                    background: more-card-ta.has-hover ? Theme.glass-hover : transparent;
                                                    VerticalLayout {
                                                        padding: 8px; spacing: 8px;
                                                        Rectangle {
                                                            width: 160px; height: 160px; border-radius: 8px; clip: true;
                                                            background: #1a1a1a;
                                                            if album.has-thumbnail: Image {
                                                                source: album.thumbnail;
                                                                width: parent.width; height: parent.height; image-fit: cover;
                                                            }
                                                            if !album.has-thumbnail: Text {
                                                                text: "\u{1f4bf}"; font-size: 40px;
                                                                horizontal-alignment: center; vertical-alignment: center;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 2px; padding-left: 4px;
                                                            Text { text: album.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                                                            Text { text: album.year; font-size: 12px; color: Theme.text-muted; }
                                                        }
                                                    }
                                                    more-card-ta := TouchArea {
                                                        clicked => { navigate-to-album(album.browse-id); }
                                                        pointer-event(event) => {
                                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                                open-entity-ctx("Album", album.browse-id, album.title, album.artist,
                                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: more-artist-fl.viewport-x; }
                                    }
                                }
                                // You might also like
                                if album-view-similar.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "You might also like"; font-size: 22px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 230px; clip: true;
                                        similar-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: similar-row.preferred-width + 16px;
                                            similar-row := HorizontalLayout {
                                                spacing: 16px;
                                                for album[i] in album-view-similar: Rectangle {
                                                    width: 176px; height: 220px; border-radius: 8px;
                                                    background: similar-card-ta.has-hover ? Theme.glass-hover : transparent;
                                                    VerticalLayout {
                                                        padding: 8px; spacing: 8px;
                                                        Rectangle {
                                                            width: 160px; height: 160px; border-radius: 8px; clip: true;
                                                            background: #1a1a1a;
                                                            if album.has-thumbnail: Image {
                                                                source: album.thumbnail;
                                                                width: parent.width; height: parent.height; image-fit: cover;
                                                            }
                                                            if !album.has-thumbnail: Text {
                                                                text: "\u{1f4bf}"; font-size: 40px;
                                                                horizontal-alignment: center; vertical-alignment: center;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 2px; padding-left: 4px;
                                                            Text { text: album.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                                                            Text { text: album.year; font-size: 12px; color: Theme.text-muted; }
                                                        }
                                                    }
                                                    similar-card-ta := TouchArea {
                                                        clicked => { navigate-to-album(album.browse-id); }
                                                        pointer-event(event) => {
                                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                                open-entity-ctx("Album", album.browse-id, album.title, album.artist,
                                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: similar-fl.viewport-x; }
                                    }
                                }
                            }
                        }

                        // RADIO
                        if !is-loading && current-view == "Radio": SmoothFlickable {
                            viewport-width: self.width; viewport-height: radio-col.preferred-height;
                            radio-col := VerticalLayout {
                                width: parent.width; height: self.preferred-height; alignment: start;
                                padding: 0px; padding-bottom: Theme.section-gap;
                                // Hero banner
                                Rectangle {
                                    height: 200px;
                                    background: @linear-gradient(180deg,
                                        Theme.accent.mix(Theme.bg, 0.34) 0%,
                                        Theme.accent.mix(Theme.bg, 0.14) 58%,
                                        Theme.bg 100%);
                                    VerticalLayout {
                                        padding-left: 32px; padding-top: 40px; spacing: 12px;
                                        Text { text: radio-title; font-size: 28px; font-weight: 700; color: Theme.text; }
                                        Text { text: radio-songs.length == 0 ? "" : "\{radio-songs.length} songs"; font-size: 14px; color: Theme.text-muted; }
                                        Rectangle { height: 12px; }
                                        Rectangle {
                                            width: 120px; height: 44px; border-radius: 22px;
                                            background: radio-play-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                            HorizontalLayout {
                                                alignment: center; spacing: 8px;
                                                VerticalLayout { alignment: center; Image { source: @image-url("icons/play.svg"); width: 20px; height: 20px; colorize: Theme.on-accent; } }
                                                Text { text: "Play"; font-size: 15px; font-weight: 700; color: Theme.on-accent; vertical-alignment: center; }
                                            }
                                            radio-play-ta := TouchArea { clicked => { play-radio(); } }
                                        }
                                    }
                                }
                                // Song list
                                VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 16px; padding-right: 16px; padding-top: Theme.section-gap; spacing: 2px;
                                    for item[i] in radio-songs: SongRow {
                                        song-title: item.title; song-artist: item.artist;
                                        song-album: ""; song-duration: item.duration-str;
                                        idx-str: "\{i + 1}"; avatar-letter: item.avatar-letter;
                                        thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                        is-current: item.video-id == now-playing-video-id;
                                        play-clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                        queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                        context-requested(px, py) => { open-ctx(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                    }
                                }
                            }
                        }

                        // PLAYLIST
                        if !is-loading && current-view == "Playlist": SmoothFlickable {
                            viewport-width: self.width; viewport-height: playlist-col.preferred-height;
                            playlist-col := VerticalLayout {
                                width: parent.width; height: self.preferred-height; alignment: start;
                                spacing: 0px; padding-bottom: Theme.section-gap;
                                // Hero banner
                                Rectangle {
                                    height: 280px;
                                    background: @linear-gradient(180deg,
                                        Theme.accent.mix(Theme.bg, 0.34) 0%,
                                        Theme.accent.mix(Theme.bg, 0.14) 58%,
                                        Theme.bg 100%);
                                    clip: true;
                                    HorizontalLayout {
                                        padding: 32px; padding-top: 48px; spacing: 24px;
                                        // Thumbnail
                                        Rectangle {
                                            width: 180px; height: 180px; border-radius: Theme.radius-sm; clip: true;
                                            background: Theme.art-placeholder;
                                            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
                                            if playlist-view-has-thumbnail: Image {
                                                source: playlist-view-thumbnail;
                                                width: parent.width; height: parent.height; image-fit: cover;
                                            }
                                            if !playlist-view-has-thumbnail: Image {
                                                source: @image-url("icons/library.svg"); width: 56px; height: 56px; colorize: Theme.text-dim;
                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                            }
                                        }
                                        // Metadata
                                        VerticalLayout {
                                            alignment: center; spacing: 6px; horizontal-stretch: 1;
                                            Text { text: "PLAYLIST"; font-size: 11px; font-weight: 700; color: Theme.accent; letter-spacing: 0.8px; }
                                            Text { text: playlist-view-title; font-size: 28px; font-weight: 800; color: Theme.text; overflow: elide; }
                                            Text { text: playlist-view-count + " songs" + (playlist-view-duration != "" ? "  \u{2022}  " + playlist-view-duration : ""); font-size: 13px; color: Theme.text-muted; }
                                            Rectangle { height: 12px; }
                                            HorizontalLayout {
                                                spacing: 12px; alignment: start;
                                                // Play button
                                                Rectangle {
                                                    width: 120px; height: 44px; border-radius: 22px;
                                                    background: playlist-play-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                                    HorizontalLayout {
                                                        alignment: center; spacing: 8px;
                                                        VerticalLayout { alignment: center; Image { source: @image-url("icons/play.svg"); width: 20px; height: 20px; colorize: Theme.on-accent; } }
                                                        Text { text: "Play"; font-size: 15px; font-weight: 700; color: Theme.on-accent; vertical-alignment: center; }
                                                    }
                                                    playlist-play-ta := TouchArea { clicked => { play-playlist(); } }
                                                }
                                                // Shuffle button
                                                Rectangle {
                                                    width: 118px; height: 44px; border-radius: 22px;
                                                    background: pl-shuf-ta.has-hover ? Theme.glass-hover : Theme.glass;
                                                    border-color: Theme.border; border-width: 1px;
                                                    HorizontalLayout {
                                                        alignment: center; spacing: 8px;
                                                        VerticalLayout { alignment: center; Image { source: @image-url("icons/shuffle.svg"); width: 16px; height: 16px; colorize: Theme.text-muted; } }
                                                        Text { text: "Shuffle"; font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                                    }
                                                    pl-shuf-ta := TouchArea { clicked => { shuffle-playlist(); } }
                                                }
                                                // Save playlist button (remote playlists only)
                                                if !playlist-view-is-local: Rectangle {
                                                    width: 44px; height: 44px; border-radius: 22px;
                                                    background: pl-like-ta.has-hover ? Theme.hover-veil : transparent;
                                                    Image {
                                                        source: playlist-view-liked ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                                                        width: playlist-view-liked ? 22px : 20px;
                                                        height: playlist-view-liked ? 22px : 20px;
                                                        colorize: playlist-view-liked ? Theme.accent : Theme.text-muted;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        animate colorize { duration: 200ms; }
                                                        animate width, height { duration: 150ms; easing: ease-out-back; }
                                                    }
                                                    pl-like-ta := TouchArea { clicked => { toggle-like-playlist(); } }
                                                }
                                                // Delete button (local playlists only)
                                                if playlist-view-is-local: Rectangle {
                                                    width: 92px; height: 44px; border-radius: 22px;
                                                    background: pl-del-ta.has-hover ? Theme.danger-bg : Theme.glass;
                                                    border-color: pl-del-ta.has-hover ? Theme.danger : Theme.border; border-width: 1px;
                                                    Text { text: "Delete"; color: pl-del-ta.has-hover ? Theme.on-danger : Theme.text-muted; font-size: 13px; font-weight: 600;
                                                        width: parent.width; height: parent.height;
                                                        horizontal-alignment: center; vertical-alignment: center; }
                                                    pl-del-ta := TouchArea { clicked => { delete-local-playlist(playlist-view-id); } }
                                                }
                                            }
                                        }
                                    }
                                }
                                // Song list
                                HorizontalLayout {
                                    height: self.preferred-height;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap;
                                    VerticalLayout {
                                        height: self.preferred-height; alignment: start; spacing: 2px;
                                        horizontal-stretch: 1; max-width: Theme.content-max;
                                        for item[i] in playlist-view-songs: SongRow {
                                        song-title: item.title; song-artist: item.artist;
                                        song-album: item.album; song-duration: item.duration-str;
                                        show-album-column: true;
                                        idx-str: "\{i + 1}"; avatar-letter: item.avatar-letter;
                                        thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                        is-current: item.video-id == now-playing-video-id;
                                        play-clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                        queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                        context-requested(px, py) => { open-ctx-playlist(item.video-id, item.title, item.artist, item.album, item.duration-secs, playlist-view-is-local ? playlist-view-id : "", px, py); }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // Similar playlists
                                if playlist-view-similar.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-left: 32px; padding-right: 32px; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "Similar playlists"; font-size: 22px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 230px; clip: true;
                                        similar-pl-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: similar-pl-row.preferred-width + 16px;
                                            similar-pl-row := HorizontalLayout {
                                                spacing: 16px;
                                                for pl[i] in playlist-view-similar: Rectangle {
                                                    width: 176px; height: 220px; border-radius: 8px;
                                                    background: similar-pl-ta.has-hover ? Theme.glass-hover : transparent;
                                                    VerticalLayout {
                                                        padding: 8px; spacing: 8px;
                                                        Rectangle {
                                                            width: 160px; height: 160px; border-radius: 8px; clip: true;
                                                            background: #1a1a1a;
                                                            if pl.has-thumbnail: Image {
                                                                source: pl.thumbnail;
                                                                width: parent.width; height: parent.height; image-fit: cover;
                                                            }
                                                            if !pl.has-thumbnail: Text {
                                                                text: "\u{1f3b6}"; font-size: 40px;
                                                                horizontal-alignment: center; vertical-alignment: center;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 2px; padding-left: 4px;
                                                            Text { text: pl.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                                                            Text { text: pl.count-text; font-size: 12px; color: Theme.text-muted; }
                                                        }
                                                    }
                                                    similar-pl-ta := TouchArea { clicked => { navigate-to-playlist(pl.playlist-id); } }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: similar-pl-fl.viewport-x; }
                                    }
                                }
                            }
                        }

                        // EXPLORE
                        if !is-loading && current-view == "Explore": SmoothFlickable {
                            viewport-width: self.width; viewport-height: explore-col.preferred-height;
                            explore-col := VerticalLayout {
                                width: parent.width; height: self.preferred-height; alignment: start;
                                padding: 32px; spacing: 0px;
                                VerticalLayout { height: self.preferred-height; alignment: start; spacing: Theme.heading-gap;
                                Text { text: "Explore"; font-size: 28px; font-weight: 700; color: Theme.text; }
                                Text { text: "Pick a vibe — we'll build your queue"; font-size: 14px; color: Theme.text-muted; }
                                }

                                // ── Moods & Genres (dynamic from API) ──
                                // Rendered as a 4-up grid. Previously each mood was a
                                // full-width 52px bar holding a 36px icon and a short label,
                                // leaving ~85% of every row empty on a wide window.
                                if explore-moods.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "Moods & Genres"; font-size: 18px; font-weight: 600; color: Theme.text; }
                                    mood-grid := Rectangle {
                                        property <int> cols: 4;
                                        property <length> gap: 14px;
                                        property <length> tile-w: (self.width - (self.cols - 1) * self.gap) / self.cols;
                                        property <length> tile-h: 76px;
                                        property <int> rows: Math.ceil((explore-moods.length + 0.0) / self.cols);
                                        height: self.rows * (self.tile-h + self.gap) - self.gap;
                                        for mood[i] in explore-moods: Rectangle {
                                            x: Math.mod(i, mood-grid.cols) * (mood-grid.tile-w + mood-grid.gap);
                                            y: Math.floor(i / mood-grid.cols) * (mood-grid.tile-h + mood-grid.gap);
                                            width: mood-grid.tile-w; height: mood-grid.tile-h;
                                            border-radius: Theme.radius;
                                            background: mood-ta.has-hover ? Theme.glass-hover : Theme.glass;
                                            border-color: Theme.border; border-width: 1px;
                                            HorizontalLayout {
                                                padding-left: 14px; padding-right: 14px; spacing: 12px;
                                                Rectangle {
                                                    width: 40px; height: 40px; border-radius: 10px;
                                                    y: (parent.height - self.height) / 2;
                                                    // Deterministic hue per tile keeps them distinguishable
                                                    // without needing artwork from the API.
                                                    background: @linear-gradient(135deg,
                                                        Colors.hsv(Math.mod(i * 37, 360), 0.52, 0.68) 0%,
                                                        Colors.hsv(Math.mod(i * 37, 360), 0.60, 0.44) 100%);
                                                    Text {
                                                        text: "♪";
                                                        font-size: 17px; color: Theme.on-accent;
                                                        width: parent.width; height: parent.height;
                                                        horizontal-alignment: center; vertical-alignment: center;
                                                    }
                                                }
                                                Text {
                                                    text: mood.title;
                                                    font-size: 14px; font-weight: 600; color: Theme.text;
                                                    vertical-alignment: center; horizontal-stretch: 1;
                                                    wrap: word-wrap; overflow: elide;
                                                }
                                            }
                                            mood-ta := TouchArea { clicked => { explore-mood(mood.params); } }
                                        }
                                    }
                                }

                                // ── Quick Genres ──
                                VerticalLayout { height: self.preferred-height; alignment: start; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                Text { text: "Quick Genres"; font-size: 18px; font-weight: 600; color: Theme.text; }
                                GridLayout {
                                    spacing: 14px;
                                    Row {
                                        GenreTile { label: "Pop";          icon: "🎵"; tile-color: #5020a0; clicked => { explore-genre("pop music hits"); } }
                                        GenreTile { label: "Hip-Hop";      icon: "🎤"; tile-color: #8a2020; clicked => { explore-genre("hip hop rap"); } }
                                    }
                                    Row {
                                        GenreTile { label: "Electronic";   icon: "⚡"; tile-color: #1a4070; clicked => { explore-genre("electronic edm dance"); } }
                                        GenreTile { label: "Rock";         icon: "🎸"; tile-color: #2a3050; clicked => { explore-genre("rock music"); } }
                                    }
                                    Row {
                                        GenreTile { label: "Bollywood";    icon: "🎭"; tile-color: #7a3010; clicked => { explore-genre("bollywood hindi songs"); } }
                                        GenreTile { label: "Lofi Chill";   icon: "🌙"; tile-color: #0a2a2a; clicked => { explore-genre("lofi chill study beats"); } }
                                    }
                                    Row {
                                        GenreTile { label: "Classical";    icon: "🎻"; tile-color: #1a2a10; clicked => { explore-genre("classical orchestral piano"); } }
                                        GenreTile { label: "K-Pop";        icon: "✨"; tile-color: #401a50; clicked => { explore-genre("kpop korean pop"); } }
                                    }
                                }
                                }

                                // ── New Releases ──
                                if explore-new-releases.length > 0: VerticalLayout {
                                    height: self.preferred-height; alignment: start;
                                    padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                    Text { text: "New Releases"; font-size: 18px; font-weight: 600; color: Theme.text; }
                                    // Clipping wrapper so the fade overlays the row; as a plain
                                    // layout sibling it collapsed to zero height and never drew.
                                    Rectangle {
                                        height: 280px; clip: true;
                                        explore-nr-fl := SmoothFlickable {
                                            width: parent.width; height: parent.height;
                                            viewport-width: explore-new-releases.length * 214px;
                                            HorizontalLayout {
                                                spacing: 14px;
                                                for item in explore-new-releases: SongCard {
                                                    card-title: item.title;
                                                    card-artist: item.artist;
                                                    avatar-letter: item.avatar-letter;
                                                    thumbnail: item.thumbnail;
                                                    has-thumbnail: item.has-thumbnail;
                                                    video-id: item.video-id;
                                                    is-now-playing: item.video-id == now-playing-video-id;
                                                    is-playing: item.video-id == now-playing-video-id && is-playing;
                                                    clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                                    queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                                    context-requested(px, py) => { open-ctx(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                                }
                                            }
                                        }
                                        EdgeFade { scroll-x: explore-nr-fl.viewport-x; }
                                    }
                                }

                                // ── Charts ──
                                VerticalLayout { height: self.preferred-height; alignment: start; padding-top: Theme.section-gap; spacing: Theme.heading-gap;
                                Text { text: "Charts"; font-size: 18px; font-weight: 600; color: Theme.text; }
                                GridLayout {
                                    spacing: 14px;
                                    Row {
                                        GenreTile { label: "Top 100 Global";  icon: "🌍"; tile-color: #1a3a6a; clicked => { explore-genre("top 100 global hits 2026"); } }
                                        GenreTile { label: "Top 50 USA";      icon: "🇺🇸"; tile-color: #2a1a5a; clicked => { explore-genre("top 50 USA hits 2026"); } }
                                    }
                                    Row {
                                        GenreTile { label: "Top 50 India";    icon: "🇮🇳"; tile-color: #5a2a0a; clicked => { explore-genre("top 50 India hits 2026"); } }
                                        GenreTile { label: "Top 50 UK";       icon: "🇬🇧"; tile-color: #0a3a3a; clicked => { explore-genre("top 50 UK hits 2026"); } }
                                    }
                                }
                                }
                            }
                        }

                        // LIBRARY
                        // Page itself does not scroll; each tab owns a ListView so only
                        // visible rows are instantiated.
                        if !is-loading && current-view == "Library": VerticalLayout {
                            padding: 32px; spacing: 0px; vertical-stretch: 1;
                            lib-col := VerticalLayout {
                                vertical-stretch: 1; spacing: Theme.heading-gap;
                                Text { text: "Your Library"; height: self.preferred-height; font-size: 28px; font-weight: 700; color: Theme.text; }
                                HorizontalLayout {
                                    height: 40px; spacing: 8px; alignment: start;
                                    TabPill { label: "Liked Songs (\{liked-songs.length})"; active: library-tab == "Liked"; clicked => { library-tab = "Liked"; } }
                                    TabPill { label: "Albums"; active: library-tab == "Albums"; clicked => { library-tab = "Albums"; load-library-data(); } }
                                    TabPill { label: "Artists"; active: library-tab == "Artists"; clicked => { library-tab = "Artists"; load-library-data(); } }
                                    TabPill { label: "Playlists"; active: library-tab == "Playlists"; clicked => { library-tab = "Playlists"; load-library-data(); } }
                                }
                                // ── Liked Songs tab ──
                                if library-tab == "Liked": VerticalLayout {
                                    vertical-stretch: 1;
                                    spacing: 2px;
                                    // Primary actions + sort, on one row. Keeping sort inside the
                                    // tab body (rather than as a separate chrome row that appears
                                    // and disappears) removes the layout jump between tabs.
                                    if liked-songs.length > 0: HorizontalLayout {
                                        height: 52px; spacing: 10px; alignment: start;
                                        Rectangle {
                                            width: 104px; height: 40px; border-radius: 20px;
                                            y: (parent.height - self.height) / 2;
                                            background: liked-play-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                            HorizontalLayout {
                                                alignment: center; spacing: 8px;
                                                VerticalLayout { alignment: center; Image { source: @image-url("icons/play.svg"); width: 16px; height: 16px; colorize: Theme.on-accent; } }
                                                Text { text: "Play"; font-size: 14px; font-weight: 700; color: Theme.on-accent; vertical-alignment: center; }
                                            }
                                            liked-play-ta := TouchArea {
                                                clicked => {
                                                    play-song(liked-songs[0].video-id, liked-songs[0].title,
                                                              liked-songs[0].artist, liked-songs[0].duration-secs);
                                                }
                                            }
                                        }
                                        Rectangle { width: 10px; }
                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                height: 30px; spacing: 6px; alignment: start;
                                                TabPill { label: "Recent"; active: library-sort == "recent"; clicked => { library-sort = "recent"; sort-library("recent"); } }
                                                TabPill { label: "A-Z"; active: library-sort == "alpha"; clicked => { library-sort = "alpha"; sort-library("alpha"); } }
                                                TabPill { label: "Most played"; active: library-sort == "most-played"; clicked => { library-sort = "most-played"; sort-library("most-played"); } }
                                            }
                                        }
                                    }
                                    Rectangle { height: 8px; }
                                    if liked-songs.length > 0: HorizontalLayout {
                                        vertical-stretch: 1;
                                        ListView {
                                            // Outweigh the trailing spacer so the list takes the full
                                            // width up to content-max instead of splitting it 50/50.
                                            horizontal-stretch: 100; max-width: Theme.content-max;
                                            for item[i] in liked-songs: SongRow {
                                        song-title: item.title; song-artist: item.artist;
                                        song-album: item.album; song-duration: item.duration-str;
                                        show-album-column: true;
                                        idx-str: "\{i + 1}"; avatar-letter: item.avatar-letter;
                                        thumbnail: item.thumbnail; has-thumbnail: item.has-thumbnail;
                                        is-current: item.video-id == now-playing-video-id;
                                        play-clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                        queue-clicked => { queue-song(item.video-id, item.title, item.artist); }
                                        context-requested(px, py) => { open-ctx-liked(item.video-id, item.title, item.artist, item.album, item.duration-secs, px, py); }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if liked-songs.length == 0: Rectangle {
                                        height: 260px;
                                        VerticalLayout { alignment: center; spacing: 10px;
                                            Text { text: "♥"; font-size: 44px; color: Theme.text-dim; horizontal-alignment: center; }
                                            Text { text: "No liked songs yet"; font-size: 18px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                                            Text { text: "Tap ♥ while a song plays, or find something new."; font-size: 13px; color: Theme.text-muted; horizontal-alignment: center; }
                                            Rectangle { height: 6px; }
                                            HorizontalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 150px; height: 38px; border-radius: 19px;
                                                    background: liked-cta-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                                    Text { text: "Explore music"; font-size: 13px; font-weight: 700; color: Theme.on-accent;
                                                        width: parent.width; height: parent.height;
                                                        horizontal-alignment: center; vertical-alignment: center; }
                                                    liked-cta-ta := TouchArea { clicked => { navigate("Explore"); } }
                                                }
                                            }
                                        }
                                    }
                                    // The branch has vertical-stretch, so without a stretchy child
                                    // the layout would centre the empty state. Soak up the slack.
                                    if liked-songs.length == 0: Rectangle { vertical-stretch: 1; }
                                }
                                // ── Albums tab ──
                                if library-tab == "Albums": VerticalLayout {
                                    vertical-stretch: 1;
                                    spacing: 12px;
                                    if library-albums.length == 0: Rectangle {
                                        height: 260px;
                                        VerticalLayout { alignment: center; spacing: 10px;
                                            // A fixed-width Image cannot centre itself in a
                                            // VerticalLayout cell; horizontal-alignment only
                                            // positions the bitmap inside the element box.
                                            HorizontalLayout { alignment: center;
                                                Image { source: @image-url("icons/album.svg"); width: 44px; height: 44px; colorize: Theme.text-dim; }
                                            }
                                            Text { text: "No albums yet"; font-size: 18px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                                            Text { text: "Albums you save appear here."; font-size: 13px; color: Theme.text-muted; horizontal-alignment: center; }
                                            Rectangle { height: 6px; }
                                            HorizontalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 150px; height: 38px; border-radius: 19px;
                                                    background: alb-cta-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                                    Text { text: "Find albums"; font-size: 13px; font-weight: 700; color: Theme.on-accent;
                                                        width: parent.width; height: parent.height;
                                                        horizontal-alignment: center; vertical-alignment: center; }
                                                    alb-cta-ta := TouchArea { clicked => { navigate("Explore"); } }
                                                }
                                            }
                                        }
                                    }
                                    if library-albums.length == 0: Rectangle { vertical-stretch: 1; }
                                    if library-albums.length > 0: ListView {
                                    for alb[i] in library-albums: Rectangle {
                                        height: 64px; border-radius: Theme.radius-sm;
                                        background: lib-alb-ta.has-hover ? Theme.hover-veil : transparent;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 12px; spacing: 12px;
                                            Rectangle {
                                                width: 48px; height: 48px; border-radius: 6px; clip: true;
                                                background: Theme.art-placeholder;
                                                y: (parent.height - self.height) / 2;
                                                if alb.has-thumbnail: Image {
                                                    source: alb.thumbnail;
                                                    width: parent.width; height: parent.height; image-fit: cover;
                                                }
                                                if !alb.has-thumbnail: Image {
                                                    source: @image-url("icons/album.svg"); width: 20px; height: 20px; colorize: Theme.text-dim;
                                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; spacing: 3px; horizontal-stretch: 1;
                                                Text { text: alb.title; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; }
                                                HorizontalLayout {
                                                    spacing: 6px; alignment: start;
                                                    Text { text: "Album"; font-size: 12px; color: Theme.text-dim; }
                                                    Text { text: "•"; font-size: 12px; color: Theme.text-dim; }
                                                    Text { text: alb.artist; font-size: 12px; color: Theme.text-muted; overflow: elide; }
                                                }
                                            }
                                        }
                                        lib-alb-ta := TouchArea {
                                            clicked => { navigate-to-album(alb.browse-id); }
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                    open-entity-ctx("Album", alb.browse-id, alb.title, alb.artist,
                                                        self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                        }
                                    }
                                    }
                                }
                                // ── Artists tab ──
                                if library-tab == "Artists": VerticalLayout {
                                    vertical-stretch: 1;
                                    spacing: 12px;
                                    if library-artists.length == 0: Rectangle {
                                        height: 200px;
                                        VerticalLayout { alignment: center; spacing: 12px;
                                            HorizontalLayout { alignment: center;
                                                Image { source: @image-url("icons/artist.svg"); width: 44px; height: 44px; colorize: Theme.text-dim; }
                                            }
                                            Text { text: "No artists yet"; font-size: 18px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                                            Text { text: "Artists you follow appear here."; font-size: 13px; color: Theme.text-muted; horizontal-alignment: center; }
                                            Rectangle { height: 6px; }
                                            HorizontalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 150px; height: 38px; border-radius: 19px;
                                                    background: art-cta-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                                    Text { text: "Find artists"; font-size: 13px; font-weight: 700; color: Theme.on-accent;
                                                        width: parent.width; height: parent.height;
                                                        horizontal-alignment: center; vertical-alignment: center; }
                                                    art-cta-ta := TouchArea { clicked => { navigate("Explore"); } }
                                                }
                                            }
                                        }
                                    }
                                    if library-artists.length == 0: Rectangle { vertical-stretch: 1; }
                                    if library-artists.length > 0: ListView {
                                    for art[i] in library-artists: Rectangle {
                                        height: 64px; border-radius: Theme.radius-sm;
                                        background: lib-art-ta.has-hover ? Theme.hover-veil : transparent;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 12px; spacing: 12px;
                                            Rectangle {
                                                width: 48px; height: 48px; border-radius: 24px; clip: true;
                                                background: Theme.art-placeholder;
                                                y: (parent.height - self.height) / 2;
                                                if art.has-thumbnail: Image {
                                                    source: art.thumbnail;
                                                    width: parent.width; height: parent.height; image-fit: cover;
                                                }
                                                if !art.has-thumbnail: Image {
                                                    source: @image-url("icons/artist.svg"); width: 20px; height: 20px; colorize: Theme.text-dim;
                                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 1;
                                                Text { text: art.name; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; }
                                            }
                                        }
                                        lib-art-ta := TouchArea {
                                            clicked => { navigate-to-artist(art.browse-id); }
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                    open-entity-ctx("Artist", art.browse-id, art.name, art.name,
                                                        self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                        }
                                    }
                                    }
                                }
                                // ── Playlists tab ──
                                if library-tab == "Playlists": VerticalLayout {
                                    vertical-stretch: 1;
                                    spacing: 12px;
                                    // Create a new local playlist
                                    HorizontalLayout { alignment: start;
                                        Rectangle {
                                            width: 156px; height: 40px; border-radius: Theme.radius-sm;
                                            background: new-pl-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                            HorizontalLayout { alignment: center; spacing: 8px;
                                                Text { text: "+"; color: Theme.on-accent; font-size: 17px; font-weight: 700; vertical-alignment: center; }
                                                Text { text: "New playlist"; color: Theme.on-accent; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                            }
                                            new-pl-ta := TouchArea { clicked => { new-playlist(); } }
                                        }
                                    }
                                    if library-playlists.length == 0: Rectangle {
                                        height: 220px;
                                        VerticalLayout { alignment: center; spacing: 10px;
                                            HorizontalLayout { alignment: center;
                                                Image { source: @image-url("icons/library.svg"); width: 44px; height: 44px; colorize: Theme.text-dim; }
                                            }
                                            Text { text: "No playlists yet"; font-size: 18px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                                            Text { text: "Create one above, or save a playlist you find."; font-size: 13px; color: Theme.text-muted; horizontal-alignment: center; }
                                        }
                                    }
                                    if library-playlists.length == 0: Rectangle { vertical-stretch: 1; }
                                    if library-playlists.length > 0: ListView {
                                    for pl[i] in library-playlists: Rectangle {
                                        height: 64px; border-radius: Theme.radius-sm;
                                        background: pl-ta.has-hover ? Theme.hover-veil : transparent;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 12px; spacing: 12px;
                                            Rectangle {
                                                width: 48px; height: 48px; border-radius: 6px; clip: true;
                                                background: Theme.art-placeholder;
                                                y: (parent.height - self.height) / 2;
                                                if pl.has-thumbnail: Image {
                                                    source: pl.thumbnail;
                                                    width: parent.width; height: parent.height; image-fit: cover;
                                                }
                                                if !pl.has-thumbnail: Image {
                                                    source: @image-url("icons/library.svg"); width: 20px; height: 20px; colorize: Theme.text-dim;
                                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; spacing: 3px; horizontal-stretch: 1;
                                                Text { text: pl.title; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; }
                                                HorizontalLayout {
                                                    spacing: 6px; alignment: start;
                                                    Text { text: "Playlist"; font-size: 12px; color: Theme.text-dim; }
                                                    if pl.count-text != "": Text { text: "•"; font-size: 12px; color: Theme.text-dim; }
                                                    if pl.count-text != "": Text { text: pl.count-text; font-size: 12px; color: Theme.text-muted; }
                                                }
                                            }
                                        }
                                        pl-ta := TouchArea { clicked => { navigate-to-playlist(pl.playlist-id); } }
                                    }
                                    }
                                }
                            }
                        }

                        // SETTINGS
                        if !is-loading && current-view == "Settings": SmoothFlickable {
                            viewport-width: self.width; viewport-height: set-col.preferred-height;
                            set-col := VerticalLayout {
                                width: parent.width; height: self.preferred-height; alignment: start;
                                padding: 32px; spacing: Theme.section-gap;
                                Text { text: "Settings"; font-size: 28px; font-weight: 700; color: Theme.text; }
                                // About
                                Rectangle {
                                    height: 72px; border-radius: 12px;
                                    background: Theme.surface; border-color: Theme.border; border-width: 1px;
                                    HorizontalLayout {
                                        padding: 20px; spacing: 14px; alignment: start;
                                        Text { text: "▶"; color: Theme.accent; font-size: 26px; vertical-alignment: center; }
                                        VerticalLayout { alignment: center; spacing: 4px;
                                            Text { text: "Auricle"; font-size: 16px; font-weight: 600; color: Theme.text; }
                                            Text { text: "Native • Rust + Slint"; font-size: 12px; color: Theme.text-muted; }
                                        }
                                    }
                                }
                                // Appearance
                                Text { text: "Appearance"; font-size: 14px; font-weight: 600; color: Theme.text-muted; }
                                Rectangle {
                                    height: 148px; border-radius: Theme.radius;
                                    background: Theme.surface; border-color: Theme.border; border-width: 1px;
                                    VerticalLayout { padding: 18px; spacing: 14px;
                                        HorizontalLayout { alignment: space-between; spacing: 16px;
                                            VerticalLayout { alignment: center; spacing: 3px; horizontal-stretch: 1;
                                                Text { text: "Color theme"; font-size: 14px; color: Theme.text; }
                                                Text { text: "Accent and complementary surfaces"; font-size: 12px; color: Theme.text-muted; }
                                            }
                                            theme-picker := Rectangle {
                                                width: 190px; height: 36px; border-radius: Theme.radius-sm;
                                                background: theme-picker-ta.has-hover ? Theme.surface-hover : Theme.surface-2;
                                                border-color: Theme.border; border-width: 1px;
                                                HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 9px;
                                                    Rectangle { width: 16px; height: 16px; border-radius: 8px; background: Theme.accent; }
                                                    Text { text: theme-name; font-size: 13px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                    Text { text: "⌄"; font-size: 14px; color: Theme.text-muted; vertical-alignment: center; }
                                                }
                                                theme-picker-ta := TouchArea { clicked => { theme-menu.show(); } }
                                                theme-menu := PopupWindow {
                                                    x: 0px; y: 40px; width: 220px; height: 406px;
                                                    Rectangle {
                                                        width: 220px; height: 406px; border-radius: Theme.radius;
                                                        background: Theme.glass-strong; border-color: Theme.border; border-width: 1px;
                                                        drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 7px;
                                                        VerticalLayout { padding: 8px; spacing: 1px;
                                                            ThemeChoice { theme-label: "Default Blue"; theme-color: #6486b0; selected: theme-name == "Default Blue"; picked => { set-theme-name("Default Blue"); theme-menu.close(); } }
                                                            ThemeChoice { theme-label: "Solar Red"; theme-color: #e2503f; selected: theme-name == "Solar Red"; picked => { set-theme-name("Solar Red"); theme-menu.close(); } }
                                                            ThemeChoice { theme-label: "Ember"; theme-color: #f2703a; selected: theme-name == "Ember"; picked => { set-theme-name("Ember"); theme-menu.close(); } }
                                                            ThemeChoice { theme-label: "Earth"; theme-color: #b06a43; selected: theme-name == "Earth"; picked => { set-theme-name("Earth"); theme-menu.close(); } }
                                                            ThemeChoice { theme-label: "Forest"; theme-color: #3fa96a; selected: theme-name == "Forest"; picked => { set-theme-name("Forest"); theme-menu.close(); } }
                                                            ThemeChoice { theme-label: "Ocean"; theme-color: #1699a8; selected: theme-name == "Ocean"; picked => { set-theme-name("Ocean"); theme-menu.close(); } }
                                                            ThemeChoice { theme-label: "Sky"; theme-color: #46a6e6; selected: theme-name == "Sky"; picked => { set-theme-name("Sky"); theme-menu.close(); } }
                                                            ThemeChoice { theme-label: "Twilight"; theme-color: #8b5cf6; selected: theme-name == "Twilight"; picked => { set-theme-name("Twilight"); theme-menu.close(); } }
                                                            ThemeChoice { theme-label: "Rose"; theme-color: #e26aa0; selected: theme-name == "Rose"; picked => { set-theme-name("Rose"); theme-menu.close(); } }
                                                            ThemeChoice { theme-label: "Mono"; theme-color: #6b7280; selected: theme-name == "Mono"; picked => { set-theme-name("Mono"); theme-menu.close(); } }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle { height: 1px; background: Theme.border-soft; }
                                        HorizontalLayout { alignment: space-between; spacing: 16px;
                                            VerticalLayout { alignment: center; spacing: 3px; horizontal-stretch: 1;
                                                Text { text: "App mode"; font-size: 14px; color: Theme.text; }
                                                Text { text: "System follows Windows"; font-size: 12px; color: Theme.text-muted; }
                                            }
                                            HorizontalLayout { spacing: 4px;
                                                TabPill { label: "System"; active: theme-mode == "System"; clicked => { set-theme-mode("System"); } }
                                                TabPill { label: "Dark"; active: theme-mode == "Dark"; clicked => { set-theme-mode("Dark"); } }
                                                TabPill { label: "Light"; active: theme-mode == "Light"; clicked => { set-theme-mode("Light"); } }
                                            }
                                        }
                                    }
                                }
                                // Updates (portable build only)
                                if self-update-enabled: Text { text: "Updates"; font-size: 14px; font-weight: 600; color: Theme.text-muted; }
                                if self-update-enabled: Rectangle {
                                    border-radius: Theme.radius; background: Theme.surface; border-color: Theme.border; border-width: 1px;
                                    VerticalLayout { padding: 18px; spacing: 14px;
                                        HorizontalLayout { spacing: 12px;
                                            VerticalLayout { alignment: center; spacing: 2px; horizontal-stretch: 1;
                                                Text { text: "Current version"; font-size: 14px; color: Theme.text; }
                                                Text { text: "v\{app-version}"; font-size: 12px; color: Theme.text-muted; }
                                            }
                                            if update-available: Rectangle {
                                                width: 110px; height: 32px; border-radius: 8px;
                                                background: update-busy ? Theme.surface-hover : (upd-ta.has-hover ? Theme.accent-strong : Theme.accent);
                                                animate background { duration: 100ms; }
                                                Text { text: "Update now"; font-size: 13px; color: update-busy ? Theme.text-dim : Theme.on-accent; horizontal-alignment: center; vertical-alignment: center; }
                                                upd-ta := TouchArea { clicked => { if !update-busy { apply-update(); } } }
                                            }
                                            if !update-available: Rectangle {
                                                width: 130px; height: 32px; border-radius: Theme.radius-sm;
                                                background: update-busy ? Theme.surface : (chk-ta.has-hover ? Theme.surface-hover : transparent);
                                                border-color: Theme.border; border-width: 1px;
                                                Text { text: "Check for updates"; font-size: 12px; color: update-busy ? Theme.text-dim : Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                                                chk-ta := TouchArea { clicked => { if !update-busy { check-updates(); } } }
                                            }
                                        }
                                        if update-status != "": Text { text: update-status; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                    }
                                }
                                // Essential add-ons
                                Text { text: "Essential add-ons"; font-size: 14px; font-weight: 600; color: Theme.text-muted; }
                                Rectangle {
                                    border-radius: Theme.radius; background: Theme.surface; border-color: Theme.border; border-width: 1px;
                                    VerticalLayout { padding: 18px; spacing: 14px;
                                        Text {
                                            text: "These optional third-party tools are not bundled with Auricle. Installing them is at your own discretion and choice; Auricle is not affiliated with them. You may also install them manually onto your PATH.";
                                            font-size: 12px; color: Theme.text-muted; wrap: word-wrap;
                                        }
                                        // yt-dlp row
                                        VerticalLayout { spacing: 10px;
                                            HorizontalLayout { spacing: 12px;
                                                VerticalLayout { alignment: center; spacing: 2px; horizontal-stretch: 1;
                                                    Text { text: "yt-dlp"; font-size: 14px; color: Theme.text; }
                                                    Text { text: "Required for audio streaming and downloads."; font-size: 12px; color: Theme.text-muted; }
                                                }
                                                if ytdlp-installed && addon-installing != "ytdlp" && addon-installing != "ytdlp-update": HorizontalLayout { spacing: 8px; alignment: end;
                                                    HorizontalLayout { spacing: 5px; alignment: end;
                                                        VerticalLayout { alignment: center;
                                                            // Drawn as a shape, not a "✓" glyph — the previous glyph
                                                            // rendered as a tofu box in some font fallbacks.
                                                            Rectangle {
                                                                width: 14px; height: 14px; border-radius: 7px;
                                                                background: Theme.success;
                                                                Text { text: "✓"; font-size: 9px; font-weight: 700; color: Theme.on-danger;
                                                                    width: parent.width; height: parent.height;
                                                                    horizontal-alignment: center; vertical-alignment: center; }
                                                            }
                                                        }
                                                        Text { text: "Installed"; font-size: 13px; color: Theme.success; vertical-alignment: center; }
                                                    }
                                                    Rectangle {
                                                        width: 80px; height: 32px; border-radius: Theme.radius-sm;
                                                        background: addon-busy ? Theme.surface : (yt-upd-ta.has-hover ? Theme.surface-hover : transparent);
                                                        border-color: Theme.border; border-width: 1px;
                                                        animate background { duration: 100ms; }
                                                        Text { text: "Update"; font-size: 12px; color: addon-busy ? Theme.text-dim : Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                                                        yt-upd-ta := TouchArea { clicked => { if !addon-busy { update-ytdlp(); } } }
                                                    }
                                                    Rectangle {
                                                        width: 104px; height: 32px; border-radius: Theme.radius-sm;
                                                        background: addon-busy ? Theme.surface : (yt-rep-ta.has-hover ? Theme.surface-hover : transparent);
                                                        border-color: Theme.border; border-width: 1px;
                                                        animate background { duration: 100ms; }
                                                        Text { text: "Repair install"; font-size: 12px; color: addon-busy ? Theme.text-dim : Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                                                        yt-rep-ta := TouchArea { clicked => { if !addon-busy { install-ytdlp(); } } }
                                                    }
                                                }
                                                if !ytdlp-installed && addon-installing != "ytdlp": Rectangle {
                                                    width: 92px; height: 32px; border-radius: Theme.radius-sm;
                                                    background: addon-busy ? Theme.surface-hover : (yt-ins-ta.has-hover ? Theme.accent-strong : Theme.accent);
                                                    animate background { duration: 100ms; }
                                                    Text { text: "Install"; font-size: 13px; color: addon-busy ? Theme.text-dim : Theme.on-accent; horizontal-alignment: center; vertical-alignment: center; }
                                                    yt-ins-ta := TouchArea { clicked => { if !addon-busy { install-ytdlp(); } } }
                                                }
                                            }
                                            if addon-installing == "ytdlp": HorizontalLayout { spacing: 10px; alignment: center;
                                                AddonProgress { value: addon-progress; horizontal-stretch: 1; }
                                                Text {
                                                    text: addon-progress < 0 ? "…" : (Math.round(addon-progress * 100) + "%");
                                                    width: 40px; font-size: 11px; color: Theme.text-muted; vertical-alignment: center;
                                                }
                                            }
                                            if addon-installing == "ytdlp-update": HorizontalLayout { spacing: 10px; alignment: center;
                                                Text { text: "Updating yt-dlp…"; font-size: 12px; color: Theme.text-muted; horizontal-stretch: 1; }
                                                AddonProgress { value: addon-progress; width: 120px; }
                                            }
                                        }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        // ffmpeg row
                                        VerticalLayout { spacing: 10px;
                                            HorizontalLayout { spacing: 12px;
                                                VerticalLayout { alignment: center; spacing: 2px; horizontal-stretch: 1;
                                                    Text { text: "ffmpeg"; font-size: 14px; color: Theme.text; }
                                                    Text { text: "Optional. Improves format handling for downloads."; font-size: 12px; color: Theme.text-muted; }
                                                }
                                                if ffmpeg-installed && addon-installing != "ffmpeg": HorizontalLayout { spacing: 10px; alignment: end;
                                                    HorizontalLayout { spacing: 5px; alignment: end;
                                                        VerticalLayout { alignment: center;
                                                            Rectangle {
                                                                width: 14px; height: 14px; border-radius: 7px;
                                                                background: Theme.success;
                                                                Text { text: "✓"; font-size: 9px; font-weight: 700; color: Theme.on-danger;
                                                                    width: parent.width; height: parent.height;
                                                                    horizontal-alignment: center; vertical-alignment: center; }
                                                            }
                                                        }
                                                        Text { text: "Installed"; font-size: 13px; color: Theme.success; vertical-alignment: center; }
                                                    }
                                                    Rectangle {
                                                        width: 104px; height: 32px; border-radius: Theme.radius-sm;
                                                        background: addon-busy ? Theme.surface : (ff-rep-ta.has-hover ? Theme.surface-hover : transparent);
                                                        border-color: Theme.border; border-width: 1px;
                                                        animate background { duration: 100ms; }
                                                        Text { text: "Repair install"; font-size: 12px; color: addon-busy ? Theme.text-dim : Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                                                        ff-rep-ta := TouchArea { clicked => { if !addon-busy { install-ffmpeg(); } } }
                                                    }
                                                }
                                                if !ffmpeg-installed && addon-installing != "ffmpeg": Rectangle {
                                                    width: 92px; height: 32px; border-radius: Theme.radius-sm;
                                                    background: addon-busy ? Theme.surface-hover : (ff-ins-ta.has-hover ? Theme.accent-strong : Theme.accent);
                                                    animate background { duration: 100ms; }
                                                    Text { text: "Install"; font-size: 13px; color: addon-busy ? Theme.text-dim : Theme.on-accent; horizontal-alignment: center; vertical-alignment: center; }
                                                    ff-ins-ta := TouchArea { clicked => { if !addon-busy { install-ffmpeg(); } } }
                                                }
                                            }
                                            if addon-installing == "ffmpeg": HorizontalLayout { spacing: 10px; alignment: center;
                                                AddonProgress { value: addon-progress; horizontal-stretch: 1; }
                                                Text {
                                                    text: addon-progress < 0 ? "…" : (Math.round(addon-progress * 100) + "%");
                                                    width: 40px; font-size: 11px; color: Theme.text-muted; vertical-alignment: center;
                                                }
                                            }
                                        }
                                        if addon-status != "": Text { text: addon-status; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }

                                        Rectangle { height: 1px; background: Theme.border; }

                                        // Deno row — JS runtime needed by yt-dlp for YouTube 403 signature
                                        VerticalLayout { spacing: 10px;
                                            HorizontalLayout { spacing: 12px;
                                                VerticalLayout { alignment: center; spacing: 2px; horizontal-stretch: 1;
                                                    Text { text: "Deno"; font-size: 14px; color: Theme.text; }
                                                    Text { text: "JavaScript runtime used by yt-dlp for YouTube. Fixes 403 errors on some videos."; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                                }
                                                if deno-installed && addon-installing != "deno": HorizontalLayout { spacing: 10px; alignment: end;
                                                    HorizontalLayout { spacing: 5px; alignment: end;
                                                        VerticalLayout { alignment: center;
                                                            Rectangle {
                                                                width: 14px; height: 14px; border-radius: 7px;
                                                                background: Theme.success;
                                                                Text { text: "✓"; font-size: 9px; font-weight: 700; color: Theme.on-danger;
                                                                    width: parent.width; height: parent.height;
                                                                    horizontal-alignment: center; vertical-alignment: center; }
                                                            }
                                                        }
                                                        Text { text: "Installed"; font-size: 13px; color: Theme.success; vertical-alignment: center; }
                                                    }
                                                    Rectangle {
                                                        width: 104px; height: 32px; border-radius: Theme.radius-sm;
                                                        background: addon-busy ? Theme.surface : (dn-rep-ta.has-hover ? Theme.surface-hover : transparent);
                                                        border-color: Theme.border; border-width: 1px;
                                                        animate background { duration: 100ms; }
                                                        Text { text: "Repair install"; font-size: 12px; color: addon-busy ? Theme.text-dim : Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                                                        dn-rep-ta := TouchArea { clicked => { if !addon-busy { install-deno(); } } }
                                                    }
                                                }
                                                if !deno-installed && addon-installing != "deno": Rectangle {
                                                    width: 92px; height: 32px; border-radius: Theme.radius-sm;
                                                    background: addon-busy ? Theme.surface-hover : (dn-ins-ta.has-hover ? Theme.accent-strong : Theme.accent);
                                                    animate background { duration: 100ms; }
                                                    Text { text: "Install"; font-size: 13px; color: addon-busy ? Theme.text-dim : Theme.on-accent; horizontal-alignment: center; vertical-alignment: center; }
                                                    dn-ins-ta := TouchArea { clicked => { if !addon-busy { install-deno(); } } }
                                                }
                                            }
                                            if addon-installing == "deno": HorizontalLayout { spacing: 10px; alignment: center;
                                                AddonProgress { value: addon-progress; horizontal-stretch: 1; }
                                                Text {
                                                    text: addon-progress < 0 ? "…" : (Math.round(addon-progress * 100) + "%");
                                                    width: 40px; font-size: 11px; color: Theme.text-muted; vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                                // Audio
                                Text { text: "Audio"; font-size: 14px; font-weight: 600; color: Theme.text-muted; }
                                Rectangle {
                                    border-radius: Theme.radius; background: Theme.surface; border-color: Theme.border; border-width: 1px;
                                    VerticalLayout { padding: 18px; spacing: 14px;
                                        HorizontalLayout { alignment: space-between;
                                            Text { text: "Audio quality"; font-size: 14px; color: Theme.text; vertical-alignment: center; }
                                            Text { text: "Best available (AAC)"; font-size: 13px; color: Theme.text-muted; vertical-alignment: center; }
                                        }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        HorizontalLayout { alignment: space-between;
                                            Text { text: "Cookie auth"; font-size: 14px; color: Theme.text; vertical-alignment: center; }
                                            Text { text: "Auto: Edge ? Chrome ? Firefox"; font-size: 13px; color: Theme.text-muted; vertical-alignment: center; }
                                        }
                                    }
                                }
                                // Library
                                Text { text: "Library"; font-size: 14px; font-weight: 600; color: Theme.text-muted; }
                                Rectangle {
                                    border-radius: Theme.radius; background: Theme.surface; border-color: Theme.border; border-width: 1px;
                                    VerticalLayout { padding: 18px; spacing: 14px;
                                        HorizontalLayout { alignment: space-between;
                                            Text { text: "Liked songs"; font-size: 14px; color: Theme.text; vertical-alignment: center; }
                                            Text { text: "\{liked-songs.length} songs"; font-size: 13px; color: Theme.text-muted; vertical-alignment: center; }
                                        }

                                        Rectangle { height: 1px; background: Theme.border; }
                                        HorizontalLayout { alignment: space-between;
                                            Text { text: "Queue length"; font-size: 14px; color: Theme.text; vertical-alignment: center; }
                                            Text { text: "\{queue.length} songs"; font-size: 13px; color: Theme.text-muted; vertical-alignment: center; }
                                        }
                                    }
                                }
                                // Cache
                                Text { text: "Cache"; font-size: 14px; font-weight: 600; color: Theme.text-muted; }
                                Rectangle {
                                    border-radius: Theme.radius; background: Theme.surface; border-color: Theme.border; border-width: 1px;
                                    VerticalLayout { padding: 18px; spacing: 14px;
                                        HorizontalLayout { alignment: space-between;
                                            Text { text: "Cached songs"; font-size: 14px; color: Theme.text; vertical-alignment: center; }
                                            Text { text: "\{cache-song-count} songs • \{cache-used-mb} MB"; font-size: 13px; color: Theme.text-muted; vertical-alignment: center; }
                                        }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        VerticalLayout { spacing: 8px;
                                            HorizontalLayout { alignment: space-between;
                                                Text { text: "Storage limit"; font-size: 14px; color: Theme.text; vertical-alignment: center; }
                                                Text { text: "\{cache-limit-mb} MB"; font-size: 13px; color: Theme.accent; vertical-alignment: center; font-weight: 600; }
                                            }
                                            Rectangle { height: 4px; border-radius: 2px; background: Theme.surface-hover;
                                                Rectangle {
                                                    x: 0; y: 0; border-radius: 2px;
                                                    width: max(4px, min(parent.width, parent.width * (cache-used-mb / max(1, cache-limit-mb))));
                                                    background: cache-used-mb > cache-limit-mb * 9 / 10 ? Theme.danger : Theme.accent;
                                                }
                                            }
                                            // Spell out what the bar represents — previously it was an
                                            // unlabeled fill with no indication of the ratio.
                                            Text {
                                                text: "\{cache-used-mb} MB of \{cache-limit-mb} MB used";
                                                font-size: 11px; color: Theme.text-dim;
                                            }
                                        }
                                        HorizontalLayout { spacing: 8px; alignment: start;
                                            for mb in [250, 500, 1000, 2000]: Rectangle {
                                                width: 72px; height: 32px; border-radius: 16px;
                                                background: cache-limit-mb == mb ? Theme.accent : Theme.surface-hover;
                                                Text {
                                                    text: mb >= 1000 ? (mb / 1000) + " GB" : mb + " MB";
                                                    color: cache-limit-mb == mb ? Theme.on-accent : Theme.text-muted;
                                                    font-size: 12px; font-weight: 600;
                                                    width: parent.width; height: parent.height;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                                TouchArea { clicked => { set-cache-limit(mb); } }
                                            }
                                        }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        Text { text: "Songs are cached on first play and persist between sessions."; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                        Rectangle { height: 12px; }
                                        Rectangle {
                                            height: 36px; width: 120px; border-radius: Theme.radius-sm;
                                            background: clear-cache-ta.has-hover ? Theme.danger : Theme.danger-bg;
                                            Text { text: "Clear Cache"; font-size: 13px; font-weight: 600; color: Theme.on-danger;
                                                width: parent.width; height: parent.height;
                                                horizontal-alignment: center; vertical-alignment: center; }
                                            clear-cache-ta := TouchArea { clicked => { clear-cache(); } }
                                        }
                                    }
                                }
                                // Behavior
                                Text { text: "Behavior"; font-size: 14px; font-weight: 600; color: Theme.text-muted; }
                                Rectangle {
                                    border-radius: Theme.radius; background: Theme.surface; border-color: Theme.border; border-width: 1px;
                                    VerticalLayout { padding: 18px; spacing: 14px;
                                        HorizontalLayout { alignment: space-between;
                                            VerticalLayout { spacing: 4px; vertical-stretch: 1;
                                                Text { text: "Minimize to tray"; font-size: 14px; color: Theme.text; vertical-alignment: center; }
                                                Text { text: "Close button minimizes to system tray instead of quitting"; font-size: 12px; color: Theme.text-muted; }
                                            }
                                            // Toggle switch
                                            Rectangle {
                                                width: 44px; height: 24px; border-radius: 12px;
                                                background: minimize-to-tray ? Theme.accent : Theme.surface-hover;
                                                animate background { duration: 150ms; }
                                                Rectangle {
                                                    x: minimize-to-tray ? parent.width - self.width - 2px : 2px;
                                                    y: 2px; width: 20px; height: 20px; border-radius: 10px;
                                                    background: minimize-to-tray ? Theme.on-accent : Theme.text-muted;
                                                    animate x { duration: 150ms; easing: ease-out; }
                                                }
                                                TouchArea { clicked => { minimize-to-tray = !minimize-to-tray; set-minimize-to-tray(minimize-to-tray); } }
                                            }
                                        }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        // Prefetch depth
                                        VerticalLayout { spacing: 10px;
                                            VerticalLayout { spacing: 4px;
                                                Text { text: "Prefetch ahead"; font-size: 14px; color: Theme.text; }
                                                Text { text: "How many upcoming songs to fully cache in advance. Higher makes rapid skipping smoother but uses more data."; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                            }
                                            HorizontalLayout { spacing: 8px; alignment: start;
                                                for n in [1, 2, 3]: Rectangle {
                                                    width: 84px; height: 32px; border-radius: 16px;
                                                    background: prefetch-depth == n ? Theme.accent : Theme.surface-hover;
                                                    Text {
                                                        text: n == 1 ? "1 song" : (n + " songs");
                                                        color: prefetch-depth == n ? Theme.on-accent : Theme.text-muted;
                                                        font-size: 12px; font-weight: 600;
                                                        width: parent.width; height: parent.height;
                                                        horizontal-alignment: center; vertical-alignment: center;
                                                    }
                                                    TouchArea { clicked => { set-prefetch-depth(n); } }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Right queue pane (Spotify-style) ─────────────────────────
                if queue-pane-open: Rectangle {
                    width: compact ? 288px : 320px;
                    background: Theme.frost;
                    // Left glass-edge highlight for a premium frosted look.
                    Rectangle { x: 0; y: 0; width: 1px; height: parent.height; background: Theme.frost-hi; }
                    VerticalLayout {
                        padding: 12px; padding-left: 12px; padding-right: 12px; spacing: 0px;
                        // Header
                        HorizontalLayout {
                            height: 40px; alignment: space-between;
                            Text { text: "Queue"; font-size: 16px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                            HorizontalLayout { spacing: 4px; alignment: center;
                                Text { text: "\{queue.length} songs"; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; }
                                IconBtn { svg-icon: @image-url("icons/close.svg"); use-svg: true; icon-color: Theme.text-muted; clicked => { toggle-queue-pane(); } }
                            }
                        }
                        Rectangle { height: 12px; }

                        SmoothFlickable {
                            vertical-stretch: 1;
                            viewport-height: qpane-col.preferred-height;
                            qpane-col := VerticalLayout {
                                spacing: 0px;

                                // ── Now Playing ──
                                if now-playing-video-id != "": VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Now playing"; font-size: 14px; font-weight: 700; color: Theme.text; }
                                    Rectangle {
                                        height: 68px; border-radius: Theme.radius-sm;
                                        background: Theme.hover-veil;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; padding-top: 10px; padding-bottom: 10px; spacing: 10px;
                                            Rectangle {
                                                width: 48px; height: 48px; border-radius: 6px; clip: true;
                                                background: Theme.art-placeholder;
                                                if has-album-art: Image {
                                                    source: album-art; width: parent.width; height: parent.height; image-fit: cover;
                                                }
                                                if !has-album-art: Text {
                                                    text: track-initial; color: Theme.accent; font-size: 16px; font-weight: 700;
                                                    width: parent.width; height: parent.height;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; spacing: 3px; horizontal-stretch: 1;
                                                Text { text: track-title; font-size: 14px; font-weight: 600; color: Theme.accent; overflow: elide; }
                                                Text { text: track-artist; font-size: 12px; color: Theme.text-muted; overflow: elide; }
                                            }
                                        }
                                        np-ta := TouchArea {
                                            pointer-event(e) => {
                                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                                    open-ctx(now-playing-video-id, track-title, track-artist, "", 0,
                                                        self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: 16px; }
                                }

                                // ── Next in queue ──
                                Text { text: "Next in queue"; font-size: 14px; font-weight: 700; color: Theme.text; }
                                Rectangle { height: 8px; }

                                for item[i] in queue: Rectangle {
                                    height: 64px;
                                    border-radius: Theme.radius-sm;
                                    // The remove strip's TouchArea steals hover from the row, so the
                                    // row must treat either as "hovered" or it un-highlights itself
                                    // and hides the button exactly where the button sits.
                                    background: item.video-id == now-playing-video-id ? Theme.accent-soft : ((qrow-ta.has-hover || rm-ta.has-hover) ? Theme.hover-veil : transparent);
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 52px; padding-top: 8px; padding-bottom: 8px; spacing: 12px;
                                        Rectangle {
                                            width: 48px; height: 48px; border-radius: 6px; clip: true;
                                            background: Theme.art-placeholder;
                                            if item.has-thumbnail: Image {
                                                source: item.thumbnail; width: parent.width; height: parent.height; image-fit: cover;
                                            }
                                            if !item.has-thumbnail: Text {
                                                text: item.avatar-letter;
                                                color: item.video-id == now-playing-video-id ? Theme.accent : Theme.text-muted;
                                                font-size: 14px; font-weight: 700;
                                                width: parent.width; height: parent.height;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center; spacing: 3px; horizontal-stretch: 1;
                                            Text { text: item.title; font-size: 14px; font-weight: 500; color: item.video-id == now-playing-video-id ? Theme.accent : Theme.text; overflow: elide; }
                                            Text { text: item.artist; font-size: 12px; color: Theme.text-muted; overflow: elide; }
                                        }
                                    }
                                    qrow-ta := TouchArea {
                                        clicked => { play-song(item.video-id, item.title, item.artist, item.duration-secs); }
                                        pointer-event(e) => {
                                            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                                                open-ctx-queue(item.video-id, item.title, item.artist, item.album, item.duration-secs, i,
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                    // Remove button — a wide right-edge strip so it's easy to hit.
                                    // Unconditional (an `if`-gated sibling loses hit-testing to the
                                    // row's TouchArea) and hidden via transparent colors rather than
                                    // `opacity`, which would force a FemtoVG layer per row.
                                    Rectangle {
                                        x: parent.width - 46px; y: 0;
                                        width: 46px; height: parent.height;
                                        Rectangle {
                                            width: 30px; height: 30px; border-radius: 15px;
                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                            background: (qrow-ta.has-hover || rm-ta.has-hover) ? (rm-ta.has-hover ? Theme.surface-hover : Theme.hover-veil) : transparent;
                                            if qrow-ta.has-hover || rm-ta.has-hover: Image { source: @image-url("icons/close.svg"); width: 14px; height: 14px; colorize: rm-ta.has-hover ? Theme.text : Theme.text-muted; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                        }
                                        rm-ta := TouchArea { clicked => { remove-from-queue(i); } }
                                    }
                                }
                                if queue.length == 0: Rectangle {
                                    height: 100px;
                                    Text { text: "Queue is empty"; font-size: 14px; color: Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                                }

                                // ── Autoplay section ──
                                Rectangle { height: 16px; }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    height: 44px; padding-left: 6px; padding-right: 6px;
                                    Text {
                                        text: "Autoplay";
                                        font-size: 15px; font-weight: 600;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    // Centering wrapper: a fixed-height child in a HorizontalLayout
                                    // otherwise rides the top of the row.
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 44px; height: 24px; border-radius: 12px;
                                            background: autoplay-enabled ? Theme.accent : Theme.surface-hover;
                                            animate background { duration: 200ms; }
                                            Rectangle {
                                                x: autoplay-enabled ? parent.width - self.width - 3px : 3px;
                                                y: (parent.height - self.height) / 2;
                                                width: 18px; height: 18px; border-radius: 9px;
                                                background: autoplay-enabled ? Theme.on-accent : Theme.text-muted;
                                                animate x { duration: 200ms; easing: ease-in-out; }
                                            }
                                            TouchArea { clicked => { set-autoplay-enabled(!autoplay-enabled); } }
                                        }
                                    }
                                }
                                if autoplay-enabled && autoplay-queue.length > 0: VerticalLayout {
                                    spacing: 0px;
                                    for item[i] in autoplay-queue: Rectangle {
                                        height: 64px;
                                        border-radius: Theme.radius-sm;
                                        background: (ap-row-ta.has-hover || ap-rm-ta.has-hover) ? Theme.hover-veil : transparent;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 52px; padding-top: 8px; padding-bottom: 8px; spacing: 12px;
                                            Rectangle {
                                                width: 48px; height: 48px; border-radius: 6px; clip: true;
                                                background: Theme.art-placeholder;
                                                if item.has-thumbnail: Image {
                                                    source: item.thumbnail; width: parent.width; height: parent.height; image-fit: cover;
                                                }
                                                if !item.has-thumbnail: Text {
                                                    text: item.avatar-letter;
                                                    color: Theme.text-muted;
                                                    font-size: 14px; font-weight: 700;
                                                    width: parent.width; height: parent.height;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; spacing: 3px; horizontal-stretch: 1;
                                                Text { text: item.title; font-size: 14px; font-weight: 500; color: Theme.text; overflow: elide; }
                                                Text { text: item.artist; font-size: 12px; color: Theme.text-muted; overflow: elide; }
                                            }
                                        }
                                        ap-row-ta := TouchArea {
                                            clicked => { play-autoplay-song(i); }
                                            pointer-event(e) => {
                                                if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                                                    open-ctx-autoplay(item.video-id, item.title, item.artist, item.album, item.duration-secs, i,
                                                        self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                        }
                                        // Remove button — same right-edge strip as the queue rows so
                                        // both lists behave identically and the row never reflows when
                                        // the button appears.
                                        //
                                        // MUST be declared AFTER `ap-row-ta`: later siblings win
                                        // hit-testing in Slint, so with the row's TouchArea last the
                                        // click fell through and just played the song.
                                        Rectangle {
                                            x: parent.width - 46px; y: 0;
                                            width: 46px; height: parent.height;
                                            Rectangle {
                                                width: 30px; height: 30px; border-radius: 15px;
                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                background: (ap-row-ta.has-hover || ap-rm-ta.has-hover) ? (ap-rm-ta.has-hover ? Theme.surface-hover : Theme.hover-veil) : transparent;
                                                if ap-row-ta.has-hover || ap-rm-ta.has-hover: Image { source: @image-url("icons/close.svg"); width: 14px; height: 14px; colorize: ap-rm-ta.has-hover ? Theme.text : Theme.text-muted; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                            }
                                            ap-rm-ta := TouchArea { clicked => { remove-from-autoplay(i); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if ctx-status != "": Rectangle {
                height: ctx-status-row.preferred-height;
                background: Theme.glass-strong;
                ctx-status-row := HorizontalLayout {
                    padding: 10px; padding-left: 16px; spacing: 12px;
                    Text { text: ctx-status; color: Theme.text; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                    IconBtn { svg-icon: @image-url("icons/close.svg"); use-svg: true; icon-color: Theme.text-muted; clicked => { ctx-status = ""; } }
                }
            }

            // ── Player bar ────────────────────────────────────────────────
            Rectangle {
                height: 86px;
                border-radius: Theme.radius; border-color: Theme.border; border-width: 1px;
                background: Theme.frost;
                drop-shadow-blur: 24px; drop-shadow-color: #00000045; drop-shadow-offset-y: -6px;
                // Top glass-edge highlight for a premium frosted look.
                Rectangle { x: 0; y: 0; height: 1px; width: parent.width; background: Theme.frost-hi; }

                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 12px; padding-bottom: 12px;

                    // Now playing info (left)
                    HorizontalLayout {
                        width: compact ? 210px : 300px; spacing: 12px; alignment: start;

                        if has-album-art: Rectangle {
                            width: 60px; height: 60px; border-radius: 12px; clip: true;
                            Image { source: album-art; width: parent.width; height: parent.height; image-fit: cover; }
                        }
                        if !has-album-art: Rectangle {
                            width: 60px; height: 60px; border-radius: 12px;
                            background: Theme.surface-hover;
                            Text {
                                text: track-initial; color: is-playing ? Theme.accent : Theme.text-dim;
                                font-size: 20px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center; spacing: 4px; horizontal-stretch: 1;
                            Rectangle {
                                height: 18px;
                                Text { text: track-title; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide;
                                    width: parent.width; vertical-alignment: center; }
                                TouchArea {
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                            open-ctx(now-playing-video-id, track-title, track-artist, "", 0,
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 16px;
                                Text { text: track-artist; font-size: 12px; color: pb-artist-ta.has-hover ? Theme.text : Theme.text-muted; overflow: elide;
                                    width: parent.width; vertical-alignment: center; }
                                pb-artist-ta := TouchArea {
                                    clicked => { open-artist-for(now-playing-video-id, track-artist); }
                                }
                            }
                        }

                        Rectangle {
                            width: 36px; height: 36px;
                            property <bool> like-bounce: false;
                            like-heart := Image {
                                source: is-liked ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                                width: like-bounce ? 28px : (is-liked ? 22px : 20px);
                                height: like-bounce ? 28px : (is-liked ? 22px : 20px);
                                colorize: is-liked ? Theme.accent : Theme.text-dim;
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                animate colorize { duration: 200ms; }
                                animate width, height { duration: 150ms; easing: ease-out-back; }
                            }
                            TouchArea { clicked => { like-bounce = true; like-current(); like-bounce = false; } }
                        }
                    }

                    // Transport + progress (center)
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 6px; alignment: center;

                        HorizontalLayout {
                            alignment: center; spacing: 16px;
                            Rectangle {
                                width: 32px; height: 32px; border-radius: 16px;
                                background: shuf-ta.has-hover ? Theme.hover-veil : transparent;
                                Image { source: @image-url("icons/shuffle.svg"); width: 16px; height: 16px; colorize: shuf-ta.has-hover ? Theme.text : Theme.text-dim; x: 8px; y: 8px; }
                                shuf-ta := TouchArea { }
                            }
                            Rectangle {
                                width: 36px; height: 36px; border-radius: 18px;
                                background: prev-ta.has-hover ? Theme.hover-veil : transparent;
                                Image { source: @image-url("icons/prev.svg"); width: 20px; height: 20px; colorize: prev-ta.has-hover ? Theme.text : Theme.text-muted; x: 8px; y: 8px; }
                                prev-ta := TouchArea { clicked => { prev-track(); } }
                            }
                            Rectangle {
                                width: 44px; height: 44px; border-radius: 22px;
                                background: Theme.accent;
                                drop-shadow-blur: 12px; drop-shadow-color: Theme.accent-soft;
                                if is-playing: Image { source: @image-url("icons/pause.svg"); width: 20px; height: 20px; colorize: Theme.on-accent; x: 12px; y: 12px; }
                                if !is-playing: Image { source: @image-url("icons/play.svg"); width: 20px; height: 20px; colorize: Theme.on-accent; x: 13px; y: 12px; }
                                TouchArea { clicked => { toggle-play-pause(); } }
                            }
                            Rectangle {
                                width: 36px; height: 36px; border-radius: 18px;
                                background: next-ta.has-hover ? Theme.hover-veil : transparent;
                                Image { source: @image-url("icons/next.svg"); width: 20px; height: 20px; colorize: next-ta.has-hover ? Theme.text : Theme.text-muted; x: 8px; y: 8px; }
                                next-ta := TouchArea { clicked => { next-track(); } }
                            }
                            Rectangle {
                                width: 32px; height: 32px; border-radius: 16px;
                                background: rep-ta.has-hover ? Theme.hover-veil : transparent;
                                Image { source: @image-url("icons/repeat.svg"); width: 16px; height: 16px; colorize: rep-ta.has-hover ? Theme.text : Theme.text-dim; x: 8px; y: 8px; }
                                rep-ta := TouchArea { }
                            }
                        }

                        // Progress bar
                        HorizontalLayout {
                            spacing: 10px;
                            padding-left: 16px; padding-right: 16px;

                            Text { text: current-time; font-size: 11px; font-weight: 500; color: Theme.text-muted; width: 36px; horizontal-alignment: right; }

                            prog-ta := TouchArea {
                                horizontal-stretch: 1; height: 14px;
                                clicked => { seek(self.mouse-x / self.width); }
                                moved  => { seek(self.mouse-x / self.width); }
                                Rectangle {
                                    x: 0; y: (parent.height - self.height) / 2;
                                    height: prog-ta.has-hover ? 5px : 3px;
                                    width: parent.width; border-radius: 2px;
                                    background: Theme.surface-hover;
                                    Rectangle {
                                        x: 0; y: 0;
                                        width: parent.width * progress;
                                        height: parent.height; border-radius: 2px;
                                        background: prog-ta.has-hover ? Theme.accent-strong : Theme.accent;
                                    }
                                }
                                if prog-ta.has-hover: Rectangle {
                                    x: prog-ta.width * progress - 6px;
                                    y: (prog-ta.height - 12px) / 2;
                                    width: 12px; height: 12px; border-radius: 6px;
                                    background: Theme.text;
                                }
                            }

                            Text { text: total-time; font-size: 11px; font-weight: 500; color: Theme.text-muted; width: 36px; }
                        }
                    }

                    // Volume + queue toggle (right)
                    HorizontalLayout {
                        width: compact ? 52px : 220px; spacing: 10px; alignment: end;

                        IconBtn { svg-icon: @image-url("icons/queue.svg"); use-svg: true; active: queue-pane-open; icon-color: queue-pane-open ? Theme.accent : Theme.text-dim; clicked => { toggle-queue-pane(); } }

                        if !compact: HorizontalLayout {
                            spacing: 8px; alignment: center;
                            Image { source: @image-url("icons/volume.svg"); width: 18px; height: 18px; colorize: Theme.text-muted; vertical-alignment: center; }

                            vol-ta := TouchArea {
                                width: 80px; height: 16px;
                                clicked => { set-volume(self.mouse-x / self.width); }
                                moved  => { set-volume(self.mouse-x / self.width); }
                                Rectangle {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    height: vol-ta.has-hover ? 5px : 3px;
                                    width: parent.width; border-radius: 2px;
                                    background: Theme.surface-hover;
                                    Rectangle {
                                        x: 0; y: 0;
                                        width: parent.width * volume;
                                        height: parent.height; border-radius: 2px;
                                        background: vol-ta.has-hover ? Theme.accent : Theme.text-muted;
                                    }
                                }
                                if vol-ta.has-hover: Rectangle {
                                    x: parent.width * volume - 5px;
                                    y: parent.height / 2 - 5px;
                                    width: 10px; height: 10px; border-radius: 5px;
                                        background: Theme.accent;
                                }
                            }
                        }
                    }
                }
            }

    } // main UI VerticalLayout (direct Window child)

    if search-dropdown-open: Rectangle {
        x: 0; y: search-bar-rect.absolute-position.y + search-bar-rect.height;
        width: root.width; height: root.height - self.y;
        background: transparent;
        TouchArea { clicked => { close-search-preview(); key-scope.focus(); } }
    }

    if search-dropdown-open: Rectangle {
        x: min(search-bar-rect.absolute-position.x, root.width - self.width - 12px);
        y: search-bar-rect.absolute-position.y + search-bar-rect.height + 6px;
        width: min(420px, root.width - 24px);
        height: min(400px, root.height - self.y - 20px,
            search-preview-busy || search-preview-error != "" || search-preview.length == 0 ? 96px : search-preview.length * 64px + 16px);
        border-radius: Theme.radius; background: Theme.glass-strong;
        border-color: Theme.border; border-width: 1px;
        drop-shadow-blur: 20px; drop-shadow-color: #000000a0; drop-shadow-offset-y: 8px;
        clip: true;
        if search-preview-busy || search-preview-error != "" || search-preview.length == 0: Text {
            x: 16px; y: 12px; width: parent.width - 32px; height: parent.height - 24px;
            text: search-preview-busy ? "Searching..." : (search-preview-error != "" ? search-preview-error : "No suggestions found");
            color: search-preview-error != "" && !search-preview-busy ? Theme.danger : Theme.text-muted;
            font-size: 13px; wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center;
        }
        search-preview-scroll := SmoothFlickable {
            x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
            visible: !search-preview-busy && search-preview-error == "" && search-preview.length > 0;
            viewport-width: self.width;
            viewport-height: search-preview.length * 64px;
            property <int> selected: root.search-preview-selected;
            changed selected => {
                self.viewport-y = self.selected < 0 ? 0px : min(0px, max(
                    self.height - self.viewport-height,
                    min(max(self.viewport-y, -self.selected * 64px), self.height - (self.selected + 1) * 64px)));
            }
            for item[i] in search-preview: Rectangle {
                x: 0; y: i * 64px; width: search-preview-scroll.width;
                height: 64px; border-radius: 6px;
                background: search-preview-selected == i ? Theme.accent-soft : (sug-ta.has-hover ? Theme.hover-veil : transparent);
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                    Rectangle {
                        width: 44px; height: 44px; border-radius: item.kind == "Artist" ? 22px : 6px; clip: true;
                        background: item.kind == "Completion" ? transparent : Theme.art-placeholder;
                        if item.has-thumbnail && item.kind != "Completion": Image { source: item.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
                        if !item.has-thumbnail || item.kind == "Completion": Image {
                            source: item.kind == "Completion" ? @image-url("icons/search.svg")
                                : item.kind == "Artist" ? @image-url("icons/artist.svg")
                                : item.kind == "Album" ? @image-url("icons/album.svg")
                                : item.kind == "Playlist" ? @image-url("icons/queue.svg") : @image-url("icons/play.svg");
                            x: 12px; y: 12px; width: 20px; height: 20px; colorize: Theme.text-muted;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1; min-width: 0px;
                        Text { text: item.title; y: 2px; width: parent.width; height: 20px; font-size: 14px; font-weight: 500; color: Theme.text; overflow: elide; }
                        Text {
                            text: item.kind + (item.subtitle != "" ? " \u{2022} " + item.subtitle : "");
                            y: 24px; width: parent.width; height: 18px; font-size: 12px; color: Theme.text-muted; overflow: elide;
                        }
                    }
                }
                sug-ta := TouchArea {
                    clicked => { choose-search-preview(item); }
                    pointer-event(e) => {
                        if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                            if item.kind == "Song" {
                                open-ctx(item.id, item.title, item.artist, item.album, item.duration-secs,
                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                close-search-preview();
                            } else if item.kind == "Artist" || item.kind == "Album" {
                                open-entity-ctx(item.kind, item.id, item.title, item.artist,
                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                close-search-preview();
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Shared context menu (single instance for every row/card) ──────────────
    ctx-menu := PopupWindow {
        x: root.ctx-main-x - (root.ctx-kind != "Artist" && root.ctx-submenu-left ? 224px : 0px);
        y: ctx-focus.main-y;
        width: root.ctx-kind == "Artist" ? 248px : 472px;
        height: root.ctx-kind == "Artist" ? ctx-focus.main-height : root.height - ctx-focus.main-y - 12px;
        close-policy: close-on-click-outside;
        ctx-focus := FocusScope {
            property <length> main-height: min(ctx-col.preferred-height, root.height - 24px);
            property <length> submenu-budget: min(300px, root.height - 24px);
            property <length> main-y: max(12px, min(root.ctx-y, root.height - max(self.main-height, root.ctx-kind == "Artist" ? 0px : self.submenu-budget) - 12px));
            property <length> submenu-height: min(ctx-artists-col.preferred-height + 12px, self.submenu-budget);
            property <length> submenu-y: max(0px, min(root.ctx-kind == "Song" ? 206px : 166px, root.height - self.main-y - self.submenu-height - 12px));
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { close-ctx-menu(); return accept; }
                if event.text == Key.LeftArrow { ctx-submenu-open = false; return accept; }
                if event.text == Key.RightArrow && ctx-kind != "Artist" { ctx-submenu-open = true; return accept; }
                if ctx-submenu-open && ctx-artists.length > 0 {
                    if event.text == Key.DownArrow { ctx-artist-selected = min(ctx-artists.length - 1, ctx-artist-selected + 1); return accept; }
                    if event.text == Key.UpArrow { ctx-artist-selected = max(0, ctx-artist-selected - 1); return accept; }
                    if event.text == Key.Return && ctx-artist-selected >= 0 && ctx-artist-selected < ctx-artists.length {
                        context-artist(ctx-artists[ctx-artist-selected].browse-id, ctx-artists[ctx-artist-selected].name);
                        close-ctx-menu(); return accept;
                    }
                }
                reject
            }
            TouchArea { clicked => { close-ctx-menu(); } }
            Rectangle {
                x: root.ctx-kind != "Artist" && root.ctx-submenu-left ? 224px : 0px;
                y: 0px;
                width: 248px; height: ctx-focus.main-height;
                border-radius: Theme.radius; background: Theme.glass-strong;
                border-color: Theme.border; border-width: 1px;
                TouchArea { }
                SmoothFlickable {
                    width: parent.width; height: parent.height;
                    viewport-width: self.width; viewport-height: ctx-col.preferred-height;
                    ctx-col := VerticalLayout {
                        width: parent.width; height: self.preferred-height; alignment: start;
                        padding: 6px; spacing: 0px;
                        if ctx-kind == "Song": CtxMenuItem { icon: @image-url("icons/plus.svg"); label: "Add to queue"; clicked => { queue-song(ctx-video-id, ctx-title, ctx-artist); close-ctx-menu(); } }
                        if ctx-kind == "Song": CtxMenuItem { icon: @image-url("icons/next.svg"); label: "Play next"; clicked => {
                            if ctx-in-queue { move-queue-song-next(ctx-index); } else { play-next-song(ctx-video-id, ctx-title, ctx-artist, ctx-duration); }
                            close-ctx-menu();
                        } }
                        if ctx-kind == "Song": CtxMenuItem { icon: @image-url("icons/play.svg"); label: "Play"; clicked => { play-song(ctx-video-id, ctx-title, ctx-artist, ctx-duration); close-ctx-menu(); } }
                        if ctx-kind == "Song": CtxMenuItem { icon: @image-url("icons/radio.svg"); label: "Go to song radio"; clicked => { start-song-radio(ctx-video-id); close-ctx-menu(); } }
                        if ctx-kind == "Song": CtxMenuItem { icon: @image-url("icons/radio.svg"); label: "Artist radio"; clicked => { start-artist-radio(ctx-video-id, ctx-artist); close-ctx-menu(); } }
                        if ctx-kind != "Song": CtxMenuItem {
                            icon: ctx-kind == "Album" ? @image-url("icons/album.svg") : @image-url("icons/artist.svg");
                            label: ctx-kind == "Album" ? "Open album" : "Open artist";
                            clicked => { context-action("open", ctx-kind, ctx-id, ctx-title, ctx-artist); close-ctx-menu(); }
                        }
                        if ctx-kind == "Album": CtxMenuItem { icon: @image-url("icons/play.svg"); label: "Play"; clicked => { context-action("play", ctx-kind, ctx-id, ctx-title, ctx-artist); close-ctx-menu(); } }
                        if ctx-kind == "Album": CtxMenuItem { icon: @image-url("icons/plus.svg"); label: "Add to queue"; clicked => { context-action("queue", ctx-kind, ctx-id, ctx-title, ctx-artist); close-ctx-menu(); } }
                        if ctx-kind != "Song": CtxMenuItem {
                            icon: ctx-saved ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                            icon-color: ctx-saved ? Theme.accent : Theme.text-muted;
                            label: ctx-kind == "Artist" ? (ctx-saved ? "Unfollow" : "Follow") : (ctx-saved ? "Remove from library" : "Save to library");
                            clicked => { context-action("save", ctx-kind, ctx-id, ctx-title, ctx-artist); close-ctx-menu(); }
                        }
                        if ctx-kind != "Artist": CtxMenuItem {
                            icon: @image-url("icons/artist.svg"); label: "Go to artist";
                            submenu: ctx-artists.length != 1; selected: ctx-submenu-open;
                            hovered => { if ctx-artists.length != 1 { ctx-submenu-open = true; } }
                            clicked => { choose-context-artist(); }
                        }
                        if ctx-kind == "Song" && ctx-can-album: CtxMenuItem { icon: @image-url("icons/album.svg"); label: "Go to album"; clicked => { context-album(ctx-video-id, ctx-title, ctx-artist, ctx-album); close-ctx-menu(); } }
                        if ctx-kind == "Song": CtxMenuItem { icon: @image-url("icons/plus.svg"); label: "Add to playlist"; clicked => { open-add-to-playlist(ctx-video-id, ctx-title, ctx-artist, ctx-duration); close-ctx-menu(); } }
                        if ctx-kind == "Song" && ctx-show-remove-playlist: CtxMenuItem { icon: @image-url("icons/close.svg"); label: "Remove from playlist"; clicked => { remove-from-local-playlist(ctx-playlist-id, ctx-video-id); close-ctx-menu(); } }
                        if ctx-kind == "Song" && ctx-show-unlike: CtxMenuItem { icon: @image-url("icons/heart-fill.svg"); icon-color: Theme.accent; label: "Remove from liked"; clicked => { unlike-song(ctx-video-id); close-ctx-menu(); } }
                        if ctx-kind == "Song" && ctx-in-queue: CtxMenuItem { icon: @image-url("icons/close.svg"); label: "Remove from queue"; clicked => { remove-from-queue(ctx-index); close-ctx-menu(); } }
                        if ctx-kind == "Song" && ctx-in-autoplay: CtxMenuItem { icon: @image-url("icons/close.svg"); label: "Remove from autoplay"; clicked => { remove-from-autoplay(ctx-index); close-ctx-menu(); } }
                        if ctx-kind == "Song": Rectangle { height: 1px; background: Theme.border; }
                        if ctx-kind == "Song": CtxMenuItem { use-image: false; glyph: "\u{1F6AB}"; glyph-size: 13px; label: "Remove from taste profile"; clicked => { dislike-song(ctx-video-id, ctx-title, ctx-artist, ctx-duration); close-ctx-menu(); } }
                    }
                }
            }
            Rectangle {
                visible: root.ctx-submenu-open;
                x: root.ctx-submenu-left ? 0px : 248px; y: ctx-focus.submenu-y;
                width: 224px; height: ctx-focus.submenu-height;
                border-radius: Theme.radius; background: Theme.glass-strong;
                border-color: Theme.border; border-width: 1px;
                TouchArea { }
                ctx-artists-scroll := SmoothFlickable {
                    x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
                    viewport-width: self.width; viewport-height: ctx-artists-col.preferred-height;
                    property <int> selected-index: root.ctx-artist-selected;
                    changed selected-index => {
                        if root.ctx-artist-selected >= 0 {
                            self.viewport-y = min(0px, max(self.height - self.viewport-height,
                                min(max(self.viewport-y, -(root.ctx-artist-selected * 40px)), self.height - (root.ctx-artist-selected + 1) * 40px)));
                        }
                    }
                    ctx-artists-col := VerticalLayout {
                        width: parent.width; height: self.preferred-height; alignment: start; spacing: 0px;
                        for credit[index] in ctx-artists: CtxMenuItem {
                            icon: @image-url("icons/artist.svg"); label: credit.name;
                            selected: ctx-artist-selected == index;
                            hovered => { ctx-artist-selected = index; }
                            clicked => { context-artist(credit.browse-id, credit.name); close-ctx-menu(); }
                        }
                        if ctx-artists-loading: Text { text: "Loading artists..."; height: 44px; color: Theme.text-muted; font-size: 13px; vertical-alignment: center; horizontal-alignment: center; }
                        if !ctx-artists-loading && ctx-artists-error != "": Text { text: ctx-artists-error; color: Theme.text-muted; font-size: 13px; wrap: word-wrap; }
                        if !ctx-artists-loading && ctx-artists.length == 0 && ctx-artists-error == "": Text { text: "No artist credits available"; height: 44px; color: Theme.text-muted; font-size: 13px; wrap: word-wrap; vertical-alignment: center; }
                        if !ctx-artists-loading && (ctx-artists.length == 0 || ctx-artists-error != ""): CtxMenuItem {
                            icon: @image-url("icons/artist.svg"); label: "Retry";
                            clicked => {
                                ctx-artists-loading = true; ctx-artists-error = "";
                                prepare-context(ctx-kind, ctx-id, ctx-title, ctx-artist, ctx-album, ctx-generation);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Add-to-playlist / New-playlist modal ──────────────────────────────────
    if show-playlist-modal: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #000000a0;
        TouchArea { clicked => { show-playlist-modal = false; } }
        Rectangle {
            width: min(420px, root.width - 48px);
            height: pl-modal-col.preferred-height + 36px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 16px; background: Theme.glass-strong;
            border-color: Theme.border; border-width: 1px;
            drop-shadow-blur: 40px; drop-shadow-color: #000000c0; drop-shadow-offset-y: 12px;
            TouchArea { }
            pl-modal-col := VerticalLayout {
                padding: 20px; spacing: 14px;
                HorizontalLayout {
                    Text {
                        text: pending-song-vid == "" ? "New playlist" : "Add to playlist";
                        font-size: 18px; font-weight: 700; color: Theme.text;
                        horizontal-stretch: 1; vertical-alignment: center;
                    }
                    IconBtn { svg-icon: @image-url("icons/close.svg"); use-svg: true; icon-color: Theme.text-muted; clicked => { show-playlist-modal = false; } }
                }
                if pending-song-vid != "": Text {
                    text: pending-song-title + "  •  " + pending-song-artist;
                    font-size: 12px; color: Theme.text-muted; overflow: elide;
                }
                HorizontalLayout { spacing: 8px;
                    new-pl-name := LineEdit { placeholder-text: "New playlist name…"; horizontal-stretch: 1; }
                    Rectangle {
                        width: 84px; height: 36px; border-radius: Theme.radius-sm;
                        background: create-ta.has-hover ? Theme.accent-strong : Theme.accent;
                        Text { text: "Create"; color: Theme.on-accent; font-size: 13px; font-weight: 600;
                            width: parent.width; height: parent.height;
                            horizontal-alignment: center; vertical-alignment: center; }
                        create-ta := TouchArea { clicked => { if new-pl-name.text != "" { submit-new-playlist(new-pl-name.text); new-pl-name.text = ""; } } }
                    }
                }
                if modal-playlists.length > 0: Rectangle { height: 1px; background: Theme.border; }
                if modal-playlists.length > 0: Text { text: "Your playlists"; font-size: 12px; color: Theme.text-muted; }
                if modal-playlists.length > 0: SmoothFlickable {
                    height: min(240px, modal-list.preferred-height);
                    viewport-height: modal-list.preferred-height;
                    modal-list := VerticalLayout {
                        spacing: 2px;
                        for pl in modal-playlists: Rectangle {
                            height: 44px; border-radius: Theme.radius-sm;
                            background: pl-item-ta.has-hover ? Theme.hover-veil : transparent;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 10px; alignment: start;
                                Rectangle {
                                    width: 32px; height: 32px; border-radius: 6px; background: Theme.art-placeholder;
                                    y: (parent.height - self.height) / 2;
                                    Text { text: "♪"; color: Theme.text-dim; font-size: 15px;
                                        width: parent.width; height: parent.height;
                                        horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout { alignment: center; horizontal-stretch: 1;
                                    Text { text: pl.title; font-size: 13px; font-weight: 500; color: Theme.text; overflow: elide; }
                                    Text { text: pl.count-text; font-size: 11px; color: Theme.text-muted; }
                                }
                            }
                            pl-item-ta := TouchArea { clicked => { add-to-existing-playlist(pl.playlist-id); } }
                        }
                    }
                }
            }
        }
    }

    // ── First-run onboarding popup (add-on installation) ──────────────────────
    if show-onboarding: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        // Scrim — captures clicks so the app behind stays inert (does not dismiss).
        background: #000000a0;
        TouchArea { }

        ob-card := Rectangle {
            width: min(480px, root.width - 48px);
            height: ob-layout.preferred-height;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 18px;
            background: Theme.glass-strong;
            border-color: Theme.border; border-width: 1px;
            drop-shadow-blur: 40px; drop-shadow-color: #000000c0; drop-shadow-offset-y: 16px;

            ob-layout := VerticalLayout {
                padding: 28px; spacing: 18px;

                // Header
                HorizontalLayout {
                    spacing: 14px; alignment: start;
                    Rectangle {
                        width: 46px; height: 46px; border-radius: 12px; background: Theme.accent-soft;
                        Text { text: "\u{25B6}"; color: Theme.accent; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        alignment: center; spacing: 3px; horizontal-stretch: 1;
                        Text { text: "Welcome to Auricle"; font-size: 19px; font-weight: 700; color: Theme.text; }
                        Text { text: "Set up the tools needed for audio playback."; font-size: 13px; color: Theme.text-muted; }
                    }
                }

                Text {
                    text: "These optional third-party tools are not bundled with Auricle. Installing them is at your own discretion; Auricle is not affiliated with them. You may also install them manually onto your PATH.";
                    font-size: 12px; color: Theme.text-muted; wrap: word-wrap;
                }

                // yt-dlp row
                Rectangle {
                    border-radius: Theme.radius; background: Theme.surface; border-color: Theme.border; border-width: 1px;
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center; spacing: 2px; horizontal-stretch: 1;
                                Text { text: "yt-dlp"; font-size: 14px; font-weight: 600; color: Theme.text; }
                                Text { text: "Required for audio streaming and downloads."; font-size: 12px; color: Theme.text-muted; }
                            }
                            if ytdlp-installed && addon-installing != "ytdlp": Text { text: "\u{2713} Installed"; font-size: 13px; color: Theme.success; vertical-alignment: center; }
                            if !ytdlp-installed && addon-installing != "ytdlp": Rectangle {
                                width: 100px; height: 34px; border-radius: Theme.radius-sm;
                                background: addon-busy ? Theme.surface-hover : (ob-yt-ta.has-hover ? Theme.accent-strong : Theme.accent);
                                animate background { duration: 100ms; }
                                Text { text: "Install"; font-size: 13px; font-weight: 600; color: addon-busy ? Theme.text-dim : Theme.on-accent;
                                    width: parent.width; height: parent.height;
                                    horizontal-alignment: center; vertical-alignment: center; }
                                ob-yt-ta := TouchArea { clicked => { if !addon-busy { install-ytdlp(); } } }
                            }
                        }
                        if addon-installing == "ytdlp": VerticalLayout {
                            spacing: 6px;
                            AddonProgress { value: addon-progress; }
                            Text {
                                text: addon-progress < 0 ? "Installing\u{2026}" : (Math.round(addon-progress * 100) + "%");
                                font-size: 11px; color: Theme.text-muted;
                            }
                        }
                    }
                }

                // ffmpeg row
                Rectangle {
                    border-radius: Theme.radius; background: Theme.surface; border-color: Theme.border; border-width: 1px;
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center; spacing: 2px; horizontal-stretch: 1;
                                Text { text: "ffmpeg"; font-size: 14px; font-weight: 600; color: Theme.text; }
                                Text { text: "Optional \u{2022} improves format handling for downloads."; font-size: 12px; color: Theme.text-muted; }
                            }
                            if ffmpeg-installed && addon-installing != "ffmpeg": Text { text: "\u{2713} Installed"; font-size: 13px; color: Theme.success; vertical-alignment: center; }
                            if !ffmpeg-installed && addon-installing != "ffmpeg": Rectangle {
                                width: 100px; height: 34px; border-radius: Theme.radius-sm;
                                background: addon-busy ? Theme.surface : (ob-ff-ta.has-hover ? Theme.surface-hover : transparent);
                                border-color: Theme.border; border-width: 1px;
                                animate background { duration: 100ms; }
                                Text { text: "Install"; font-size: 13px; font-weight: 600; color: addon-busy ? Theme.text-dim : Theme.text;
                                    width: parent.width; height: parent.height;
                                    horizontal-alignment: center; vertical-alignment: center; }
                                ob-ff-ta := TouchArea { clicked => { if !addon-busy { install-ffmpeg(); } } }
                            }
                        }
                        if addon-installing == "ffmpeg": VerticalLayout {
                            spacing: 6px;
                            AddonProgress { value: addon-progress; }
                            Text {
                                text: addon-progress < 0 ? "Installing\u{2026}" : (Math.round(addon-progress * 100) + "%");
                                font-size: 11px; color: Theme.text-muted;
                            }
                        }
                    }
                }

                if addon-status != "": Text { text: addon-status; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; horizontal-alignment: center; }

                // Footer
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: ob-done-txt.preferred-width + 36px; height: 36px; border-radius: Theme.radius-sm;
                        background: ob-done-ta.has-hover ? Theme.hover-veil : transparent;
                        animate background { duration: 100ms; }
                        ob-done-txt := Text {
                            text: ytdlp-installed ? "Done" : "Maybe later";
                            font-size: 13px; font-weight: 600;
                            color: addon-busy ? Theme.text-dim : Theme.text;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        ob-done-ta := TouchArea { clicked => { if !addon-busy { dismiss-onboarding(); } } }
                    }
                }
            }
        }
    }
}
