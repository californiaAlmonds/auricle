  <metadata>
    <id>auricle</id>
    <version>__VERSION__</version>
    <title>Auricle</title>
    <authors>californiaAlmonds</authors>
    <projectUrl>https://californiaalmonds.github.io/auricle/</projectUrl>
    <projectSourceUrl>https://github.com/californiaAlmonds/auricle</projectSourceUrl>
